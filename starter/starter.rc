// starter.rc - REL-TEMPO: Symbol, Manifest und Versionsangaben von JK-Studio-Starter.exe
// (wie res/behaved.rc: das Symbol zuerst, das Manifest als Zahl 24).
#include <windows.h>

1 ICON "../res/jkstudio.ico"

#define BHED_RT_MANIFEST 24
1 BHED_RT_MANIFEST "starter.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    1, 0, 0, 0
  PRODUCTVERSION 1, 0, 0, 0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0x0L
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "JK Studio Starter - downloads, updates and starts JK Studio"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "InternalName",    "jkstudio_starter"
            VALUE "OriginalFilename","JK-Studio-Starter.exe"
            VALUE "ProductName",     "JK Studio"
            VALUE "ProductVersion",  "1.0.0.0"
            VALUE "Comments",
                  "Not affiliated with Lucasfilm, Disney or Raven Software. Free software, no warranty."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
