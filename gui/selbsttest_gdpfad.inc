// selbsttest_gdpfad.inc - GDPFAD (rc612): das Programm, wenn ein eingerichteter Spielordner fehlt (BHED_EDITORTEST=spielordnerfehlt)
//
// Anlass: der JKA-Ordner des Rechners wurde am 11.11. umbenannt ("GameData original" -> "GameData" wie im Original). Die
// Selbsttests mit dem alten Namen liefen ins Leere, die Gruppe rtjka stuerzte ab (0xC0000005, Lesezugriff 0xFFFFFFFFFFFFFFF0:
// der Testhelfer kv5::seq() griff ohne geladene Figur auf animList[-1] zu). Dieselbe Lage im Programm: die Einstellungen
// nennen einen Spielordner, den es nicht (mehr) gibt - umbenannt, verschoben, Laufwerk nicht angeschlossen. Der Ordner dieses
// Tests liegt im Laufordner und wird nie angelegt; kein Spielordner wird angefasst.
//
//   Hinweis   die Statuszeile nennt den fehlenden Ordner genau einmal (im Model-Tab als letzte Meldung des Modells) - auch
//             wenn die Spielordner danach wieder und wieder eingelesen werden (jede Stelle mit "noch nichts eingelesen"
//             tut das) - mit dem Weg Edit > Game folders; die Fenster Game folders und "Files in .pk3" nennen ihn statt
//             "no archives found" / "No game folder added yet"; unter den Regeln von Jedi Outcast dasselbe mit dessen
//             Liste
//   Tabs      Model (Figur aus den Archiven, alle sechs Bereiche, Retargeting-Rollout, NPC-Browser, Files in .pk3), Mission
//             (Load mission mit einem Archiv, das es nicht gibt), Map Editor, Menu Editor, Events: je einige Bilder gezeichnet
//             - Meldung statt Absturz
//   zurueck   mit den eingerichteten Ordnern: kein fehlender Ordner mehr, die Figur laedt; fehlt der Ordner danach noch
//             einmal, meldet ihn die Statuszeile wieder
// Eingebunden in selbsttest.cpp.
namespace gdpfad {

struct Stand {
    std::vector<std::string> jka;   // eingerichtet vor dem Test
    std::vector<std::string> jk2;
    int regelwerk = 0;
    std::string weg;      // der Ordner, den es nicht gibt (Liste von Jedi Academy / Movie Duels)
    std::string wegJk2;   // ebenso in der Liste von Jedi Outcast
    std::size_t status0 = 0;
    int bild0 = 0;
};

// Wie oft die Statuszeile seit `ab` einen Text nennt
int statusMit(const std::string& teil, std::size_t ab) {
    int n = 0;
    for (std::size_t i = ab; i < g_app->statusLines.size(); ++i) {
        if (g_app->statusLines[i].find(teil) != std::string::npos) { ++n; }
    }
    return n;
}

// Ein Tab mit fehlendem Spielordner: `tun` beim Betreten, dann eine halbe Sekunde Bilder; die Pruefung haelt fest, dass das
// Programm sie gezeichnet hat (ein Absturz beendet den Lauf ohne "Knopftest fertig")
void tab(std::vector<Schritt>& s, std::shared_ptr<Stand> st, const std::string& name, int modus, std::function<void()> tun) {
    s.push_back(tu("GDPFAD " + name + ": oeffnen", [=] {
        st->bild0 = ImGui::GetFrameCount();
        g_app->leftMode = modus;
        tourSchliessen();
        tun();
    }));
    s.push_back(pause(0.5));
    s.push_back(pruefe("GDPFAD " + name + ": laeuft ohne Spielordner weiter (gezeichnet, kein Spielordner eingelesen)", [=] {
        diag::detail("Knopftest: GDPFAD " + name + " - " + std::to_string(ImGui::GetFrameCount() - st->bild0) + " Bilder, Modus " +
                     std::to_string(g_app->leftMode) + ", Spielordner " + std::to_string(g_app->gamePaths.size()));
        return ImGui::GetFrameCount() - st->bild0 >= 3 && g_app->leftMode == modus && g_app->gamePaths.empty();
    }));
}

std::vector<Schritt> schritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto st = std::make_shared<Stand>();
    add(tu("GDPFAD: Skript fuer den Test, Ausgangslage", [=] {
        openScriptFromMemory("//Generated by BehavEd\nwait ( 1000.000 );\n", "gdpfad.txt");
        Settings& e = g_app->settings;
        st->jka = e.gamePaths;
        st->jk2 = e.gamePathsJk2;
        st->regelwerk = e.regelwerk;
        st->weg = stufe2::laufDatei("gdpfad_kein_spiel") + "\\base";
        st->wegJk2 = stufe2::laufDatei("gdpfad_kein_jk2") + "\\base";
        if (g_app->gamePaths.empty()) { rescanGamePaths(); }
        diag::detail("Knopftest: GDPFAD - eingerichtet " + std::to_string(st->jka.size()) + " Ordner, eingelesen " + std::to_string(g_app->gamePaths.size()) +
                     "; fuer den Test \"" + st->weg + "\"");
    }));
    add(pruefe("GDPFAD: Ausgangslage - Spielordner eingelesen, der Ordner des Tests existiert nicht", [=] {
        std::error_code ec;
        return !g_app->gamePaths.empty() && !std::filesystem::exists(::bhed::utf8Pfad(st->weg), ec) && !std::filesystem::exists(::bhed::utf8Pfad(st->wegJk2), ec);
    }));

    // --- Hinweis -------------------------------------------------------------------------------------------------------
    add(tu("GDPFAD: die Einstellungen nennen einen Spielordner, den es nicht gibt", [=] {
        st->status0 = g_app->statusLines.size();
        g_app->settings.gamePaths = {st->weg};
        g_app->sitzungsSpielordner.clear();
        rescanGamePaths();
        refreshPk3List();
    }));
    add(pause(0.3));
    add(pruefe("GDPFAD Hinweis: die Statuszeile nennt den fehlenden Spielordner und den Weg (Edit > Game folders)", [=] {
        std::string zeile;
        for (std::size_t i = st->status0; i < g_app->statusLines.size(); ++i) {
            if (g_app->statusLines[i].find(st->weg) != std::string::npos) { zeile = g_app->statusLines[i]; }
        }
        diag::detail("Knopftest: GDPFAD Hinweis - Statuszeile \"" + zeile + "\", Spielordner " + std::to_string(g_app->gamePaths.size()));
        return g_app->gamePaths.empty() && statusMit(st->weg, st->status0) == 1 && zeile.find(tr(Str::PathsTitle)) != std::string::npos &&
               zeile.find(tr(Str::MenuEdit)) != std::string::npos;
    }));
    add(pruefe("GDPFAD Hinweis: der Ordner ist als fehlend gemerkt (danach zeichnen Game folders und Files in .pk3)", [=] {
        return g_app->spielordnerFehlend == std::vector<std::string>{st->weg};
    }));
    add(pruefe("GDPFAD Hinweis: fuer den Model-Tab steht er als letzte Meldung des Modells da (dessen Statuszeile zeigt sie)", [=] {
        return g_app->mtab.meldung.find(st->weg) != std::string::npos;
    }));
    add(tu("GDPFAD: noch dreimal einlesen (wie jede Stelle, die leere Spielordner neu einliest)", [] {
        for (int i = 0; i < 3; ++i) { rescanGamePaths(); }
    }));
    add(pruefe("GDPFAD Hinweis: nach weiterem Einlesen steht er weiter genau einmal da", [=] {
        diag::detail("Knopftest: GDPFAD Hinweis - " + std::to_string(statusMit(st->weg, st->status0)) + " Zeilen mit dem Ordner");
        return statusMit(st->weg, st->status0) == 1;
    }));

    // --- Tabs ----------------------------------------------------------------------------------------------------------
    auto fehler = std::make_shared<std::string>();
    auto geladen = std::make_shared<bool>(true);
    tab(s, st, "Model ohne Figur", 2, [] { g_app->mtab.vierAnsichten = false; });
    add(foto("gdpfad_model"));
    tab(s, st, "Model", 2, [=] {
        *geladen = oeffneModellAusArchiv("models/players/stormtrooper/model.glm", fehler.get());
        g_app->mtab.vierAnsichten = false;
    });
    add(pruefe("GDPFAD Model: die Figur aus den Archiven laedt nicht und sagt, warum", [=] {
        diag::detail("Knopftest: GDPFAD Model - geladen " + std::to_string(*geladen) + ", Meldung \"" + *fehler + "\"");
        return !*geladen && !fehler->empty() && g_app->model.empty();
    }));
    for (int b = 0; b < kModellBereiche; ++b) {
        tab(s, st, "Model Bereich " + std::to_string(b), 2, [=] {
            g_app->mtab.bereich = static_cast<ModellBereich>(b);
            g_app->mtab.vierAnsichten = b == 1;
        });
    }
    tab(s, st, "Model Retargeting-Rollout", 2, [] {
        g_app->mtab.bereich = ModellBereich::Animation;
        g_app->mtab.vierAnsichten = false;
        g_app->mtab.rt.oeffnen = true;
    });
    tab(s, st, "Model NPC-Browser", 2, [] { g_app->npcBrowserOffen = true; });
    tab(s, st, "Model Files in .pk3", 2, [] {
        g_app->npcBrowserOffen = false;
        g_app->pk3Kind = 2;
        refreshPk3List();
        g_app->pk3Open = true;
    });
    add(foto("gdpfad_pk3"));
    add(pruefe("GDPFAD Model: Files in .pk3 ist offen und leer", [] { return g_app->pk3Open && g_app->pk3Files.empty(); }));
    add(tu("GDPFAD Model: Auswahl zu", [] { g_app->pk3Open = false; }));
    tab(s, st, "Mission", 1, [=] {
        g_app->mtab.bereich = ModellBereich::Ansehen;
        g_app->missionPickOpen = false;
        missionenAusArchiv(st->weg + "\\assets1.pk3");
    });
    add(pruefe("GDPFAD Mission: Load mission mit einem Archiv, das es nicht gibt, oeffnet keine Auswahl", [] {
        return !g_app->missionPickOpen && g_app->missions.empty();
    }));
    tab(s, st, "Map Editor", 3, [] {});
    tab(s, st, "Menu Editor", 4, [] {});
    tab(s, st, "Events", 0, [] {});
    tab(s, st, "Game folders", 0, [] { g_app->pathsOpen = true; });
    add(foto("gdpfad_spielordner"));
    add(tu("GDPFAD: Fenster Game folders zu", [] { g_app->pathsOpen = false; }));

    // --- Jedi Outcast: dessen Liste ------------------------------------------------------------------------------------
    add(tu("GDPFAD JK2: Regelwerk Jedi Outcast, dessen Spielordner gibt es nicht", [=] {
        st->status0 = g_app->statusLines.size();
        g_app->settings.gamePathsJk2 = {st->wegJk2};
        g_app->settings.regelwerk = kRegelwerkJediOutcast;
        (void)regelwerkPruefen();
        rescanGamePaths();
    }));
    add(pause(0.5));
    add(pruefe("GDPFAD JK2: die Statuszeile nennt den fehlenden Ordner von Jedi Outcast einmal, den von Jedi Academy nicht noch einmal", [=] {
        diag::detail("Knopftest: GDPFAD JK2 - " + regelwerkStatusZeile() + ", " + std::to_string(statusMit(st->wegJk2, st->status0)) + " / " +
                     std::to_string(statusMit(st->weg, st->status0)) + " Zeilen");
        return regelwerkJediOutcast() && g_app->gamePaths.empty() && statusMit(st->wegJk2, st->status0) == 1 && statusMit(st->weg, st->status0) == 0 &&
               g_app->spielordnerFehlend == std::vector<std::string>{st->wegJk2};
    }));
    tab(s, st, "JK2 Model", 2, [] {});
    tab(s, st, "JK2 Mission", 1, [] {});

    // --- zurueck -------------------------------------------------------------------------------------------------------
    add(tu("GDPFAD: die eingerichteten Spielordner und das Regelwerk wieder", [=] {
        st->status0 = g_app->statusLines.size();
        g_app->settings.gamePaths = st->jka;
        g_app->settings.gamePathsJk2 = st->jk2;
        g_app->settings.regelwerk = st->regelwerk;
        g_app->sitzungsSpielordner.clear();
        (void)regelwerkPruefen();
        rescanGamePaths();
        refreshPk3List();
        g_app->leftMode = 2;
        *geladen = oeffneModellAusArchiv("models/players/stormtrooper/model.glm", fehler.get());
    }));
    add(pause(0.5));
    add(pruefe("GDPFAD zurueck: Spielordner eingelesen, kein Hinweis, die Figur laedt", [=] {
        diag::detail("Knopftest: GDPFAD zurueck - " + std::to_string(g_app->gamePaths.size()) + " Spielordner, geladen " + std::to_string(*geladen) +
                     (*geladen ? std::string() : " (" + *fehler + ")"));
        return !regelwerkJediOutcast() && !g_app->gamePaths.empty() && *geladen && !g_app->model.empty() && statusMit(st->weg, st->status0) == 0 &&
               statusMit(st->wegJk2, st->status0) == 0 && g_app->spielordnerFehlend.empty();
    }));
    add(tu("GDPFAD: der Ordner fehlt noch einmal", [=] {
        st->status0 = g_app->statusLines.size();
        g_app->settings.gamePaths = {st->weg};
        rescanGamePaths();
    }));
    add(pruefe("GDPFAD zurueck: fehlt der Ordner spaeter wieder, meldet ihn die Statuszeile wieder (einmal)", [=] {
        return g_app->gamePaths.empty() && statusMit(st->weg, st->status0) == 1;
    }));
    add(tu("GDPFAD: aufraeumen", [=] {
        g_app->settings.gamePaths = st->jka;
        rescanGamePaths();
        refreshPk3List();
        g_app->leftMode = 1;
        g_app->doc.markSaved();
    }));
    add(pause(0.3));
    return s;
}

}  // namespace gdpfad
