                     }
                     setzeMaus(e->rect.GetCenter());
                 }
                 return b >= 30;
             }});
        add(pruefe("tabfenster: das Mission-Fenster zeichnet, wenn sich darin etwas tut", [m] {
            tt::Messung jetzt;
            tt::bilderMerken(jetzt);
            const unsigned long long mission = jetzt.bilder[1] - m->bilder[1];
            const unsigned long long karte = jetzt.bilder[3] - m->bilder[3];
            diag::detail("Knopftest: tabfenster: Maus ueber Mission - Mission " + std::to_string(mission) + " Bilder, Map Editor " +
                         std::to_string(karte));
            return mission > 0ULL;
        }));
    }
    // --- Model ueber das Menue "Fenster", Schliessen holt den Tab zurueck ---------------
    add(tu("tabfenster: Hauptfenster zeigt Model", [] { g_app->leftMode = 2; }));
    add(stabil("tabfenster: Model", 30));
    add(klick(tr(Str::DockMenu), "###main"));
    add(klick(tr(Str::TfMenuEigenes)));
    add(pause(0.5));
    add(pruefe("tabfenster: Menue Fenster: Model in eigenem Fenster, das Hauptfenster zeigt den ersten freien Tab (Events)",
               [] { return tabfenster::eigenes(2) && tt::eigenesWindowsFenster(2) && g_app->leftMode == 0; }));
    add(tu("tabfenster: Model-Fenster in die linke untere Ecke", [] { tt::ablegen(2, true); }));
