                 if (w == nullptr || leiste.GetWidth() <= 0.0F) {
                     meldeFehler("tabfenster: Model-Fenster oder Modusleiste fehlt");
                     return true;
                 }
                 start = ImVec2{w->Pos.x + w->Size.x * 0.5F, w->Pos.y + w->TitleBarHeight * 0.5F};
                 ziel = leiste.GetCenter();
                 setzeMaus(start);
                 return false;
             }
             if (b == 2) { io.AddMouseButtonEvent(0, true); return false; }
             if (b >= 3 && b <= 20) {
                 const float f = static_cast<float>(b - 2) / 18.0F;
                 setzeMaus(ImVec2{start.x + (ziel.x - start.x) * f, start.y + (ziel.y - start.y) * f});
                 return false;
             }
             if (b == 24) { io.AddMouseButtonEvent(0, false); return false; }
             return b >= 30;
         }});
    add(pause(0.3));
    add(pruefe("tabfenster: Zurueckgezogen: Model ist zurueck im Hauptfenster und wird gezeigt",
               [] { return !tabfenster::eigenes(2) && g_app->leftMode == 2; }));
    // --- WM_CLOSE (wie Alt+F4) am Map-Editor-Fenster ---------------------------------------
    add(tu("tabfenster: Hauptfenster Events; WM_CLOSE an das Windows-Fenster des Map Editors", [] {
        g_app->leftMode = 0;
        if (const ImGuiWindow* w = tabfenster::fenster(3); w != nullptr && w->Viewport != nullptr && w->Viewport->PlatformHandleRaw != nullptr) {
            (void)platform::fensterSchliessenSenden(w->Viewport->PlatformHandleRaw);
        }
    }));
    add(pause(0.3));
    add(pruefe("tabfenster: WM_CLOSE: Map Editor ist zurueck im Hauptfenster und wird gezeigt",
               [] { return !tabfenster::eigenes(3) && g_app->leftMode == 3; }));
    // --- Fuer den Neustart: Mission und Map Editor in eigenen Fenstern ----------------------
    add(tu("tabfenster: Hauptfenster Events, Map Editor wieder loesen", [] {
        g_app->leftMode = 0;
        const ImGuiViewport* v = ImGui::GetMainViewport();
        (void)tabfenster::loesenBei(3, ImVec2{v->Pos.x + v->Size.x * 0.5F, v->Pos.y + v->Size.y * 0.5F});
    }));
    add(pause(0.5));
    add(tu("tabfenster: Lagen fuer den Neustart festhalten", [] {
        std::ofstream o(::bhed::utf8Pfad(tt::pfadErwartet()));
        for (const int t : tabfenster::modi()) {
            const ImGuiWindow* w = tabfenster::fenster(t);
            if (w == nullptr) { continue; }
            o << t << " " << static_cast<int>(std::lround(w->Pos.x)) << " " << static_cast<int>(std::lround(w->Pos.y)) << " "
              << static_cast<int>(std::lround(w->Size.x)) << " " << static_cast<int>(std::lround(w->Size.y)) << "\n";
            diag::detail("Knopftest: tabfenster fuer den Neustart: Tab " + std::to_string(t) + " " + tt::rechteckText(w));
        }
        diag::detail("Knopftest: tabfenster: Einstellung \"" + tabfenster::kodiert() + "\", Bildschirme " +
                     std::to_string(ImGui::GetPlatformIO().Monitors.Size));
    }));
    add(pruefe("tabfenster: zwei Tabs fuer den Neustart in eigenen Fenstern",
               [] { return tabfenster::modi() == std::vector<int>{1, 3} && g_app->settings.fenster.count(fenster::kTabSchluessel) == 1U; }));
    return s;
}

// --- BHED_EDITORTEST=tabfensterneustart: der zweite Start mit denselben Einstellungen --
std::vector<Schritt> tabfensterNeustartSchritte() {
    namespace tt = tabfenster_t;
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    add(stabil("tabfensterneustart: Start", 30));
    add(pause(0.5));
    add(pruefe("tabfensterneustart: dieselben Tabs an derselben Stelle wie vor dem Beenden", [] {
        std::ifstream f(::bhed::utf8Pfad(tt::pfadErwartet()));
        int t = 0, x = 0, y = 0, b = 0, h = 0, n = 0;
        bool ok = true;
        while (f >> t >> x >> y >> b >> h) {
            ++n;
            const ImGuiWindow* w = tabfenster::fenster(t);
            const bool gleich = w != nullptr && std::abs(static_cast<int>(std::lround(w->Pos.x)) - x) <= 1 &&
                                std::abs(static_cast<int>(std::lround(w->Pos.y)) - y) <= 1 &&
                                std::abs(static_cast<int>(std::lround(w->Size.x)) - b) <= 1 &&
                                std::abs(static_cast<int>(std::lround(w->Size.y)) - h) <= 1;
            diag::detail("Knopftest: tabfensterneustart: Tab " + std::to_string(t) + " erwartet " + std::to_string(x) + "," + std::to_string(y) +
                         " " + std::to_string(b) + "x" + std::to_string(h) + ", gefunden " + tt::rechteckText(w) + (gleich ? "" : "  ABWEICHUNG"));
            if (!gleich || !tt::eigenesWindowsFenster(t)) { ok = false; }
        }
        return ok && n == 2 && g_app->leftMode == 0;
    }));
    add(tu("tabfensterneustart: alle Tabs zurueck", [] { tabfenster::alleZurueck(); }));
    add(pause(0.3));
    add(pruefe("tabfensterneustart: alle zurueck, die Einstellung ist leer",
               [] { return tabfenster::anzahl() == 0 && g_app->settings.fenster.count(fenster::kTabSchluessel) == 0U; }));
    return s;
}

// --- BHED_EDITORTEST=tabfensterleistung: zwei 3D-Ansichten zugleich (allein laufen lassen) --
//
// Mission (mp/duel1, Kamera fliegt) und Map Editor (BHED_LEISTUNG_MAP oder die
// Testkarte, Kamera dreht) je allein im Hauptfenster und mit dem anderen Tab in
// einem eigenen Fenster; dazu der Leerlauf mit und ohne eigenes Fenster. Zeilen
// "Leistung: ..." wie im Modus leistung. Die Bildgroesse der Vorschau steht dabei,
// damit sichtbar ist, dass keine Ansicht kleiner oder einfacher zeichnet.
std::vector<Schritt> tabfensterLeistungSchritte() {
    namespace tt = tabfenster_t;
    namespace ke = karteneditor;
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    add(tu("tabfensterleistung: Map Editor, Karte", [] {
        tabfenster::alleZurueck();
        const std::filesystem::path ziel = std::filesystem::current_path() / "t1_leistung.map";
        const char* m = std::getenv("BHED_LEISTUNG_MAP");
        std::error_code ec;
        if (m != nullptr && *m != '\0') {
            std::filesystem::copy_file(::bhed::utf8Pfad(m), ziel, std::filesystem::copy_options::overwrite_existing, ec);
        } else {
            texturliste::schreibe(ziel, texturliste::karteText());
        }
        (void)ke::karteOeffnen(ziel.string());
        g_app->leftMode = 3;
    }));
    add(warteBis("tabfensterleistung: Spieldaten", [] {
        ke::spielPruefen();
        return ke::spielBereit();
    }, 20000));
    add(warteBis("tabfensterleistung: Texturen", [] { return ke::kameraBilderFertig(); }, 20000));
    add(tu("tabfensterleistung: Mission", [] { g_app->leftMode = 1; }));
    add(pause(0.5));
    leistung::karteLaden(s, "maps/mp/duel1.bsp");
    auto weg = std::make_shared<std::array<float, 6>>();
    const auto flugLage = [weg] {
        std::vector<std::array<float, 3>> orte;
        for (const MapEntity& e : g_app->map.entities) {
            float p[3];
            if (entityOrt(e, p)) { orte.push_back({p[0], p[1], p[2]}); }
        }
        if (orte.size() < 2U) { return; }
        *weg = {orte[0][0], orte[0][1], orte[0][2] + 64.0F, orte.back()[0], orte.back()[1], orte.back()[2] + 64.0F};
        g_app->playing = false;
        g_app->throughCamera = false;
        g_app->camViewActive = false;
    };
    const auto flug = [weg](int b) {
        const float t = static_cast<float>(b % 252) / 252.0F;
        const auto& w = *weg;
        for (std::size_t i = 0; i < 3U; ++i) { g_app->cam.pos[i] = w[i] + (w[i + 3U] - w[i]) * t; }
        const float ziel[3] = {w[3], w[4], w[5]};
        aimAngles(g_app->cam.pos, ziel, g_app->cam.angles);
        g_app->cam.angles[0] = 0.0F;
        g_app->mapDirty = true;
    };
    const auto dreht = [](int b) {
        ke::Editor& ed = ke::editor();
        ed.kamera.freiBewegen(6, (b / 60) % 2 == 0 ? 1 : -1, ed.kameraE);
    };
    const auto vorschauGroesse = [](const std::string& wann) {
        char z[200];
        std::snprintf(z, sizeof(z), "Leistung: Vorschau %s | Bild %.0f x %.0f, Zelle %.0f", wann.c_str(), static_cast<double>(g_app->kartenAnsicht[2] - g_app->kartenAnsicht[0]),
                      static_cast<double>(g_app->kartenAnsicht[3] - g_app->kartenAnsicht[1]), static_cast<double>(g_app->dbgZelleW));
        diag::detail(z);
    };
    add(tu("tabfensterleistung: Vorschau allein", [vorschauGroesse] { vorschauGroesse("allein"); }));
    add(leistung::bildzeit("T1 Mission allein, Flug", flugLage, flug));
    add(leistung::leerlauf("T1 Mission allein"));
    // Map Editor in ein eigenes Fenster neben dem Hauptfenster (gleich gross wie spaeter Mission)
    add(tu("tabfensterleistung: Map Editor in eigenem Fenster", [] { (void)tabfenster::loesen(3); }));
    add(pause(0.5));
    add(tu("tabfensterleistung: Lage", [] {
        if (const ImGuiWindow* w = tabfenster::fenster(3); w != nullptr) {
            ImGui::SetWindowPos(w->Name, ImVec2{ImGui::GetMainViewport()->Pos.x + 200.0F, ImGui::GetMainViewport()->Pos.y + 300.0F});
            ImGui::SetWindowSize(w->Name, ImVec2{1400.0F, 900.0F});
        }
    }));
    add(pause(1.0));
    add(tu("tabfensterleistung: Vorschau mit Map Editor daneben", [vorschauGroesse] { vorschauGroesse("mit Map Editor in eigenem Fenster"); }));
    add(leistung::bildzeit("T1 Mission Flug + Map Editor in eigenem Fenster (ruhend)", flugLage, flug));
    add(leistung::bildzeit("T1 Mission Flug + Map Editor in eigenem Fenster (Kamera dreht)", flugLage, [flug, dreht](int b) {
        flug(b);
        dreht(b);
    }));
    add(leistung::leerlauf("T1 Mission + Map Editor in eigenem Fenster"));
    // Umgekehrt: Map Editor im Hauptfenster, Mission im eigenen Fenster
    add(tu("tabfensterleistung: alle zurueck, Map Editor im Hauptfenster", [] {
        tabfenster::alleZurueck();
        g_app->leftMode = 3;
    }));
    add(pause(1.0));
    add(leistung::bildzeit("T1 Map Editor allein, Kamera dreht", [] {}, dreht));
    add(tu("tabfensterleistung: Mission in eigenem Fenster", [] { (void)tabfenster::loesen(1); }));
    add(pause(0.5));
    add(tu("tabfensterleistung: Lage", [] {
        if (const ImGuiWindow* w = tabfenster::fenster(1); w != nullptr) {
            ImGui::SetWindowPos(w->Name, ImVec2{ImGui::GetMainViewport()->Pos.x + 200.0F, ImGui::GetMainViewport()->Pos.y + 300.0F});
            ImGui::SetWindowSize(w->Name, ImVec2{1400.0F, 900.0F});
        }
    }));
    add(pause(1.0));
    add(leistung::bildzeit("T1 Map Editor Kamera dreht + Mission in eigenem Fenster (ruhend)", [] {}, dreht));
    add(leistung::bildzeit("T1 Map Editor Kamera dreht + Mission in eigenem Fenster (Flug)", flugLage, [flug, dreht](int b) {
        flug(b);
        dreht(b);
    }));
    add(tu("tabfensterleistung: Ende", [] { tabfenster::alleZurueck(); }));
    add(pause(0.3));
    return s;
}

// --- BHED_EDITORTEST=tabfenster mit BHED_TF_NUR=fotos: die Bilder der Handbuchseite ---
// (BHED_FOTOS, BHED_SPRACHE, BHED_HB_FENSTER wie beim Handbuch; danach tools/handbuch/bilder.py).
namespace tabfenster_t {

// Wie hb::fotoTeil, aber mit den eigenen Fenstern an ihrer Stelle ueber dem Hauptfenster.
Schritt fotoMitFenstern(const std::string& name, std::function<ImRect()> ausschnitt) {
    return {"Foto " + name, [=](int b) {
                const char* ordner = std::getenv("BHED_FOTOS");
                if (ordner == nullptr) { return true; }
                if (b == 1) {
                    ImRect r = ausschnitt();
                    const ImGuiViewport* v = ImGui::GetMainViewport();
                    r.Min.x = std::max(0.0F, r.Min.x - v->Pos.x);
                    r.Min.y = std::max(0.0F, r.Min.y - v->Pos.y);
                    r.Max.x = std::min(v->Size.x, r.Max.x - v->Pos.x);
                    r.Max.y = std::min(v->Size.y, r.Max.y - v->Pos.y);
                    std::ofstream f(::bhed::utf8Pfad(std::string(ordner) + "\\" + name + ".rect"));
                    f << static_cast<int>(r.Min.x) << " " << static_cast<int>(r.Min.y) << " " << static_cast<int>(r.Max.x) << " "
                      << static_cast<int>(r.Max.y) << "\n";
                }
                if (b == 2) { render::fotoMitFensternAnfordern(std::string(ordner) + "\\" + name + ".bmp"); }
                return b >= 5;
            }};
}

ImRect hauptRect() {
    const ImGuiViewport* v = ImGui::GetMainViewport();
    return ImRect{v->Pos, ImVec2{v->Pos.x + v->Size.x, v->Pos.y + v->Size.y}};
}

// Die volle Breite des Hauptfensters (in Fensterpunkten), von oben bis unter das
// Klappmenue - so bleibt das Menue gross und das Bild mindestens so breit wie das Fenster.
ImRect obenBisMenue() {
    const ImRect h = hauptRect();
    float unten = h.Min.y + h.GetHeight() * 0.5F;
    for (const ImGuiWindow* w : GImGui->Windows) {
        if (w->WasActive && (w->Flags & ImGuiWindowFlags_Popup) != 0) { unten = std::max(unten, w->Pos.y + w->Size.y + 24.0F); }
    }
    return ImRect{ImVec2{0.0F, 0.0F}, ImVec2{h.GetWidth(), std::min(h.GetHeight(), unten - h.Min.y)}};
}

}  // namespace tabfenster_t

std::vector<Schritt> tabfensterFotoSchritte() {
    namespace tt = tabfenster_t;
    if (const char* sp = std::getenv("BHED_SPRACHE")) {
        if (const i18n::LanguageInfo* l = i18n::findLanguage(sp)) { i18n::setLanguage(l->language); }
    }
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    if (const char* f = std::getenv("BHED_HB_FENSTER")) {
        int b = 0;
        int h = 0;
        float z = 1.0F;
        if (std::sscanf(f, "%dx%d@%f", &b, &h, &z) >= 2 && b > 0 && h > 0) {
            add(tu("tabfenster Fotos: grosses Fenster", [b, h, z] {
                (void)platform::hauptfensterGroesse(b, h);
                g_app->uiScale = z;
            }));
        }
    }
    add(tu("tabfenster Fotos: Mission mp/duel1, Skript in Events", [] {
        tabfenster::alleZurueck();
        for (int b = 0; b < dock::kBereiche; ++b) { dock::zuruecksetzen(b); }
        g_app->settings.flussAnsicht = 0;
        for (auto& feld : g_app->splitPanes) { feld.ansicht = 0; }
        oeffneSkriptAusSpeicher("//Generated by BehavEd\n\naffect ( \"kyle\", /*@AFFECT_TYPE*/ FLUSH )\n{\n\tset ( /*@SET_TYPES*/ \"SET_NAVGOAL\", \"tor\" );\n"
                                "\twait ( 1000.000 );\n\tprint ( \"Mission\" );\n}\n\n",
                                "md_selbst/kyle_intro.txt");
        g_app->leftMode = 1;
        if (!loadMapFromArchive("maps/mp/duel1.bsp")) { meldeFehler("tabfenster Fotos: maps/mp/duel1.bsp nicht geladen"); }
    }));
    add(stufe9c::langeWarten("tabfenster Fotos: Karte gezeichnet", [] { return g_app->mapBereit && g_app->camTrackValid && !g_app->mapDirty; }, 20000));
    add(tu("tabfenster Fotos: Events im Hauptfenster", [] { g_app->leftMode = 0; }));
    add(stabil("tabfenster Fotos: Events", 30));
    // 1. Rechtsklick auf Mission in der Modusleiste
    add(klick(tr(Str::ViewMap), "###main", 0, false, "", 1));
    add(pause(0.4));
    add(hb::fotoTeil("h_tabfenster_menue", [] { return tt::obenBisMenue(); }));
    add(klick(tr(Str::TfLoesen)));
    add(pause(0.6));
    // 2. Zwei Fenster: Events links, Mission rechts (auf einem Bildschirm uebereinander gezeigt)
    add(tu("tabfenster Fotos: Mission-Fenster rechts", [] {
        if (const ImGuiWindow* w = tabfenster::fenster(1); w != nullptr) {
            const ImRect h = tt::hauptRect();
            ImGui::SetWindowPos(w->Name, ImVec2{h.Min.x + h.GetWidth() * 0.40F, h.Min.y + h.GetHeight() * 0.10F});
            ImGui::SetWindowSize(w->Name, ImVec2{h.GetWidth() * 0.58F, h.GetHeight() * 0.86F});
        }
    }));
    add(tu("tabfenster Fotos: Maus auf die Statuszeile (kein Hinweis im Bild)", [] {
        const ImRect h = tt::hauptRect();
        setzeMaus(ImVec2{h.Min.x + h.GetWidth() * 0.2F, h.Max.y - ImGui::GetFontSize() * 0.6F});
    }));
    add(pause(1.0));
    add(tt::fotoMitFenstern("h_tabfenster_zwei", [] { return tt::hauptRect(); }));
    // 3. Menue Fenster: dieser Tab in eigenem Fenster
    add(klick(tr(Str::DockMenu), "###main"));
    add(pause(0.4));
    add(hb::fotoTeil("h_tabfenster_fenstermenue", [] { return tt::obenBisMenue(); }));
    add(taste(ImGuiKey_Escape, "Escape"));
    // 4. Zurueckziehen: Titelleiste ueber der Modusleiste, gehalten
    add({"tabfenster Fotos: Titelleiste des Mission-Fensters ueber die Modusleiste ziehen (gehalten)", [](int b) {
             static ImVec2 start;
             static ImVec2 ziel;
             ImGuiIO& io = ImGui::GetIO();
             if (b == 0) {
                 const ImGuiWindow* w = tabfenster::fenster(1);
                 const ImRect leiste = tt::modusleisteHaupt();
                 if (w == nullptr || leiste.GetWidth() <= 0.0F) {
                     meldeFehler("tabfenster Fotos: Mission-Fenster oder Modusleiste fehlt");
                     return true;
                 }
                 start = ImVec2{w->Pos.x + ImGui::GetFontSize() * 6.0F, w->Pos.y + w->TitleBarHeight * 0.5F};
                 ziel = ImVec2{leiste.GetCenter().x, leiste.Min.y + leiste.GetHeight() * 0.3F};
                 setzeMaus(start);
                 return false;
             }
             if (b == 2) {
                 io.AddMouseButtonEvent(0, true);
                 return false;
             }
             if (b >= 3 && b <= 20) {
                 const float f = static_cast<float>(b - 2) / 18.0F;
                 setzeMaus(ImVec2{start.x + (ziel.x - start.x) * f, start.y + (ziel.y - start.y) * f});
                 return false;
             }
             return b >= 26;
         }});
    add(tt::fotoMitFenstern("h_tabfenster_zurueck", [] { return tt::hauptRect(); }));
    add({"tabfenster Fotos: loslassen", [](int b) {
             if (b == 0) { ImGui::GetIO().AddMouseButtonEvent(0, false); }
             return b >= 6;
         }});
    add(pause(0.5));
    add(pruefe("tabfenster Fotos: Mission zurueck im Hauptfenster", [] { return !tabfenster::eigenes(1) && g_app->leftMode == 1; }));
    return s;
}
