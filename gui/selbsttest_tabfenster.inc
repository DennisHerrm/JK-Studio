// --- rc609 T1: ganze Tabs in eigenen Fenstern (BHED_EDITORTEST=tabfenster) -----
//
// Prueft im laufenden Programm (tabfenster.h):
//   - Rechtsklick auf "Mission" in der Modusleiste, "In eigenem Fenster oeffnen":
//     ein eigenes Windows-Fenster (eigener Viewport mit Plattformfenster), das
//     Hauptfenster bleibt bei Events, beide zeigen dasselbe Skript.
//   - Bearbeitung in einem Fenster steht sofort im anderen (Script Flow beider).
//   - Kuerzel und Undo gehen an das Fenster mit dem Fokus: Strg+Z im Mission-
//     Fenster nimmt den Skript-Schritt zurueck (gemeinsamer Stapel des Skripts),
//     Strg+Z im Map-Editor-Fenster den Schritt der Karte - und nur den.
//   - "Map Editor" aus der Modusleiste gezogen und draussen losgelassen: eigenes Fenster.
//   - Menue "Fenster": Model in eigenem Fenster; Schliessknopf und WM_CLOSE (wie
//     Alt+F4) holen den Tab zurueck; die Titelleiste auf die Modusleiste gezogen ebenso.
//   - Leerlauf je Fenster: Arbeitet man im Hauptfenster, zeigen ruhende eigene
//     Fenster kein neues Bild.
//   - Anordnung nach dem Neustart (BHED_EDITORTEST=tabfensterneustart im selben
//     Einstellungsordner): dieselben Tabs an derselben Stelle.
namespace tabfenster_t {
namespace ke = karteneditor;

const char* const kSkript = "//Generated by BehavEd\n\nprint ( \"T1ALT\" );\nwait ( 1.000 );\n";

ImGuiWindow* haupt() { return ImGui::FindWindowByName("###main"); }

// Wie viele Zeilen zeigt der Script Flow (Feld "pane0") im Fenster `w` in
// diesem Bild - auch in Panels, die in ihm angedockt sind (DockSpace: ein Panel
// ist ein eigenes ImGui-Fenster, RootWindowDockTree ist w)? Jede Zeile ist ein
// Auswahlfeld: mit dem Befehlsnamen beschriftet (Row::name), in der schmalen
// Spalte des Mission-Tabs nur mit Symbol ("##schmal<n>"). "##ende" ist keine Zeile.
int zeilenImFluss(const ImGuiWindow* w) {
    if (w == nullptr) { return -1; }
    int n = 0;
    for (const elemente::Element& e : elemente::alle()) {
        if (e.innen.find("/pane0") == std::string::npos || e.label == "##ende" || e.label == e.innen) { continue; }
        const ImGuiWindow* oben = ImGui::FindWindowByName(e.fenster.c_str());
        if (oben != nullptr && (oben == w || oben->RootWindowDockTree == w)) { ++n; }
    }
    return n;
}

// Ein eigenes Fenster in die untere Haelfte des Hauptfensters (links = ab 30 %,
// sonst ab 65 % der Breite): Modusleiste, Reiter und die Zeilen des Script Flow
// oben, die Ereignisliste links bleiben frei - dort klickt der Test.
void ablegen(int modus, bool links) {
    const ImGuiWindow* w = tabfenster::fenster(modus);
    const ImGuiViewport* v = ImGui::GetMainViewport();
    if (w == nullptr) { return; }
    ImGui::SetWindowPos(w->Name, ImVec2{v->Pos.x + v->Size.x * (links ? 0.30F : 0.65F), v->Pos.y + v->Size.y * 0.52F});
    ImGui::SetWindowSize(w->Name, ImVec2{v->Size.x * 0.34F, v->Size.y * 0.44F});
}

std::string rechteckText(const ImGuiWindow* w) {
    if (w == nullptr) { return "(kein Fenster)"; }
    char z[96];
    std::snprintf(z, sizeof(z), "%.0f,%.0f %.0fx%.0f", static_cast<double>(w->Pos.x), static_cast<double>(w->Pos.y),
                  static_cast<double>(w->Size.x), static_cast<double>(w->Size.y));
    return z;
}

bool eigenesWindowsFenster(int modus) {
    const ImGuiWindow* w = tabfenster::fenster(modus);
    const bool ok = w != nullptr && w->Viewport != nullptr && w->Viewport != ImGui::GetMainViewport() && w->Viewport->PlatformWindowCreated &&
                    w->Viewport->PlatformHandleRaw != nullptr && w->ViewportOwned;
    diag::detail("Knopftest: tabfenster: Tab " + std::to_string(modus) + " - " + (w != nullptr ? std::string(w->Name) : std::string("kein Fenster")) +
                 " " + rechteckText(w) + (ok ? ", eigenes Windows-Fenster" : ", KEIN eigenes Windows-Fenster"));
    return ok;
}

// Der Knopf eines Tabs in der Modusleiste des Hauptfensters
std::function<ImVec2()> knopfImHaupt(Str s) {
    return [s] {
        const elemente::Element* e = elemente::finde(tr(s), "###main", 0, false);
        return e != nullptr ? e->rect.GetCenter() : ImVec2{-1.0F, -1.0F};
    };
}

ImRect modusleisteHaupt() {
    for (const ImGuiWindow* w : GImGui->Windows) {
        if (w->WasActive && w->RootWindowDockTree == haupt() && std::strstr(w->Name, "/modebar") != nullptr) { return w->Rect(); }
    }
    return ImRect{};
}

std::string pfadErwartet() {
    const char* e = std::getenv("BHED_EINSTELLUNGEN");
    return std::string(e != nullptr ? e : ".") + "\\tabfenster_erwartet.txt";
}

struct Messung {
    std::map<int, unsigned long long> bilder;   // Tab -> gezeigte Bilder seines Fensters
};

void bilderMerken(Messung& m) {
    m.bilder.clear();
    for (const int t : tabfenster::modi()) {
        if (const ImGuiWindow* w = tabfenster::fenster(t); w != nullptr && w->Viewport != nullptr) {
            m.bilder[t] = render::viewportBilder(w->Viewport->ID);
            diag::detail("Knopftest: tabfenster: Tab " + std::to_string(t) + " bisher " + std::to_string(m.bilder[t]) + " Bilder, Gruende: " +
                         render::viewportGruende(w->Viewport->ID));
        }
    }
}

std::shared_ptr<std::shared_ptr<karte::Primitiv>> g_pinsel = std::make_shared<std::shared_ptr<karte::Primitiv>>();
std::size_t g_tiefe = 0;
int g_zeilenHaupt = 0;     // Zeilen des Script Flow vor dem Loeschen, je Fenster (die schmale Spalte des Mission-Tabs zaehlt anders)
int g_zeilenMission = 0;

}  // namespace tabfenster_t

std::vector<Schritt> tabfensterSchritte() {
    namespace tt = tabfenster_t;
    namespace ke = karteneditor;
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    add(tu("tabfenster: Events, Skript mit T1ALT", [] {
        tabfenster::alleZurueck();
        g_app->leftMode = 0;
        g_app->settings.flussAnsicht = 0;   // die klassische Baumansicht (die Zeilen sind Elemente mit Text)
        for (auto& feld : g_app->splitPanes) { feld.ansicht = 0; }
        oeffneSkriptAusSpeicher(tt::kSkript, "md_selbst/t1_tabfenster.txt");
    }));
    add(stabil("tabfenster: Events", 30));
    add(pruefe("tabfenster: vorher kein Tab in eigenem Fenster, das Skript steht im Hauptfenster",
               [] { return tabfenster::anzahl() == 0 && tt::zeilenImFluss(tt::haupt()) == 2; }));
    // --- Mission ueber das Kontextmenue der Modusleiste ------------------------
    add(klick(tr(Str::ViewMap), "###main", 0, false, "", 1));
    add(klick(tr(Str::TfLoesen)));
    add(pause(0.5));
    add(pruefe("tabfenster: Mission in eigenem Windows-Fenster, das Hauptfenster bleibt bei Events",
               [] { return tabfenster::eigenes(1) && tt::eigenesWindowsFenster(1) && g_app->leftMode == 0; }));
    add(pruefe("tabfenster: das neue Fenster laesst die Modusleiste des Hauptfensters frei", [] {
        const ImGuiWindow* w = tabfenster::fenster(1);
        return w != nullptr && tt::modusleisteHaupt().GetWidth() > 0.0F && w->Pos.x >= tt::modusleisteHaupt().Max.x;
    }));
    add(tu("tabfenster: Mission-Fenster in die linke untere Ecke", [] { tt::ablegen(1, true); }));
    add(pause(0.3));
    add(pruefe("tabfenster: beide Fenster zeigen das Skript (Script Flow)", [] {
        const int h = tt::zeilenImFluss(tt::haupt());
        const int m = tt::zeilenImFluss(tabfenster::fenster(1));
        diag::detail("Knopftest: tabfenster: Zeilen im Hauptfenster " + std::to_string(h) + "x, im Mission-Fenster " + std::to_string(m) + "x");
        tt::g_zeilenHaupt = h;
        tt::g_zeilenMission = m;
        return h >= 2 && m >= 2;
    }));
    // --- Bearbeitung in einem Fenster ist im anderen sichtbar --------------------
    add(tu("tabfenster: Undo-Tiefe merken", [] { tt::g_tiefe = g_app->doc.undoDepth(); }));
    add(klick("wait", "dock.ereignisse.fluss"));
    add(klick("print", "dock.ereignisse.fluss"));
    add(taste(ImGuiKey_Delete, "Entf im Script Flow des Hauptfensters"));
    add(pause(0.2));
    add(pruefe("tabfenster: die geloeschte Zeile ist sofort auch im Mission-Fenster weg", [] {
        const int h = tt::zeilenImFluss(tt::haupt());
        const int m = tt::zeilenImFluss(tabfenster::fenster(1));
        diag::detail("Knopftest: tabfenster: nach dem Loeschen Zeilen im Hauptfenster " + std::to_string(h) + "x, im Mission-Fenster " +
                     std::to_string(m) + "x");
        return h == tt::g_zeilenHaupt - 1 && m == tt::g_zeilenMission - 1;
    }));
    add(tu("tabfenster: Fokus auf das Mission-Fenster", [] {
        if (const ImGuiWindow* w = tabfenster::fenster(1); w != nullptr) { ImGui::SetWindowFocus(w->Name); }
    }));
    add(pause(0.2));
    add(pruefe("tabfenster: Fokus beim Mission-Fenster", [] { return tabfenster::fokusModus() == 1; }));
    add(tasteKombi(ImGuiMod_Ctrl | ImGuiKey_Z, "Strg+Z im Mission-Fenster"));
    add(pause(0.2));
    add(pruefe("tabfenster: Strg+Z im Mission-Fenster nimmt den Schritt des Skripts zurueck - beide Fenster zeigen die Zeile wieder", [] {
        const int h = tt::zeilenImFluss(tt::haupt());
        const int m = tt::zeilenImFluss(tabfenster::fenster(1));
        diag::detail("Knopftest: tabfenster: nach Strg+Z Zeilen " + std::to_string(h) + "x / " + std::to_string(m) + "x, Undo-Tiefe " +
                     std::to_string(g_app->doc.undoDepth()) + " (vorher " + std::to_string(tt::g_tiefe) + ")");
        return h == tt::g_zeilenHaupt && m == tt::g_zeilenMission && g_app->doc.undoDepth() == tt::g_tiefe;
    }));
    // --- Map Editor aus der Modusleiste herausziehen ------------------------------
    add(tu("tabfenster: Fokus Hauptfenster", [] { ImGui::SetWindowFocus("###main"); }));
    add(pause(0.2));
    add({"tabfenster: Knopf Map Editor nach rechts aus dem Hauptfenster ziehen", [](int b) {
             static ImVec2 start;
             static ImVec2 ziel;
             ImGuiIO& io = ImGui::GetIO();
             if (b == 0) {
                 start = tt::knopfImHaupt(Str::ViewMapEditor)();
                 const ImGuiViewport* v = ImGui::GetMainViewport();
                 ziel = ImVec2{v->Pos.x + v->Size.x + ImGui::GetFontSize() * 6.0F, v->Pos.y + v->Size.y * 0.3F};
                 diag::detail("Knopftest: tabfenster: ziehe von " + std::to_string(static_cast<int>(start.x)) + "," +
                              std::to_string(static_cast<int>(start.y)) + " nach " + std::to_string(static_cast<int>(ziel.x)) + "," +
                              std::to_string(static_cast<int>(ziel.y)));
                 setzeMaus(start);
                 return start.x < 0.0F;
             }
             if (b == 2) { io.AddMouseButtonEvent(0, true); return false; }
             if (b >= 3 && b <= 14) {
                 const float f = static_cast<float>(b - 2) / 12.0F;
                 setzeMaus(ImVec2{start.x + (ziel.x - start.x) * f, start.y + (ziel.y - start.y) * f});
                 return false;
             }
             if (b == 15) { io.AddMouseButtonEvent(0, false); return false; }
             return b >= 20;
         }});
    add(pause(0.5));
    add(pruefe("tabfenster: Map Editor in eigenem Windows-Fenster, Hauptfenster weiter bei Events",
               [] { return tabfenster::eigenes(3) && tt::eigenesWindowsFenster(3) && g_app->leftMode == 0; }));
    add(tu("tabfenster: Map-Editor-Fenster in die rechte untere Ecke", [] { tt::ablegen(3, false); }));
    add(pause(0.3));
    // --- Kuerzel an das Fenster mit dem Fokus --------------------------------------
    add(tu("tabfenster: Karte mit einem Pinsel, Pinsel waehlen, Patch Cylinder (ein Schritt der Karte); ein Schritt im Skript", [] {
        const std::filesystem::path p = std::filesystem::current_path() / "t1_karte.map";
        texturliste::schreibe(p, "// entity 0\n{\n\"classname\" \"worldspawn\"\n// brush 0\n" +
                                     texturliste::kasten(0, 0, 0, 64, 64, 64, "common/caulk") + "}\n");
        (void)ke::karteOeffnen(p.string());
        ke::Editor& e = ke::editor();
        e.karte.auswahl.leeren();
        for (const auto& k : e.karte.welt()->kinder()) {
            if (k->art() == karte::Primitiv::Art::Pinsel) { *tt::g_pinsel = k; }
        }
        if (*tt::g_pinsel) { e.karte.auswahl.waehlen(e.karte.welt(), *tt::g_pinsel); }
        ke::auswahlGeaendert();
        (void)ke::ausfuehren("PatchCylinder");
        ImGui::SetWindowFocus("###main");
    }));
    add(pause(0.3));
    add(klick("wait", "dock.ereignisse.fluss"));
    add(klick("print", "dock.ereignisse.fluss"));
    add(taste(ImGuiKey_Delete, "Entf im Script Flow des Hauptfensters"));
    add(pause(0.2));
    add(tu("tabfenster: Undo-Tiefe merken", [] { tt::g_tiefe = g_app->doc.undoDepth(); }));
    add(pruefe("tabfenster: Karte: Schritt patchCreateCylinder; Skript: Zeile print geloescht",
               [] { return ke::editor().karte.undo.undoName() == "patchCreateCylinder" && tt::zeilenImFluss(tt::haupt()) == tt::g_zeilenHaupt - 1; }));
    add(tu("tabfenster: Fokus auf das Map-Editor-Fenster", [] {
        if (const ImGuiWindow* w = tabfenster::fenster(3); w != nullptr) { ImGui::SetWindowFocus(w->Name); }
    }));
    add(pause(0.2));
    add(tasteKombi(ImGuiMod_Ctrl | ImGuiKey_Z, "Strg+Z im Map-Editor-Fenster"));
    add(pause(0.3));
    add(pruefe("tabfenster: Strg+Z im Map-Editor-Fenster: die Karte ist zurueck, das Skript unveraendert", [] {
        diag::detail("Knopftest: tabfenster: Karte \"" + ke::editor().karte.undo.undoName() + "\", Skript-Tiefe " +
                     std::to_string(g_app->doc.undoDepth()) + " (vorher " + std::to_string(tt::g_tiefe) + ")");
        return ke::editor().karte.undo.undoName() != "patchCreateCylinder" && g_app->doc.undoDepth() == tt::g_tiefe &&
               tt::zeilenImFluss(tt::haupt()) == tt::g_zeilenHaupt - 1;
    }));
    add(tu("tabfenster: Karte: Patch Cylinder noch einmal; Fokus Hauptfenster", [] {
        ke::Editor& e = ke::editor();
        e.karte.auswahl.leeren();
        if (*tt::g_pinsel) { e.karte.auswahl.waehlen(e.karte.welt(), *tt::g_pinsel); }
        ke::auswahlGeaendert();
        (void)ke::ausfuehren("PatchCylinder");
        ImGui::SetWindowFocus("###main");
    }));
    add(pause(0.3));
    add(tasteKombi(ImGuiMod_Ctrl | ImGuiKey_Z, "Strg+Z im Hauptfenster"));
    add(pause(0.3));
    add(pruefe("tabfenster: Strg+Z im Hauptfenster (Events): das Skript ist zurueck, die Karte unveraendert", [] {
        diag::detail("Knopftest: tabfenster: Karte \"" + ke::editor().karte.undo.undoName() + "\", Skript-Tiefe " +
                     std::to_string(g_app->doc.undoDepth()) + " (vorher " + std::to_string(tt::g_tiefe) + ")");
        return ke::editor().karte.undo.undoName() == "patchCreateCylinder" && g_app->doc.undoDepth() + 1 == tt::g_tiefe &&
               tt::zeilenImFluss(tt::haupt()) == tt::g_zeilenHaupt;
    }));
    // --- Leerlauf je Fenster ----------------------------------------------------------
    {
        auto m = std::make_shared<tt::Messung>();
        add(stabil("tabfenster: alles ruhig", 30));
        add(tu("tabfenster: gezeigte Bilder der eigenen Fenster merken", [m] { tt::bilderMerken(*m); }));
        // Das Hauptfenster zeichnet jedes Bild (sein Present taktet die Schleife, die im
        // Selbsttest nie ruht); die Maus steht in ihm still ueber der Ereignisliste.
        add({"tabfenster: 90 Bilder lang zeichnet das Hauptfenster, die Maus steht ueber seiner Ereignisliste", [](int b) {
                 const ImGuiViewport* v = ImGui::GetMainViewport();
                 if (b == 0) { setzeMaus(ImVec2{v->Pos.x + v->Size.x * 0.15F, v->Pos.y + v->Size.y * 0.45F}); }
                 return b >= 90;
             }});
        add(pruefe("tabfenster: das ruhende Mission-Fenster hat kein neues Bild gezeigt", [m] {
            tt::Messung jetzt;
            tt::bilderMerken(jetzt);
            bool ok = jetzt.bilder.size() == 2U;
            for (const auto& [tab, n] : jetzt.bilder) {
                const unsigned long long vorher = m->bilder.count(tab) != 0U ? m->bilder.at(tab) : 0ULL;
                diag::detail("Knopftest: tabfenster: Leerlauf - Tab " + std::to_string(tab) + " zeigte " + std::to_string(n - vorher) +
                             " Bilder in 90 (vorher insgesamt " + std::to_string(vorher) + ")");
                // Der Map Editor zeichnet seine Ansichten in jedem Bild neu (wie im Hauptfenster,
                // NOTIZEN_rc609_t1.md "Offen") - gemessen, nicht verlangt.
                if (tab != 3 && (n - vorher != 0ULL || vorher == 0ULL)) { ok = false; }
                if (const ImGuiWindow* w = tabfenster::fenster(tab); w != nullptr && w->Viewport != nullptr) {
                    diag::detail("Knopftest: tabfenster: Leerlauf - Tab " + std::to_string(tab) + " Gruende: " + render::viewportGruende(w->Viewport->ID));
                }
            }
            return ok;
        }));
        add(tu("tabfenster: gezeigte Bilder merken", [m] { tt::bilderMerken(*m); }));
        add({"tabfenster: die Maus auf den Knopf Events der Modusleiste im Mission-Fenster, 30 Bilder", [](int b) {
                 if (b == 0) {
                     const elemente::Element* e = elemente::finde(tr(Str::ViewEvents), "dock.mission.modus", 0, false);
                     if (e == nullptr) {
                         meldeFehler("tabfenster: Knopf Events im Mission-Fenster nicht gefunden");
