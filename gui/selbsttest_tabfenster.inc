    add({"tabfenster: Schliessknopf des Model-Fensters", [](int b) {
             static ImVec2 ort;
             ImGuiIO& io = ImGui::GetIO();
             if (b == 0) {
                 const ImGuiWindow* w = tabfenster::fenster(2);
                 const elemente::Element* e = (w != nullptr) ? elemente::findeKennung(ImHashStr("#CLOSE", 0, w->ID)) : nullptr;
                 if (e == nullptr) {
                     meldeFehler("tabfenster: Schliessknopf des Model-Fensters nicht gefunden");
                     return true;
                 }
                 ort = e->rect.GetCenter();
                 setzeMaus(ort);
                 return false;
             }
             if (b == 2) { io.AddMouseButtonEvent(0, true); return false; }
             if (b == 3) { io.AddMouseButtonEvent(0, false); return false; }
             return b >= 9;
         }});
    add(pause(0.3));
    add(pruefe("tabfenster: Schliessknopf: Model ist zurueck im Hauptfenster und wird gezeigt",
               [] { return !tabfenster::eigenes(2) && tabfenster::fenster(2) == nullptr && g_app->leftMode == 2; }));
