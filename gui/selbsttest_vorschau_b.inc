                                    g_app->playMs = st->t;
                                    g_app->mapDirty = true;
                                    st->seit = std::chrono::steady_clock::now();
                                    return false;
                                }});
                 // BHED_SZENEN_FOTO="0.3 0.6": Fotos an diesen Anteilen der
