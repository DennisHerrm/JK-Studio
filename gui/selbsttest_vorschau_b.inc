        add(warteBis("Tuer-Lauf: Reiter " + std::to_string(i) + " vorn", [=] {
            const int r = *ab + i;
            return r >= static_cast<int>(g_app->tabs.size()) || (g_app->activeTab == r && g_app->tabRequest < 0);
        }, 300));
        add(tu("Tuer-Lauf: Wege im Reiter " + std::to_string(i), [=] {
            const int r = *ab + i;
            if (r >= static_cast<int>(g_app->tabs.size())) { return; }
            // rc604 fix604: Speicher je Reiter. Der Reiterwechsel hat die
            // Szene schon vorbereitet; dieses zweite prepareScene darf keine
            // Bilder mehr anlegen (TextureSet::modellBloecke) - bis rc603
            // hingen die Modelle der Karte bei jedem Aufruf neu an
            // (taspir2: 18 GB nach 18 von 39 Reitern).
            const std::size_t bilderVor = g_app->textures.byShader.size();
            const long long memVor = gpu::speicherStand().prozessBytes;
            prepareScene();
            g_app->playing = false;
            {
                const gpu::SpeicherStand ms = gpu::speicherStand();
                const std::size_t bilderNach = g_app->textures.byShader.size();
                if (bilderNach != bilderVor) {
                    ++(*speicher)[0];
                    // rc605: wer die neuen Bilder angelegt hat (Effektshader,
                    // Modellblock) - fuer die Suche nach der Ursache.
                    std::string wer;
                    for (const auto& [n, platz] : g_app->effectShaders) {
                        if (platz >= static_cast<int>(bilderVor) && wer.size() < 400) { wer += " fx:" + n; }
                    }
                    for (const auto& [n, platz] : g_app->textures.modellBloecke) {
                        if (platz >= static_cast<int>(bilderVor) && wer.size() < 400) { wer += " block:" + n; }
                    }
                    diag::detail("Knopftest: Tuer-Lauf neue Bilder:" + (wer.empty() ? std::string(" (unbekannt)") : wer));
                }
                if ((*speicher)[1] < 0) { (*speicher)[1] = ms.prozessBytes; }
                (*speicher)[2] = ms.prozessBytes;
                char z[240];
                std::snprintf(z, sizeof(z),
                              "Knopftest: Tuer-Lauf Speicher Reiter %d: vorher %.1f MB, nachher %.1f MB, Bilder %zu -> %zu, Figuren %d, Figurenbilder %d",
                              i, static_cast<double>(memVor) / 1048576.0, static_cast<double>(ms.prozessBytes) / 1048576.0, bilderVor,
                              bilderNach, ms.figuren, ms.figurBilder);
                diag::detail(z);
            }
            {
                // rc604 fix604: welche Figuren der Reiter baut - und welche er
                // zeigt, bevor das Spiel sie spawnt (Spawner mit targetname,
                // in diesem Ablauf nie benutzt).
                int vorSpawn = 0;
                std::string liste;
                for (std::size_t ai = 0; ai < g_app->scene.actors.size(); ++ai) {
                    const Actor& a = g_app->scene.actors[ai];
                    const MapEntity* sp = nullptr;
                    for (const MapEntity& e : g_app->map.entities) {
                        const std::string* nt = e.find("NPC_targetname");
                        if (nt != nullptr && klein(*nt) == klein(a.name)) {
                            sp = &e;
                            break;
                        }
                    }
                    const bool wartet = sp != nullptr && !sp->targetname.empty();
                    const ActorState s0 = a.at(0.0);
                    const bool ab0 = s0.visible && !s0.removed;
                    const auto er = g_app->ablauf.erscheint.find(a.name);
                    const bool modell = ai < g_app->actorAssets.size() && !g_app->actorAssets[ai]->model.empty();
                    if (wartet && ab0) { ++vorSpawn; }
                    (*figurenJeReiter)[klein(g_app->tabs[static_cast<std::size_t>(r)].shownName)].insert(klein(a.name));
                    liste += " " + a.name + (a.kartenFigur ? "[karte]" : "") + (wartet ? "[use]" : "") + (ab0 ? "@0" : "") +
                             (er != g_app->ablauf.erscheint.end() ? "@" + std::to_string(static_cast<long>(er->second)) : std::string()) +
                             (modell ? "" : "[ohne Modell]");
                }
                diag::detail("Knopftest: Tuer-Lauf Figuren Reiter " + std::to_string(i) + " (" +
                             g_app->tabs[static_cast<std::size_t>(r)].shownName + "): " + std::to_string(g_app->scene.actors.size()) +
                             " gebaut, " + std::to_string(vorSpawn) + " vor ihrem Spawn zu sehen:" + liste);
            }
            if (g_app->ablauf.kartenwechselMs >= 0.0) {
                // rc605 (Ende): der Kartenwechsel beendet die Vorschau.
                char z[300];
                std::snprintf(z, sizeof(z),
                              "Knopftest: Tuer-Lauf Kartenwechsel Reiter %d (%s): bei %.0f ms nach %s, Nachbau bis %.0f, Zeitleiste bis %.0f/%.0f, Kamera bis %.0f",
                              i, g_app->tabs[static_cast<std::size_t>(r)].shownName.c_str(), g_app->ablauf.kartenwechselMs,
                              g_app->ablauf.kartenwechselKarte.c_str(), g_app->ablauf.laufMs, g_app->timeline.practicalEndMs,
                              g_app->timeline.durationMs, g_app->camTrack.durationMs);
                diag::detail(z);
            }
            if (g_app->ablauf.missionFailedMs >= 0.0) {
                // rc605 (Ende): SET_MISSIONFAILED - stop_icarus haelt die Skripte an.
                char z[300];
                std::snprintf(z, sizeof(z),
                              "Knopftest: Tuer-Lauf Mission gescheitert Reiter %d (%s): bei %.0f ms (%s), Skripte bis %.0f, Nachbau bis %.0f, Zeitleiste bis %.0f",
                              i, g_app->tabs[static_cast<std::size_t>(r)].shownName.c_str(), g_app->ablauf.missionFailedMs,
                              g_app->ablauf.missionFailedText.c_str(), g_app->ablauf.skripteStoppMs, g_app->ablauf.laufMs,
                              g_app->timeline.practicalEndMs);
                diag::detail(z);
            }
            if (!g_app->hurtTode.empty()) {
                // rc605 (Ende): wen ein trigger_hurt toetet (hurtTodeBerechnen)
                // und ob die Szene den Tod zeigt (Actor::getoetetMs).
                std::string tode;
                for (const AblaufWelt::HurtTod& h : g_app->hurtTode) {
                    double gezeigt = -1.0;
                    for (const Actor& a : g_app->scene.actors) {
                        if (a.name == h.figur) { gezeigt = a.getoetetMs; }
                    }
                    tode += " " + h.figur + "@" + std::to_string(static_cast<long>(h.ms)) + (h.unsterblich ? "[undying]" : "") +
                            "/Szene " + std::to_string(static_cast<long>(gezeigt));
                }
                diag::detail("Knopftest: Tuer-Lauf trigger_hurt Reiter " + std::to_string(i) + " (" +
                             g_app->tabs[static_cast<std::size_t>(r)].shownName + "):" + tode);
            }
            const auto& tab = g_app->tabs[static_cast<std::size_t>(r)];
            // rc605 (fix605): wann die Szene fuer eine Figur im Spiel endet oder
            // ihr Weg nicht mehr der des Skripts ist (nur fuer den Befund):
            // - use auf einen target_level_change: G_ChangeMap schickt
            //   "maptransition" (g_utils.cpp / g_target.cpp target_level_change_use
            //   OpenJK), die Karte endet - md_fh1_jedi transition: levelchange bei
            //   11500 ms, starkiller ist dann noch unterwegs zu nav3;
            // - remove: die Figur ist fort (md_gd_jedi cin1_jedi: ani1 2 s nach dem
            //   Sprung);
            // - SET_ENEMY: danach waehlt die Kampf-KI den Weg (Jedi_Attack ->
            //   Jedi_Advance setzt goalEntity = enemy, AI_Jedi.cpp), abhaengig vom
            //   Spieler und Q_irand - nicht nachgebildet (t3_stamp, taspir2, kor2,
            //   t3_rift: BS_JUMP, wait 777, BS_DEFAULT, SET_ENEMY).
            // rc605 (Schlussrunde): der Kartenwechsel, wie ihn der Nachbau sieht -
            // ein '+'-Menue (G_ChangeMap: uimenu) laedt keine Karte und zaehlt nicht.
            const double kartenwechselMs = g_app->ablauf.kartenwechselMs;
            const auto feindAb = [](const std::string& wer) {
                double ab = -1.0;
                for (const Node& n : g_app->ablauf.flach.nodes) {
                    if (n.name != "affect" || n.args.empty() || klein(n.args[0].text) != klein(wer)) { continue; }
                    double t = 0.0;
                    for (const Node& c : n.children) {
                        if (c.name == "wait" && !c.args.empty()) {
                            t += std::atof(c.args[0].text.c_str());
                            continue;
                        }
                        if (c.name == "set" && c.args.size() >= 2 && klein(c.args[0].text) == "set_enemy" &&
                            !c.args[1].text.empty() && klein(c.args[1].text) != "null" && (ab < 0.0 || t < ab)) {
                            ab = t;
                        }
                    }
                }
                return ab;
            };
            for (const Actor& a : g_app->scene.actors) {
                // rc605 (Rest): Fall und Landung ausserhalb eines Wegs (schwerkraft.cpp).
                if (!a.fallAnims.empty()) {
                    int ln = 0;
                    int lu = 0;
                    int gezeigt = 0;
                    for (const Actor::FallAnim& f : a.fallAnims) {
                        (f.code == kSaInAir1 ? lu : ln) += 1;
                        const char* n = sprungAnimName(f.code);
                        if (n != nullptr && a.at(std::max(0.0, f.t + 1.0)).animation == n) { ++gezeigt; }
                    }
                    (*summe)[9] += ln;
                    (*summe)[10] += lu;
                    char z[240];
                    std::snprintf(z, sizeof(z),
                                  "Knopftest: Tuer-Lauf Fall ausserhalb eines Wegs %s %s %s: Landungen %d (erste %.0f ms), Luft %d, in der Szene gezeigt %d",
                                  karte.c_str(), tab.shownName.c_str(), a.name.c_str(), ln, a.fallAnims.front().t, lu, gezeigt);
                    diag::detail(z);
                }
                double von = -1.0;
                double bis = -1.0;
                int wege = 0;
                int an = 0;
                const ActorStep* letzter = nullptr;
                // rc603 fix603: die Plaene der Wegstuecke (mehrere Stuecke
                // teilen einen) - bis wohin gezeigt.
                std::map<const LaufPlan*, double> plaene;
                for (const ActorStep& st : a.steps) {
                    if (st.kind != ActorStep::Kind::WalkTo) { continue; }
                    letzter = &st;
                    if (von < 0.0) { von = st.startMs; }
                    bis = std::max(bis, st.endMs);
                    ++wege;
                    if (st.ankunftMs >= 0.0) { ++an; }
                    if (st.lauf) {
                        auto [it, neu] = plaene.emplace(st.lauf.get(), st.endMs);
                        if (!neu) { it->second = std::max(it->second, st.endMs); }
                    }
                }
                for (const auto& [vp, vt] : a.vorlaeufe) {
                    if (vp) {
                        auto [it, neu] = plaene.emplace(vp.get(), vt);
                        if (!neu) { it->second = std::max(it->second, vt); }
                    }
                }
                if (wege == 0) { continue; }
                int kehren = 0;
                const double ende = std::min(bis, von + 60000.0);
                float ax = 0.0F;
                float ay = 0.0F;
                for (double t = von + 250.0; t <= ende; t += 250.0) {
                    const ActorState p = a.at(t - 250.0);
                    const ActorState q = a.at(t);
                    const float bx = q.pos[0] - p.pos[0];
                    const float by = q.pos[1] - p.pos[1];
                    const float la = std::hypot(ax, ay);
                    const float lb = std::hypot(bx, by);
                    if (la > 2.0F && lb > 2.0F && ax * bx + ay * by < -0.5F * la * lb) { ++kehren; }
                    if (lb > 2.0F) {
                        ax = bx;
                        ay = by;
                    }
                }
                // rc603 fix603: jedes Denkbild gegen die Grenze (tuerlauf::spruenge).
                float schwer = std::max(800.0F, g_app->scene.schwerkraft);
                for (const auto& [ms, g] : g_app->scene.schwerkraftAb) { schwer = std::max(schwer, std::fabs(g)); }
                for (const auto& [ms, g] : a.eigeneSchwerkraft) { schwer = std::max(schwer, std::fabs(g)); }
                std::vector<tuerlauf::Sprung> spr;
                for (const auto& [plan, planBis] : plaene) { tuerlauf::spruenge(*plan, planBis, schwer, spr); }
                std::sort(spr.begin(), spr.end(), [](const tuerlauf::Sprung& x, const tuerlauf::Sprung& y) { return x.t < y.t; });
                (*summe)[0] += 1;
                (*summe)[1] += an == 0 ? 1 : 0;
                (*summe)[2] += kehren > 2 ? 1 : 0;
                (*summe)[3] += static_cast<int>(spr.size());
                // rc605: NPC-Abspruenge (NPC_TryJump -> NPC_Jump, LaufTakt::sprung) bis zum Ende jedes Plans.
                int abspruenge = 0;
                for (const auto& [plan, planBis] : plaene) {
                    for (const LaufTakt& k : plan->takte) {
                        if (k.sprung && k.t <= planBis + 0.5) { ++abspruenge; }
                    }
                }
                (*summe)[4] += abspruenge;
                // rc605 (Rest): Landungen / Luftanimationen der Sprungkette ohne Sprung
                // (kein LaufTakt::sprung, kein BS_JUMP) - Fall von einer Kante.
                int landungen = 0;
                int luft = 0;
                for (const auto& [plan, planBis] : plaene) {
                    // Ein Plan, der in der Luft beginnt, setzt einen Sprung eines
                    // frueheren Plans fort (BS_JUMP -> BS_DEFAULT).
                    const LaufZustand::Sprung& sa = plan->anfang.sprung;
                    bool gesprungen = sa.springt || sa.laeuft || sa.abgehoben || sa.bsAktiv || sa.beinAnim != 0;
                    int vorher = plan->anfang.sprung.beinAnim;
                    for (const LaufTakt& k : plan->takte) {
                        if (k.t > planBis + 0.5) { break; }
                        gesprungen = gesprungen || k.sprung || k.bsAnim != 0;
                        if (!gesprungen && k.beinAnim != vorher && std::fabs(k.beinAnimAb - k.t) < 0.5) {
                            const int c = k.beinAnim;
                            if (c == 3 || c == 6 || (c >= 16 && c <= 21)) { ++landungen; }
                            if (c == 2 || c == 5 || (c >= 8 && c <= 15)) { ++luft; }
                        }
                        vorher = k.beinAnim;
                    }
                }
                (*summe)[9] += landungen;
                (*summe)[10] += luft;
                if (landungen > 0 || luft > 0) {
                    diag::detail("Knopftest: Tuer-Lauf Fall ohne Sprung " + karte + " " + tab.shownName + " " + a.name + ": Landungen " +
                                 std::to_string(landungen) + ", Luftanimationen " + std::to_string(luft));
                }
                // rc605 (BS_JUMP-Nachpruefung): nie angekommen nach einem Sprung,
                // und das Ziel haengt hoeher als der Kasten (maxs[2] 40 + 1 aus
                // SV_LinkEntity) - STEER::Reached (g_navigator.cpp:5415 MD)
                // trifft es nur noch ueber den Radius. So bei den Navgoals, die
                // ein BS_JUMP-Skript nur als Zielpunkt nimmt (taspir2 j1/j2,
                // kor2 j4, NOTIZEN_rc604.md).
                if (an == 0 && abspruenge > 0 && letzter != nullptr &&
                    letzter->laufZiel[2] - a.at(letzter->endMs).pos[2] > 41.0F) {
                    (*summe)[5] += 1;
                }
                // rc604 fix604: Befund je Figur, die nie ankommt oder pendelt -
                // reicht die Zeit bis zum Schnitt fuer den geraden Weg (Abstand
                // am Planbeginn / hoechstes Tempo im Plan)? Steht sie vorher
                // still (nie, ruheMs)? Kommt der Plan aus dem gemeinsamen Takt
                // (andere Figuren im Weg)? Kehrt sie innerhalb EINES Plans um
                // (sonst wechselt das Skript die Ziele)?
                // rc605 (fix605): Szenenende / Feind vor dem Ende der Auswertung.
                std::string grund;
                if (an == 0 || kehren > 2) {
                    double entferntMs = -1.0;
                    for (const ActorStep& st : a.steps) {
                        if (st.kind == ActorStep::Kind::Gone && (entferntMs < 0.0 || st.startMs < entferntMs)) { entferntMs = st.startMs; }
                    }
                    const double feindMs = feindAb(a.name);
                    double schnitt = 1.0e18;
                    int art = -1;
                    if (entferntMs >= 0.0 && entferntMs < schnitt) { schnitt = entferntMs; art = 6; }
                    if (kartenwechselMs >= 0.0 && kartenwechselMs < schnitt) { schnitt = kartenwechselMs; art = 7; }
                    if (feindMs >= 0.0 && feindMs < schnitt) { schnitt = feindMs; art = 8; }
                    // rc605 (Schlussrunde): seit der Kartenwechsel die Szene beendet,
                    // endet ein abgeschnittener Weg genau dort - das zaehlt mit.
                    if (art >= 0 && (schnitt < ende || (art == 7 && schnitt <= ende + 1e-6))) {
                        (*summe)[static_cast<std::size_t>(art)] += 1;
                        char z[120];
                        std::snprintf(z, sizeof(z), "; %s bei %.0f", art == 6 ? "entfernt" : art == 7 ? "Kartenwechsel" : "Feind (Kampf-KI)", schnitt);
                        grund = z;
                    }
                }
                if (letzter != nullptr && letzter->lauf && (an == 0 || kehren > 2)) {
                    const LaufPlan& p = *letzter->lauf;
                    const float d0 = std::hypot(letzter->laufZiel[0] - p.anfang.ort[0], letzter->laufZiel[1] - p.anfang.ort[1]);
                    float vmax = 0.0F;
                    for (const LaufZustand& zz : p.zustaende) { vmax = std::max(vmax, std::hypot(zz.tempoVek[0], zz.tempoVek[1])); }
                    const double tVerf = letzter->endMs - p.abMs;
                    const double tNoetig = vmax > 1.0F ? std::max(0.0, static_cast<double>(d0) - 17.0) / vmax * 1000.0 : -1.0;
                    bool koerper = false;
                    if (g_app->koerperPlaene) {
                        for (const auto& [k, kp] : *g_app->koerperPlaene) { koerper = koerper || kp.get() == &p; }
                    }
                    // Umkehren innerhalb eines Plans.
                    int kehrenImPlan = 0;
                    {
                        float bx0 = 0.0F;
                        float by0 = 0.0F;
                        const LaufPlan* vorPlan = nullptr;
                        for (double t = von + 250.0; t <= ende; t += 250.0) {
                            const LaufPlan* jetzt = nullptr;
                            for (const ActorStep& st : a.steps) {
                                if (st.kind == ActorStep::Kind::WalkTo && st.startMs <= t - 250.0 && st.endMs >= t) { jetzt = st.lauf.get(); }
                            }
                            const ActorState pp = a.at(t - 250.0);
                            const ActorState qq = a.at(t);
                            const float bx = qq.pos[0] - pp.pos[0];
                            const float by = qq.pos[1] - pp.pos[1];
                            const float la = std::hypot(bx0, by0);
                            const float lb = std::hypot(bx, by);
                            if (jetzt != nullptr && jetzt == vorPlan && la > 2.0F && lb > 2.0F && bx0 * bx + by0 * by < -0.5F * la * lb) {
                                ++kehrenImPlan;
                            }
                            if (jetzt != vorPlan) {
                                bx0 = 0.0F;
                                by0 = 0.0F;
                            }
                            if (lb > 2.0F) {
                                bx0 = bx;
                                by0 = by;
                            }
                            vorPlan = jetzt;
                        }
                    }
                    const char* klasse = "?";
                    if (an == 0) {
                        if (vmax <= 1.0F) {
                            klasse = "steht";
                        } else if (tVerf < tNoetig) {
                            klasse = "Zeit zu kurz";
                        } else if (p.nie || p.ruheMs >= 0.0) {
                            klasse = "bleibt stehen";
                        } else {
                            klasse = "langsamer als gerade";
                        }
                    } else {
                        klasse = kehrenImPlan > 2 ? "pendelt im Plan" : "Skript wechselt Ziele";
                    }
                    char z[400];
                    std::snprintf(z, sizeof(z),
                                  "Knopftest: Tuer-Lauf Befund %s %s %s: %s; Plan ab %.0f bis %.0f (%.0f ms), gerade %.0f weit, vmax %.0f, "
                                  "noetig %.0f ms, nie %d, Ruhe ab %.0f, Koerper %d, Umkehren im Plan %d",
                                  karte.c_str(), tab.shownName.c_str(), a.name.c_str(), klasse, p.abMs, letzter->endMs, tVerf,
                                  static_cast<double>(d0), static_cast<double>(vmax), tNoetig, p.nie ? 1 : 0, p.ruheMs, koerper ? 1 : 0,
                                  kehrenImPlan);
                    diag::detail(z + grund);
                }
                std::string zuletzt;
                if (letzter != nullptr) {
                    const ActorState e = a.at(letzter->endMs);
                    char z[200];
                    std::snprintf(z, sizeof(z), "; letztes Stueck %.0f-%.0f%s%s, Ziel %.0f %.0f, dort noch %.0f weit, Ziel %+.0f hoeher",
                                  letzter->startMs, letzter->endMs, letzter->teilweg ? " abgeschnitten" : "",
                                  (letzter->lauf && letzter->lauf->nie) ? " ohne Weg (nie)" : "",
                                  static_cast<double>(letzter->laufZiel[0]), static_cast<double>(letzter->laufZiel[1]),
                                  static_cast<double>(std::hypot(letzter->laufZiel[0] - e.pos[0], letzter->laufZiel[1] - e.pos[1])),
                                  static_cast<double>(letzter->laufZiel[2] - e.pos[2]));
                    zuletzt = z;
                }
                diag::detail("Knopftest: Tuer-Lauf Uebersicht " + tab.shownName + " " + a.name + ": " + std::to_string(wege) +
                             " Wegstuecke ab " + std::to_string(static_cast<int>(von)) + ", angekommen " + std::to_string(an) +
                             ", Umkehren " + std::to_string(kehren) + ", Spruenge " + std::to_string(spr.size()) +
                             ", NPC-Abspruenge " + std::to_string(abspruenge) + zuletzt);
                for (std::size_t j = 0; j < spr.size() && j < 6; ++j) {
                    char z[260];
                    std::snprintf(z, sizeof(z), "Knopftest: Tuer-Lauf Sprung %s %s %s: Denkbild %.0f ms geht %.1f weit, moeglich %.1f (pml.msec %d)",
                                  karte.c_str(), tab.shownName.c_str(), a.name.c_str(), spr[j].t, static_cast<double>(spr[j].weit),
                                  static_cast<double>(spr[j].grenze), spr[j].msec);
                    diag::detail(z);
                }
            }
            ++*nr;
        }));
        // rc604 fix604: BHED_SCHWER_VERGLEICH=1 - die Schwerkraft mit Movern
        // schnell (Raster, Speicher) und auf dem alten Weg, Bit fuer Bit.
        if (std::getenv("BHED_SCHWER_VERGLEICH") != nullptr) {
            add(pruefe("Schwerkraft mit Movern: Reiter " + std::to_string(i) + " schnell wie bisher, Bit fuer Bit", [=] {
                const int r = *ab + i;
                if (r >= static_cast<int>(g_app->tabs.size()) || !schwerkraftMitMovernNoetig()) { return true; }
                const auto hoehenHash = [] {
                    std::uint64_t h = 1469598103934665603ULL;
                    for (const Actor& a : g_app->scene.actors) {
                        for (const char c : a.name) { h = (h ^ static_cast<unsigned char>(c)) * 1099511628211ULL; }
                        const auto* d = reinterpret_cast<const unsigned char*>(a.hoehe.data());
                        for (std::size_t k = 0; k < a.hoehe.size() * sizeof(float); ++k) { h = (h ^ d[k]) * 1099511628211ULL; }
                        h = (h ^ a.hoehe.size()) * 1099511628211ULL;
                    }
                    return h;
                };
                const auto lauf = [&](bool schnell) {
                    gSchwerkraftSchnell.store(schnell);
                    const auto t0 = std::chrono::steady_clock::now();
                    schwerkraftVorschau(true);
                    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
                };
                const double msNeu = lauf(true);
                const std::uint64_t hNeu = hoehenHash();
                const double msAlt = lauf(false);
                const std::uint64_t hAlt = hoehenHash();
                gSchwerkraftSchnell.store(true);
                schwerkraftVorschau(true);
                char z[300];
                std::snprintf(z, sizeof(z), "Knopftest: Schwerkraft-Vergleich %s %s: schnell %.0f ms, bisher %.0f ms, Hash %016llx / %016llx",
                              karte.c_str(), g_app->tabs[static_cast<std::size_t>(r)].shownName.c_str(), msNeu, msAlt,
                              static_cast<unsigned long long>(hNeu), static_cast<unsigned long long>(hAlt));
                diag::detail(z);
                return hNeu == hAlt && hoehenHash() == hNeu;
            }));
        }
    }
    add(tu("Tuer-Lauf: Summe " + karte, [=] {
        diag::detail("Knopftest: Tuer-Lauf Summe " + karte + ": " + std::to_string(*nr) + " Reiter, " + std::to_string((*summe)[0]) +
                     " Figuren mit Weg, nie angekommen " + std::to_string((*summe)[1]) + ", pendelnd " +
                     std::to_string((*summe)[2]) + ", Spruenge " + std::to_string((*summe)[3]) + ", NPC-Abspruenge " +
                     std::to_string((*summe)[4]) + ", davon nie angekommen mit Navgoal ueber dem Kopf nach einem Sprung " +
                     std::to_string((*summe)[5]) + ", nie angekommen oder pendelnd: vorher entfernt " + std::to_string((*summe)[6]) +
                     ", nach Kartenwechsel " + std::to_string((*summe)[7]) + ", mit Feind " + std::to_string((*summe)[8]) +
                     ", Landeanimationen ohne Sprung " + std::to_string((*summe)[9]) + ", Luftanimationen ohne Sprung " +
                     std::to_string((*summe)[10]));
    }));
    add(pruefe("Tuer-Lauf: " + karte + " - kein Denkbild geht weiter, als Pmove die Figur tragen kann", [=] {
        return (*summe)[3] == 0;
    }));
    add(pruefe("Tuer-Lauf: " + karte + " - ein zweites prepareScene legt keine Bilder an (Speicher je Reiter)", [=] {
        char z[200];
        std::snprintf(z, sizeof(z), "Knopftest: Tuer-Lauf Speicher %s: %lld Reiter legten Bilder an, nach dem ersten Reiter %.1f MB, nach dem letzten %.1f MB",
                      karte.c_str(), (*speicher)[0], static_cast<double>((*speicher)[1]) / 1048576.0,
                      static_cast<double>((*speicher)[2]) / 1048576.0);
        diag::detail(z);
        return (*speicher)[0] == 0;
    }));
    // rc604 fix604: gemeldet "Ich muss Anakin vom Anfang der Map nicht bei den
    // Credits sehen ... ich brauche keine 5 Obi-Wans alle zeigen lassen". In
    // md_am_sith stehen ani1 bis ani5 (SFB_CINEMATIC, NPC_targetname) ab dem
    // Laden auf der Karte; der Reiter credit.ibi fuehrt nur ani4. Bis rc603 baute
    // er alle fuenf (38 Figuren); der Droide ohne Namen bleibt.
    if (karte == "md_am_sith") {
        add(pruefe("Tuer-Lauf: md_am_sith - credit.ibi zeigt nur seine Figuren (ani4, der Droide; nicht ani1-3, ani5)", [=] {
            const auto it = figurenJeReiter->find("credit.ibi");
            if (it == figurenJeReiter->end()) { return false; }
            const std::set<std::string>& f = it->second;
            const bool eigene = f.count("ani4") != 0U && f.count("npc_droid_r2d2#234") != 0U;
            const bool fremde = f.count("ani1") != 0U || f.count("ani2") != 0U || f.count("ani3") != 0U || f.count("ani5") != 0U;
            diag::detail("Knopftest: Tuer-Lauf credit.ibi: " + std::to_string(f.size()) + " Figuren, eigene " + (eigene ? "da" : "FEHLEN") +
                         ", fremde Darsteller " + (fremde ? "DA" : "fort"));
            return eigene && !fremde;
        }));
    }
    if (schliessen) {
        add(tu("Tuer-Lauf: Reiter der Mission " + karte + " schliessen", [=] {
            for (int r = static_cast<int>(g_app->tabs.size()) - 1; r >= std::max(1, *ab); --r) { reiterSchliessen(r); }
        }));
        add(pause(0.5));
    }
    return s;
}

// --- rc603 fix603: Zurueckspulen so fluessig wie Vorspulen (BHED_EDITORTEST=spulen) ---
//
// Gemeldet: "Wenn ich die Timeline von links nach rechts bewege, laeuft es
// fluessig, keine FPS-Probleme; wenn ich aber von rechts nach links bewege,
// um zurueckzuspulen, bricht die Framerate massiv ein."
// Nachgestellt mit echter Maus: auf dem Lineal der Zeitleiste druecken, je
// Bild ein Stueck (BHED_SPUL_SCHRITT ms, Vorgabe 100) nach rechts bis zum
// Ende der Szene (hoechstens 120 s), ebenso zurueck, dann loslassen.
// Gemessen wird jedes Bild (Wanduhr zwischen zwei Aufrufen) samt seinen
// Teilen (FrameCost::raw*), und jedes Bild traegt seine Pruefsumme
// (App::bildSumme): zur selben Zeit muss das Zurueckspulen Bit fuer Bit
// dasselbe zeigen wie das Vorspulen.
namespace spulen {
struct Bild {
    int richtung = 0;   // 0 vor, 1 zurueck
    double wand = 0.0;
    double ms = 0.0;
    float saber = 0.0F;
    float saberFx = 0.0F;
    float spuren = 0.0F;
    float effekte = 0.0F;
    float szene = 0.0F;
    float ansicht = 0.0F;
};
struct Lauf {
    bool gefunden = false;
    std::vector<float> xs;
    float y = 0.0F;
    std::size_t n = 0;
    double dauer = 0.0;
    int richtung = 0;
    std::chrono::steady_clock::time_point seit;
    std::vector<Bild> bilder;
    std::map<double, std::array<std::uint64_t, 5>> vor;
    std::map<double, std::array<std::uint64_t, 5>> zurueck;
    int verglichen = 0;
    int abweichend = 0;
    std::array<int, 5> abweichendTeil{};
    std::array<int, 2> blitzBilder{};   // Bilder mit Klirrblitz (Teil 4), vor / zurueck
    std::string abweichungen;   // die ersten Zeiten mit den verschiedenen Teilen
    int letztesSummenBild = -1;
    int letztesKostenBild = -1;
    // Lineal beim Druecken (x, Breite, Spanne, y). Aendert es sich beim Ziehen
    // (das Fenster wurde von aussen umgestellt), treffen vor und zurueck nicht
    // mehr dieselben Zeiten - dann wird die Probe einmal wiederholt.
    std::array<float, 4> lineal{};
    bool linealGeaendert = false;
    bool wiederholt = false;
    // Vorher-Stand der Oberflaeche
    int leftMode = 0;
    bool showTracks = true;
    float timelineFrac = 0.22F;
    double timelineZoom = 1.0;
    double timelineStart = 0.0;
    bool throughCamera = false;
};

struct Stat {
    int n = 0;
    double mittel = 0.0;
    double median = 0.0;
    double p95 = 0.0;
    double max = 0.0;
    double saber = 0.0;
    double saberFx = 0.0;
    double spuren = 0.0;
    double effekte = 0.0;
    double szene = 0.0;
    double ansicht = 0.0;
};
Stat statistik(const std::vector<Bild>& bilder, int richtung) {
    Stat s;
    std::vector<double> w;
    for (const Bild& b : bilder) {
        if (b.richtung != richtung) { continue; }
        w.push_back(b.wand);
        s.saber += b.saber;
        s.saberFx += b.saberFx;
        s.spuren += b.spuren;
        s.effekte += b.effekte;
        s.szene += b.szene;
        s.ansicht += b.ansicht;
    }
    s.n = static_cast<int>(w.size());
    if (w.empty()) { return s; }
    for (const double x : w) { s.mittel += x; }
    const double n = static_cast<double>(w.size());
    s.mittel /= n;
    s.saber /= n;
    s.saberFx /= n;
    s.spuren /= n;
    s.effekte /= n;
    s.szene /= n;
    s.ansicht /= n;
    std::sort(w.begin(), w.end());
    s.median = w[w.size() / 2];
    s.p95 = w[std::min(w.size() - 1, w.size() * 95 / 100)];
    s.max = w.back();
    return s;
}
std::string text(const Stat& s) {
    char z[400];
    std::snprintf(z, sizeof(z),
                  "%d Bilder, Mittel %.1f ms, Median %.1f, 95 %% %.1f, max %.1f | je Bild: Schwerttakte %.2f, "
                  "Funken/Klirren %.2f, Brandspuren %.2f, Effektnetz %.2f, Figuren %.2f, Ansicht gesamt %.2f",
                  s.n, s.mittel, s.median, s.p95, s.max, s.saber, s.saberFx, s.spuren, s.effekte, s.szene, s.ansicht);
    return z;
}

// Die Gesamtsummen (vor, zurueck) der Laeufe ohne Obergrenze, je Reiter.
std::map<std::string, std::pair<std::string, std::string>>& summen() {
    static std::map<std::string, std::pair<std::string, std::string>> m;
    return m;
}

// obergrenze > 0: der Schwertspeicher haelt nur so viele Clientbilder
// (saberObergrenze) - dann fehlen zurueck Bilder, die Rechnung setzt an
// Schnappschuessen auf und rettet den laufenden Stand. Geprueft wird dann nur,
// dass jedes Bild dasselbe zeigt wie ohne Obergrenze (gleiche Gesamtsummen).
void probe(std::vector<Schritt>& s, const std::string& reiter, std::size_t obergrenze = 0, int versuch = 0) {
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    const std::string name = reiter + (obergrenze > 0 ? " (Obergrenze " + std::to_string(obergrenze) + " Clientbilder)" : "");
    auto L = std::make_shared<Lauf>();
    const char* sw = std::getenv("BHED_SPUL_SCHRITT");
    const double schritt = sw != nullptr ? std::max(10.0, std::atof(sw)) : 100.0;
    add(tu("Spulen: Reiter " + name, [=] {
        *L = Lauf{};
        for (int i = 0; i < static_cast<int>(g_app->tabs.size()); ++i) {
            const auto& tab = g_app->tabs[static_cast<std::size_t>(i)];
            if ((tab.path + "|" + tab.shownName).find(reiter) != std::string::npos) {
                g_app->tabRequest = i;
                L->gefunden = true;
                break;
            }
        }
        L->leftMode = g_app->leftMode;
        L->showTracks = g_app->showTracks;
        L->timelineFrac = g_app->timelineFrac;
        L->timelineZoom = g_app->timelineZoom;
        L->timelineStart = g_app->timelineViewStartMs;
        L->throughCamera = g_app->throughCamera;
    }));
    add(pause(1.0));
    add(tu("Spulen: Szene neu, Zeitleiste zeigen, Zeiger auf 0", [=] {
        prepareScene();
        g_app->leftMode = 1;
        g_app->showTracks = true;
        g_app->timelineFrac = std::max(g_app->timelineFrac, 0.30F);
        g_app->timelineZoom = 1.0;
        g_app->timelineViewStartMs = 0.0;
        g_app->throughCamera = true;
        g_app->playing = false;
        g_app->playMs = 0.0;
        g_app->bildSummeAn = true;
        g_app->mapDirty = true;
        saberObergrenze(obergrenze);
    }));
    add(warteBis("Spulen: Szene aufgebaut", [] { return g_app->camTrackValid; }, 900));
    add(pause(1.0));
    add({"Spulen: " + name + " mit der Maus auf dem Lineal vor und zurueck", [=](int b) {
             ImGuiIO& io = ImGui::GetIO();
             if (!L->gefunden) { return true; }
             if (b == 0) {
                 const double dauer = std::min(120000.0, std::max(g_app->camTrack.durationMs,
                                                                std::min(g_app->timeline.practicalEndMs, 600000.0)));
                 const auto xVon = [](double ms) {
                     return g_app->tlFeldX +
                            static_cast<float>((ms - g_app->tlSichtStart) / std::max(1.0, g_app->tlSichtSpanne)) * g_app->tlFeldW;
                 };
                 // Ganze Punkte wie eine echte Maus; je Bild mindestens einer.
                 float alt = -1.0e9F;
                 for (double ms = 0.0; ms <= dauer + 0.5; ms += schritt) {
                     const float x = std::round(xVon(ms));
                     if (x > alt) {
                         L->xs.push_back(x);
                         alt = x;
                     }
                 }
                 L->n = L->xs.size();
                 L->dauer = dauer;
                 L->y = g_app->tlLinealY;
                 L->lineal = {g_app->tlFeldX, g_app->tlFeldW, static_cast<float>(g_app->tlSichtSpanne), g_app->tlLinealY};
                 diag::detail("Knopftest: Spulen " + name + " - Dauer " + std::to_string(static_cast<int>(dauer)) + " ms, " +
                              std::to_string(L->n) + " Stellen je Richtung, Lineal x " +
                              std::to_string(L->xs.empty() ? 0.0F : L->xs.front()) + " .. " +
                              std::to_string(L->xs.empty() ? 0.0F : L->xs.back()) + ", y " + std::to_string(L->y) +
                              ", Spanne " + std::to_string(g_app->tlSichtSpanne));
                 if (L->n < 2) { return true; }
                 setzeMaus(ImVec2{L->xs.front(), L->y});
                 return false;
             }
             if (b == 1) { return false; }
             if (b == 2) {
                 io.AddMouseButtonEvent(0, true);
                 L->seit = std::chrono::steady_clock::now();
                 return false;
             }
             // Das Bild seit dem letzten Aufruf.
             const auto jetzt = std::chrono::steady_clock::now();
             const std::array<float, 4> lineal = {g_app->tlFeldX, g_app->tlFeldW, static_cast<float>(g_app->tlSichtSpanne),
                                                  g_app->tlLinealY};
             L->linealGeaendert = L->linealGeaendert || lineal != L->lineal;
             if (b >= 4) {
                 Bild x;
                 x.richtung = L->richtung;
                 x.wand = std::chrono::duration<double, std::milli>(jetzt - L->seit).count();
                 x.ms = g_app->playMs;
                 const App::FrameCost& k = g_app->frameCost;
                 if (g_app->bildSummeBild != L->letztesKostenBild) {
                     L->letztesKostenBild = g_app->bildSummeBild;
                     x.saber = k.rawSaber;
                     x.saberFx = k.rawSaberFx;
                     x.spuren = k.rawSpuren;
                     x.effekte = k.rawEffects;
                     x.szene = k.rawScene;
                     x.ansicht = k.rawTotal;
                 }
                 L->bilder.push_back(x);
             }
             // Die Pruefsumme des zuletzt gezeichneten Bildes, nach seiner Zeit.
             if (g_app->bildSummeBild != L->letztesSummenBild && g_app->bildSummeBild >= 0) {
                 L->letztesSummenBild = g_app->bildSummeBild;
                 const double ms = g_app->bildSummeMs;
                 // Durchsicht: Teil 4 ist der Klirrblitz (leer = FNV-Anfang).
                 L->blitzBilder[static_cast<std::size_t>(L->richtung)] +=
                     g_app->bildSumme[4] != 1469598103934665603ULL ? 1 : 0;
                 if (L->richtung == 0) {
                     L->vor[ms] = g_app->bildSumme;
                 } else {
                     L->zurueck[ms] = g_app->bildSumme;
                     const auto v = L->vor.find(ms);
                     if (v != L->vor.end()) {
                         ++L->verglichen;
                         if (v->second != g_app->bildSumme) {
                             std::string teile;
                             for (std::size_t t = 0; t < 5; ++t) {
                                 if (v->second[t] != g_app->bildSumme[t]) {
                                     ++L->abweichendTeil[t];
                                     teile += " " + std::to_string(t);
                                 }
                             }
                             if (L->abweichend < 8) {
                                 L->abweichungen += " [" + std::to_string(static_cast<int>(ms)) + " ms: Teil" + teile + "]";
                             }
                             ++L->abweichend;
                         }
                     }
                 }
             }
             L->seit = std::chrono::steady_clock::now();
             const std::size_t k = static_cast<std::size_t>(b - 3);
             if (k < L->n) {
                 L->richtung = 0;
                 setzeMaus(ImVec2{L->xs[k], L->y});
                 return false;
             }
             if (k < 2 * L->n - 1) {
                 L->richtung = 1;
                 setzeMaus(ImVec2{L->xs[2 * L->n - 2 - k], L->y});
                 return false;
             }
             if (k < 2 * L->n + 2) { return false; }   // das letzte Bild noch zeichnen lassen
             if (k == 2 * L->n + 2) {
                 io.AddMouseButtonEvent(0, false);
                 return false;
             }
             return k >= 2 * L->n + 5;
         }});
    add(tu("Spulen: " + name + " - Lineal beim Ziehen unveraendert?", [=] {
        if (!L->linealGeaendert) { return; }
        diag::detail("Knopftest: Spulen " + name + " - das Lineal hat sich beim Ziehen geaendert (Fenster von aussen umgestellt)" +
                     (versuch == 0 ? std::string(" - die Probe wird einmal wiederholt") : std::string()));
        if (versuch == 0) {
            L->wiederholt = true;
            std::vector<Schritt> neu;
            probe(neu, reiter, obergrenze, 1);
            schritteEinfuegen(std::move(neu));
        }
    }));
    add(pruefe("Spulen: " + name + " - zurueck so fluessig wie vor (Mittel und 95 %)", [=] {
        if (!L->gefunden) {
            diag::detail("Knopftest: Spulen - Reiter " + reiter + " fehlt");
            return false;
        }
        const Stat v = statistik(L->bilder, 0);
        const Stat z = statistik(L->bilder, 1);
        diag::detail("Knopftest: Spulen " + name + " vor:     " + text(v));
        diag::detail("Knopftest: Spulen " + name + " zurueck: " + text(z));
        // Die langsamsten Bilder zurueck, mit Zeit und Teilen.
        std::vector<Bild> lang;
        for (const Bild& b : L->bilder) {
            if (b.richtung == 1) { lang.push_back(b); }
        }
        std::sort(lang.begin(), lang.end(), [](const Bild& a, const Bild& b) { return a.wand > b.wand; });
        for (std::size_t i = 0; i < std::min<std::size_t>(lang.size(), 5); ++i) {
            char zl[300];
            std::snprintf(zl, sizeof(zl),
                          "Knopftest: Spulen %s langsam zurueck bei %.0f ms: %.1f ms (Schwerttakte %.1f, Funken %.1f, "
                          "Brandspuren %.1f, Effektnetz %.1f, Figuren %.1f, Ansicht %.1f)",
                          name.c_str(), lang[i].ms, lang[i].wand, static_cast<double>(lang[i].saber),
                          static_cast<double>(lang[i].saberFx), static_cast<double>(lang[i].spuren),
                          static_cast<double>(lang[i].effekte), static_cast<double>(lang[i].szene),
                          static_cast<double>(lang[i].ansicht));
            diag::detail(zl);
        }
        if (L->wiederholt) { return true; }   // die Wiederholung prueft
        // Mit Obergrenze rechnet das Zurueckspulen absichtlich nach - nur die Zahlen.
        return v.n > 20 && z.n > 20 && (obergrenze > 0 || (z.mittel <= v.mittel * 1.25 + 2.0 && z.p95 <= v.p95 * 1.5 + 5.0));
    }));
    add(pruefe("Spulen: " + name + " - zurueck zeigt zu jeder Zeit Bit fuer Bit dasselbe wie vor" +
                   (obergrenze > 0 ? std::string(" und wie ohne Obergrenze") : std::string()), [=] {
        // Eine Summe ueber alle Bilder je Richtung - zum Vergleich zweier
        // Fassungen (vorher/nachher gleich = die Beschleunigung aendert nichts).
        // Durchsicht: die Teile 0-3 wie bisher (vergleichbar mit den
        // Summen in NOTIZEN_fix603.md), der Klirrblitz (Teil 4) daneben.
        const auto gesamt = [](const std::map<double, std::array<std::uint64_t, 5>>& m, std::size_t von,
                               std::size_t bis) {
            std::uint64_t h = 1469598103934665603ULL;
            const auto dazu = [&h](std::uint64_t x) {
                for (int i = 0; i < 8; ++i) { h = (h ^ ((x >> (8 * i)) & 0xFFU)) * 1099511628211ULL; }
            };
            for (const auto& [ms, teile] : m) {
                std::uint64_t b = 0;
                std::memcpy(&b, &ms, sizeof(b));
                dazu(b);
                for (std::size_t t = von; t < bis; ++t) { dazu(teile[t]); }
            }
            char z[40];
            std::snprintf(z, sizeof(z), "%016llx", static_cast<unsigned long long>(h));
            return std::string(z);
        };
        const std::string gv = gesamt(L->vor, 0, 4) + " Blitz " + gesamt(L->vor, 4, 5);
        const std::string gz = gesamt(L->zurueck, 0, 4) + " Blitz " + gesamt(L->zurueck, 4, 5);
        diag::detail("Knopftest: Spulen " + name + " - Gesamtsumme vor " + gv + " (" + std::to_string(L->vor.size()) +
                     " Zeiten), zurueck " + gz + " (" + std::to_string(L->zurueck.size()) + " Zeiten)");
        if (L->wiederholt) { return true; }   // die Wiederholung prueft
        bool wieOhne = true;
        if (obergrenze == 0) {
            summen()[reiter] = {gv, gz};
        } else {
            const auto o = summen().find(reiter);
            wieOhne = o != summen().end() && o->second.first == gv && o->second.second == gz;
            diag::detail("Knopftest: Spulen " + name + " - ohne Obergrenze: " +
                         (o != summen().end() ? "vor " + o->second.first + ", zurueck " + o->second.second
                                              : std::string("kein Lauf")) +
                         (wieOhne ? " - gleich" : " - VERSCHIEDEN"));
        }
        diag::detail("Knopftest: Spulen " + name + " - Pruefsummen: " + std::to_string(L->vor.size()) + " vor, " +
                     std::to_string(L->verglichen) + " zurueck verglichen, " + std::to_string(L->abweichend) +
                     " verschieden (Effektnetz " + std::to_string(L->abweichendTeil[0]) + ", Klingen " +
                     std::to_string(L->abweichendTeil[1]) + ", Figuren " + std::to_string(L->abweichendTeil[2]) +
                     ", bewegte Modelle " + std::to_string(L->abweichendTeil[3]) + ", Klirrblitz " +
                     std::to_string(L->abweichendTeil[4]) + "; Bilder mit Klirrblitz vor " +
                     std::to_string(L->blitzBilder[0]) + ", zurueck " + std::to_string(L->blitzBilder[1]) + ")" +
                     L->abweichungen);
        return L->gefunden && L->verglichen > static_cast<int>(L->n) / 2 && L->abweichend == 0 && wieOhne;
    }));
    // Leistung, ohne Oberflaeche: die Schwerttakte der ganzen Szene am Stueck
    // wie beim Abspielen (je 16 ms ein saberRechneBis), bester von 3 Laeufen.
    if (obergrenze == 0) {
        add(tu("Spulen: " + name + " - Schwerttakte am Stueck (Leistung)", [=] {
            double best = 1.0e30;
            for (int r = 0; r < 3; ++r) {
                saberVergessen();
                const auto t0 = std::chrono::steady_clock::now();
                for (double ms = 0.0; ms <= L->dauer; ms += 16.0) { saberRechneBis(ms); }
                best = std::min(best, std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count());
            }
            saberVergessen();
            char z[200];
            std::snprintf(z, sizeof(z), "Knopftest: Spulen %s - Schwerttakte vorwaerts am Stueck bis %.0f ms: %.1f ms (bester von 3)",
                          name.c_str(), L->dauer, best);
            diag::detail(z);
        }));
    }
    add(tu("Spulen: Oberflaeche zurueck", [=] {
        saberObergrenze(0);
        g_app->bildSummeAn = false;
        g_app->playing = false;
        g_app->playMs = 0.0;
        g_app->leftMode = L->leftMode;
        g_app->showTracks = L->showTracks;
        g_app->timelineFrac = L->timelineFrac;
        g_app->timelineZoom = L->timelineZoom;
        g_app->timelineViewStartMs = L->timelineStart;
        g_app->throughCamera = L->throughCamera;
        g_app->mapDirty = true;
    }));
    add(pause(0.3));
}

// Beim Abspielen klingt jedes Klirren (saberTonEreignisse). Das Serverbild s
// (Zeit s*50) laeuft im Clientbild, in dessen ((t-1)*8, t*8] es faellt
// (clientSchritt). Endet ein Abspielfenster zwischen s*50 und diesem
// Clientbild, war das Klirren beim Abspielen noch nicht gerechnet: bis rc602
// fiel es aus diesem Fenster und lag im naechsten schon davor - es blieb stumm
// (die Luecke ist 2, 4 oder 6 ms lang, wenn s kein Vielfaches von 4 ist - bei
// 60 Bildern je Sekunde im Mittel etwa jedes sechste Klirren). Geprueft mit
// denselben Fenstern wie die Abspielschleife (von = voriges bis), einmal mit
// Fensterenden auf den Clientbildern, einmal 1 ms hinter jedem Klirren: beide
// Male klingen gleich viele Klirrklaenge, und mindestens so viele, wie es
// Klirren mit Klang gibt.
void klirrTon(std::vector<Schritt>& s, const std::string& reiter) {
    s.push_back(pruefe("Spulen: " + reiter + " - jedes Klirren klingt beim Abspielen, auch wenn ein Bild knapp dahinter endet", [=] {
        const double dauer = std::max(g_app->camTrack.durationMs, std::min(g_app->timeline.practicalEndMs, 600000.0));
        saberVergessen();
        saberRechneBis(dauer);
        const std::vector<SaberKlirren> alle = saberKlirrenBis(dauer);
        std::set<std::string> namen;
        int erwartet = 0;   // Klirren mit Klang (leer: G_Sound mit Index 0, still)
        for (const SaberKlirren& k : alle) {
            if (!k.klang.empty()) {
                namen.insert(k.klang);
                ++erwartet;
            }
        }
        const auto abspielen = [&](bool aufClientbild) {
            saberVergessen();
            std::vector<double> enden;
            for (double t = 16.0; t <= dauer + 16.0; t += 16.0) { enden.push_back(t); }
            for (const SaberKlirren& k : alle) {
                enden.push_back(aufClientbild ? std::ceil(k.ms / kSaberClientTaktMs) * kSaberClientTaktMs : k.ms + 1.0);
            }
            std::sort(enden.begin(), enden.end());
            enden.erase(std::unique(enden.begin(), enden.end()), enden.end());
            klangMitschrift().clear();
            klangMitschriftAn(true);
            double von = -1.0;
            for (const double bis : enden) {
                g_app->audioUpTo = von;
                g_app->playMs = bis;
                saberTonEreignisse(von, bis);
                von = bis;
            }
            int zahl = 0;
            for (const KlangMitschrift& m : klangMitschrift()) {
                zahl += (m.art == 'E' && namen.count(m.datei) != 0U) ? 1 : 0;
            }
            klangMitschriftAn(false);
            klangMitschrift().clear();
            g_app->audio.stopAll();
            g_app->laufendeSchleifen.clear();
            tonZuruecksetzen();
            return zahl;
        };
        const int gerade = abspielen(true);
        const int knapp = abspielen(false);
        int nichtAufClientbild = 0;
        for (const SaberKlirren& k : alle) {
            nichtAufClientbild += std::fmod(k.ms, static_cast<double>(kSaberClientTaktMs)) != 0.0 ? 1 : 0;
        }
        saberVergessen();
        g_app->playMs = 0.0;
        g_app->audioUpTo = -1.0;
        g_app->mapDirty = true;
        diag::detail("Knopftest: Spulen " + reiter + " - " + std::to_string(alle.size()) + " Klirren, " +
                     std::to_string(erwartet) + " mit Klang (" +
                     std::to_string(nichtAufClientbild) + " nicht auf einem Clientbild), Klirrklaenge mit Fensterenden auf "
                     "Clientbildern " + std::to_string(gerade) + ", 1 ms hinter jedem Klirren " + std::to_string(knapp));
        return erwartet > 0 && gerade == knapp && gerade >= erwartet;
    }));
}

