// =====================================================================
// Paket bewegung (rc601): Schwerkraft im laufenden Programm
// =====================================================================
//
// Gemeldet: "NPCs aren't affected by gravity." tests/bewegungtest.cpp prueft
// die Rechnung (schwerkraftEinrechnen) gegen erfundene Boeden. Hier der Weg
// der Oberflaeche: prepareScene muss die Schwerkraft an der fertigen Szene
// einrechnen, gegen den Boden der ECHTEN Karte (app_bewegung.cpp). Bis rc600
// stand eine 120 Einheiten zu hoch gesetzte Figur die ganze Szene in der
// Luft.
//
// Braucht eine geladene Karte (BHED_EDITORTEST=missionsbau legt eine an);
// ohne Karte wird es nur vermerkt. Die Figuren sind erfunden und werden
// danach mit Skript und Entities zurueckgestellt.
namespace swk {
struct Stand {
    bool geladen = false;
    bool karte = false;
    std::shared_ptr<Document> doc;
    std::vector<MapEntity> entities;
    float basis[3]{};
    float boden = 0.0F;
};

const char* const kSkript =
    "//Generated by BehavEd\r\n"
    "affect ( \"swk_held\", /*@AFFECT_TYPE*/ FLUSH )\r\n{\r\n"
    "\twait ( 3000.000 );\r\n"
    "}\r\n"
    "wait ( 500.000 );\r\n"
    "use ( \"swk_spawn\" );\r\n"
    "wait ( 100.000 );\r\n"
    "affect ( \"swk_neu\", /*@AFFECT_TYPE*/ FLUSH )\r\n{\r\n"
    "\twait ( 3000.000 );\r\n"
    "}\r\n";

const Actor* figur(const std::string& name) {
    for (const Actor& a : g_app->scene.actors) {
        if (a.name == name) { return &a; }
    }
    return nullptr;
}

// Die Fuesse (Ursprung - 24, DEFAULT_MINS_2) ueber dem Boden der Probe.
float fuesse(const Actor& a, double ms, const Stand& st) {
    return a.at(ms).pos[2] - kFussTiefe - st.boden;
}
}  // namespace swk

std::vector<Schritt> schwerkraftSchritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto st = std::make_shared<swk::Stand>();
    add(tu("Schwerkraft: zwei Figuren 120 ueber dem Boden der Karte (spawnflags 0), Szene bauen", [=] {
        st->karte = !g_app->geo.empty();
        if (!st->karte) {
            diag::detail("Knopftest: Schwerkraft - keine Karte geladen, uebersprungen");
            return;
        }
        // Ein Platz auf dem Boden: die gewaehlte Entity (im Missionsbau die
        // eben gesetzte Figur), sonst info_player_start.
        bool da = false;
        if (g_app->pickedEntity >= 0 && static_cast<std::size_t>(g_app->pickedEntity) < g_app->map.entities.size()) {
            da = entityOrt(g_app->map.entities[static_cast<std::size_t>(g_app->pickedEntity)], st->basis);
        }
        for (const MapEntity& e : g_app->map.entities) {
            if (!da && e.classname == "info_player_start") { da = entityOrt(e, st->basis); }
        }
        const float von[3] = {st->basis[0], st->basis[1], st->basis[2] + 8.0F};
        const float bis[3] = {st->basis[0], st->basis[1], st->basis[2] - 8192.0F};
        float t[3];
        if (!da || !bodenTreffer(g_app->geo, von, bis, t)) {
            st->karte = false;
            diag::detail("Knopftest: Schwerkraft - kein Boden gefunden, uebersprungen");
            return;
        }
        st->boden = t[2];
        st->doc = std::make_shared<Document>(g_app->doc);
        st->entities = g_app->map.entities;
        st->geladen = true;
        // spawnflags 0: 16 waere bei einem Jedi JSF_AMBUSH (haengt an der
        // Decke), 128 SFB_STARTINSOLID.
        char text[1024];
        const float z = st->boden + kFussTiefe + 120.0F;
        std::snprintf(text, sizeof(text),
                      "{\n\"classname\" \"NPC_spawner\"\n\"NPC_targetname\" \"swk_held\"\n\"NPC_type\" \"swk_probe\"\n"
                      "\"spawnflags\" \"0\"\n\"origin\" \"%.0f %.0f %.0f\"\n}\n"
                      "{\n\"classname\" \"NPC_spawner\"\n\"targetname\" \"swk_spawn\"\n\"NPC_targetname\" \"swk_neu\"\n"
                      "\"NPC_type\" \"swk_probe\"\n\"spawnflags\" \"0\"\n\"origin\" \"%.0f %.0f %.0f\"\n}\n",
                      static_cast<double>(st->basis[0]), static_cast<double>(st->basis[1]), static_cast<double>(z),
                      static_cast<double>(st->basis[0]), static_cast<double>(st->basis[1]), static_cast<double>(z));
        std::vector<MapEntity> dazu;
        parseEntities(text, dazu);
        for (MapEntity& e : dazu) { g_app->map.entities.push_back(std::move(e)); }
        Script sc;
        std::vector<Diag> d;
        (void)readScript(swk::kSkript, sc, d);
        g_app->doc = Document{sc};
        NpcDef def;
        def.playerModel = "kyle";
        def.walkSpeed = 55.0F;
        def.runSpeed = 200.0F;
        g_app->npcMap["swk_probe"] = def;
        rebuildTree();
        prepareScene();
        g_app->npcMap["swk_probe"] = def;   // falls das erste Lesen sie ueberschrieb
        prepareScene();
        g_app->mapDirty = true;
    }));
    add(pause(0.2));
    // rc601 (bewegung, Kartenstart): beim Laden der Karte gespawnt heisst
    // nicht mehr "laengst gelandet" - NPC_Begin liegt 200 ms vor dem
    // Skriptanfang (schwerkraft.cpp, backen): 120 ueber dem Boden sind die
    // Fuesse bei 0 ms noch 39 hoch (144 -> 128 -> 80 -> 63), nach 1 s unten.
    add(pruefe("Schwerkraft: die schwebend gesetzte Figur faellt beim Skriptanfang noch und steht nach 1 s auf dem Boden", [=] {
        if (!st->karte) { return true; }
        const swk::Stand& w = *st;
        const Actor* a = swk::figur("swk_held");
        if (a == nullptr) {
            diag::detail("Knopftest: Schwerkraft - Figur swk_held fehlt in der Szene");
            return false;
        }
        const float f0 = swk::fuesse(*a, 0.0, w);
        const float f1 = swk::fuesse(*a, 1000.0, w);
        diag::detail("Knopftest: Schwerkraft - Boden " + std::to_string(w.boden) + ", Spawner 120 darueber, Fuesse bei 0 ms " +
                     std::to_string(f0) + " (soll 39), bei 1000 ms " + std::to_string(f1) + " (soll 0), Hoehen " +
                     std::to_string(a->hoehe.size()));
        return std::fabs(f0 - 39.0F) <= 1.5F && std::fabs(f1) <= 1.5F;
    }));
    add(pruefe("Schwerkraft: die per use gespawnte Figur faellt vom Spawner und landet", [=] {
        if (!st->karte) { return true; }
        const swk::Stand& w = *st;
        const Actor* a = swk::figur("swk_neu");
        if (a == nullptr) {
            diag::detail("Knopftest: Schwerkraft - Figur swk_neu fehlt in der Szene");
            return false;
        }
        // Am Spawner (G_CheckInSolid trifft 120 darueber nichts), dann der
        // Fall: 120 Einheiten mit g = 800 dauern sqrt(2*120/800) = 0,55 s.
        const double t0 = a->erscheintMs;
        const float fa = swk::fuesse(*a, t0, w);
        const float fb = swk::fuesse(*a, t0 + 1000.0, w);
        diag::detail("Knopftest: Schwerkraft - swk_neu erscheint bei " + std::to_string(t0) + " ms, Fuesse dort " +
                     std::to_string(fa) + ", 1 s spaeter " + std::to_string(fb));
        return t0 >= 500.0 && fa >= 100.0F && std::fabs(fb) <= 1.5F;
    }));
    add(tu("Schwerkraft: Skript und Entities zurueck", [=] {
        if (!st->geladen) { return; }
        g_app->doc = *st->doc;
        g_app->map.entities = st->entities;
        g_app->npcMap.erase("swk_probe");
        st->geladen = false;
        rebuildTree();
        prepareScene();
        g_app->mapDirty = true;
    }));
    add(pause(0.2));
    return s;
}

// --- JEDE Zwischensequenz durchspielen (BHED_EDITORTEST=szenen) -------------
//
// shank: "dann jede Cutscene hier einmal durchladen zum Testen ...
// durchlaufen lassen, dass wirklich alles geht". BHED_SZENEN nennt eine
// Liste, je Zeile "maps/karte.bsp<TAB>ordner/skript". Die Karte wird nur bei
// einem Wechsel neu geladen, das Skript wie aus einer Mission geoeffnet
// (openScriptFromMemory mit seinem ICARUS-Pfad - so findet der Nachbau den
// Traeger und die Unterskripte). Dann laeuft die Szene im Zeitraffer durch
// die Szenenkamera: je BHED_SCHRITT ms (Vorgabe 500) ein Bild, mit
// playing=true, damit auch jeder Klang ausgeloest wird (stumm, wie im
// ganzen Selbsttest). Ins Protokoll kommt je Szene eine Zeile
// "Szenenlauf: ..." - Traeger, Dauer, Figuren ohne Modell, fehlende
// Klaenge, Bildzeiten, D3D-Meldungen, Hinweise des Nachbaus.
// --- Paket bewegung (rc601, Durchsicht 2) -----------------------------------
//
// Die Schwierigkeit (Einstellungen, g_spskill) im Programm: umschalten baut
// die Szene neu, und ein Reborn dreht danach so schnell, wie NPC_Begin es
// fuer diese Stufe sagt (NPC_spawn.cpp:1866-1877 MD) - yawSpeed 100: Jedi
// 435, Jedi Knight 510, Jedi Master 360 Grad/s.
std::vector<Schritt> bewegungReview2Schritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto m = std::make_shared<bwg::Merk>();
    auto vorher = std::make_shared<int>(2);
    add(tu("Bewegung Schwierigkeit: stehende Figur als Reborn (yawSpeed 100)", [=] {
        *vorher = g_app->settings.schwierigkeit;
        bwg::laden(m, bwg::kSkriptStehen);
        g_app->npcMap["bwg_probe"].klasse = "CLASS_REBORN";
        g_app->npcMap["bwg_probe"].yawSpeed = 100.0F;
        prepareScene();
    }));
    auto bauten = std::make_shared<int>(0);
    const auto stufe = [&](int n, float soll, const char* name) {
        add(tu(std::string("Bewegung Schwierigkeit: Schwierigkeit ") + name, [n, bauten] {
            *bauten = g_app->szeneBauten;
            schwierigkeitWaehlen(n);
        }));
        add(pruefe(std::string("Bewegung Schwierigkeit: ") + name + " baut die Szene neu, Reborn dreht mit " + std::to_string(static_cast<int>(soll)),
                   [soll, bauten] {
                       // Neu gebaut: schon von der Hauptschleife (Zeitleiste) oder
                       // zumindest angefordert (camTrackValid weg).
                       const bool neu = g_app->szeneBauten > *bauten || !g_app->camTrackValid;
                       prepareScene();
                       const Actor* a = bwg::figur("bwg_held");
                       const float r = a != nullptr ? a->startDrehrate : -1.0F;
                       diag::detail("Knopftest: Bewegung Schwierigkeit - Szene neu " + std::string(neu ? "ja" : "nein") + ", Drehrate " +
                                    std::to_string(r) + ", Einstellung " + std::to_string(g_app->settings.schwierigkeit));
                       return neu && std::fabs(r - soll) < 0.01F;
                   }));
    };
    stufe(1, 435.0F, "Jedi (1)");
    stufe(3, 360.0F, "Jedi Master (3)");
    stufe(2, 510.0F, "Jedi Knight (2)");
    add(tu("Bewegung Schwierigkeit: Schwierigkeit und Karte zurueck", [=] {
        g_app->settings.schwierigkeit = *vorher;
        bwg::zurueck(m);
    }));
    return s;
}

// --- rc601 bewegung, teil 3: Tueren und Mover zur Zeit fuer die Wege ---------
//
// Auftrag: "Doors and movers at their state at that time". Auf der echten
// Karte des Modus karte: eine Tuer per use oeffnen; danach muss die Welt der
// Wege (navWeltVorschau) die Tuer vor dem use zu sehen (Spur durch ihre Mitte
// trifft sie) und offen, sobald die Mover-Simulation sie oben hat - und
// is_valid den moverState daraus lesen. Bis teil 3 stand jede Tuer fuer die
// Wege immer am Spawn-Platz.
std::vector<Schritt> bewegungTeil3Schritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto tuer = std::make_shared<int>(-1);
    add(tu("Wege teil 3: eine Tuer der Karte per use oeffnen", [=] {
        *tuer = -1;
        if (g_app->geo.empty()) { return; }
        std::string name;
        const std::shared_ptr<const NavWelt> basis = navWeltVorschau();
        for (std::size_t i = 0; i < g_app->map.entities.size() && basis && basis->spur; ++i) {
            const MapEntity& e = g_app->map.entities[i];
            const std::string* mdl = e.find("model");
            const std::string* sf = e.find("spawnflags");
            const int flags = sf != nullptr ? std::atoi(sf->c_str()) : 0;
            if (e.classname != "func_door" || e.targetname.empty() || mdl == nullptr || mdl->size() < 2 || (*mdl)[0] != '*' ||
                (flags & (1 | 16)) != 0) {
                continue;
            }
            // Fluegel im selben Team: der getroffene darf ein anderer sein.
            if (e.find("team") != nullptr) {
                diag::detail("Knopftest: Wege teil 3 - Kandidat \"" + e.targetname + "\" im Team \"" + *e.find("team") + "\"");
            }
            // Nur eine Tuer, die eine NPC-Spur durch ihre Mitte auch aufhaelt
            // (manche "Tueren" sind nur CONTENTS_OPAQUE, Kraftfelder o. ae.).
            const int nr = std::atoi(mdl->c_str() + 1);
            if (nr <= 0 || static_cast<std::size_t>(nr) >= g_app->geo.models.size()) { continue; }
            const auto& m = g_app->geo.models[static_cast<std::size_t>(nr)];
            int achse = 0;
            for (int a = 1; a < 3; ++a) {
                if (m.maxs[a] - m.mins[a] < m.maxs[achse] - m.mins[achse]) { achse = a; }
            }
            NavVec von{};
            for (int a = 0; a < 3; ++a) { von[static_cast<std::size_t>(a)] = 0.5F * (m.mins[a] + m.maxs[a]); }
            NavVec bis = von;
            von[static_cast<std::size_t>(achse)] -= 64.0F;
            bis[static_cast<std::size_t>(achse)] += 64.0F;
            const NavVec null{0.0F, 0.0F, 0.0F};
            const int getroffen = basis->spur(von, null, null, bis, kNavKeineEntity, kNavMaskNpcSolid).entity;
            const std::string* team = e.find("team");
            const bool imTeam = getroffen >= 0 && team != nullptr &&
                                g_app->map.entities[static_cast<std::size_t>(getroffen)].find("team") != nullptr &&
                                *g_app->map.entities[static_cast<std::size_t>(getroffen)].find("team") == *team;
            if (getroffen != static_cast<int>(i) && !imTeam) { continue; }
            *tuer = static_cast<int>(i);
            name = e.targetname;
            break;
        }
        diag::detail("Knopftest: Wege teil 3 - Tuer \"" + name + "\" (Entity " + std::to_string(*tuer) + ")");
        if (*tuer < 0) { return; }
        openScriptFromMemory("//Generated by BehavEd\nwait ( 1000.000 );\nuse ( \"" + name + "\" );\nwait ( 6000.000 );\n",
                             "tuer_wege.txt");
        prepareScene();
        g_app->playing = false;
        g_app->mapDirty = true;
    }));
    add(pause(0.3));
    add(pruefe("Wege teil 3: die Wege sehen die Tuer zur Zeit (zu vor dem use, offen danach, moverState fuer is_valid)", [=] {
        if (*tuer < 0) {
            diag::detail("Knopftest: Wege teil 3 - keine passende Tuer auf dieser Karte, ohne Aussage");
            return g_app->geo.empty();
        }
        const std::shared_ptr<const NavWelt> w = navWeltVorschau();
        if (!w || !w->mover || !w->spurZeit) {
            diag::detail("Knopftest: Wege teil 3 - kein Mover-Plan in der Welt der Wege");
            return false;
        }
        const NavMoverPlan::Stand* vor = w->mover->standVon(*tuer, 500.0);
        const NavMoverPlan::Stand* los = w->mover->standVon(*tuer, 1100.0);
        double offenAb = -1.0;
        for (double t = 1000.0; t < 7000.0 && offenAb < 0.0; t += 50.0) {
            const NavMoverPlan::Stand* x = w->mover->standVon(*tuer, t);
            if (x != nullptr && x->zustand == 1) { offenAb = t; }
        }
        // Spur durch die Mitte der Tuer entlang ihrer duennsten Achse.
        const MapEntity& e = g_app->map.entities[static_cast<std::size_t>(*tuer)];
        const int nr = std::atoi(e.find("model")->c_str() + 1);
        if (nr <= 0 || static_cast<std::size_t>(nr) >= g_app->geo.models.size()) { return false; }
        const auto& m = g_app->geo.models[static_cast<std::size_t>(nr)];
        int achse = 0;
        for (int a = 1; a < 3; ++a) {
            if (m.maxs[a] - m.mins[a] < m.maxs[achse] - m.mins[achse]) { achse = a; }
        }
        NavVec mitte{};
        for (int a = 0; a < 3; ++a) { mitte[static_cast<std::size_t>(a)] = 0.5F * (m.mins[a] + m.maxs[a]); }
        NavVec von = mitte;
        NavVec bis = mitte;
        von[static_cast<std::size_t>(achse)] -= 64.0F;
        bis[static_cast<std::size_t>(achse)] += 64.0F;
        const NavVec null{0.0F, 0.0F, 0.0F};
        const NavSpur zu = w->spurZeit(von, null, null, bis, kNavKeineEntity, kNavMaskNpcSolid, 500.0);
        const NavSpur auf =
            w->spurZeit(von, null, null, bis, kNavKeineEntity, kNavMaskNpcSolid, offenAb >= 0.0 ? offenAb : 6000.0);
        {
            const NavSpur alle = w->spur(von, null, null, bis, kNavKeineEntity, 0xFFFFFFFFU);
            const std::string* o = e.find("origin");
            const std::string* an = e.find("angle");
            diag::detail("Knopftest: Wege teil 3 - Modell *" + std::to_string(nr) + " " + std::to_string(m.mins[0]) + " " +
                         std::to_string(m.mins[1]) + " " + std::to_string(m.mins[2]) + " .. " + std::to_string(m.maxs[0]) + " " +
                         std::to_string(m.maxs[1]) + " " + std::to_string(m.maxs[2]) + ", origin " + (o != nullptr ? *o : "-") +
                         ", angle " + (an != nullptr ? *an : "-") + ", Spur mit allen contents: Entity " +
                         std::to_string(alle.entity) + " fraction " + std::to_string(alle.fraction) + " contents " +
                         std::to_string(alle.contents) + " startsolid " + std::to_string(alle.startsolid ? 1 : 0));
        }
        diag::detail("Knopftest: Wege teil 3 - vor dem use Zustand " + std::to_string(vor != nullptr ? vor->zustand : 0) +
                     ", bei 1100 ms " + std::to_string(los != nullptr ? los->zustand : -1) + ", offen ab " +
                     std::to_string(static_cast<int>(offenAb)) + " ms; Spur durch die Mitte: zu trifft Entity " +
                     std::to_string(zu.entity) + ", offen Entity " + std::to_string(auf.entity));
        return (vor == nullptr || vor->zustand == 0) && los != nullptr && los->zustand == 2 && offenAb > 1000.0 &&
               zu.entity >= 0 && auf.entity != zu.entity;
    }));
    return s;
}

// --- rc601 integ: der zentrale Schalter OpenJK / Movie Duels -----------------
//
// Der Betreuer: beide Regelwerke, waehlbar; automatisch nach dem Spielordner
// (die Selbsttest-Einstellungen haben die Movie-Duels-Ordner), im Zweifel
// OpenJK. Geprueft wird, was der Schalter im laufenden Programm aendert:
//   * die Schalter der Pakete (saber, bewegung), cg_fovAspectAdjust und das
//     Spielfenster (OpenJK r_mode 4 = 4:3),
//   * die Szene wird neu gebaut, und ein Reborn mit yawSpeed 100 dreht wie
//     NPC_Begin es fuer g_spskill sagt - nie gewaehlt: OpenJK 0 (360 Grad/s),
//     Movie Duels 2 (510); eine ausdrueckliche Wahl bleibt. CLASS_GUARD kennt
//     nur Movie Duels (NPC_spawn.cpp:1828 ff. MD),
//   * eine ROFF-Notiz "sound" auf einer Figur geht unter OpenJK mit ihr
//     (G_SoundOnEnt, g_roff.cpp:305), unter Movie Duels bleibt sie am Ort des
//     Ereignisses (g_roff.cpp:265 MD).
std::vector<Schritt> regelwerkSchritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    struct Vorher {
        int regelwerk = 0;
        int schwierigkeit = -1;
        float spielSeiten = 0.0F;
        int fov = -1;
        int bauten = 0;
    };
    auto v = std::make_shared<Vorher>();
    auto m = std::make_shared<bwg::Merk>();
    add(tu("Regelwerk: Einstellungen merken, automatisch, Schwierigkeit nie gewaehlt", [=] {
        v->regelwerk = g_app->settings.regelwerk;
        v->schwierigkeit = g_app->settings.schwierigkeit;
        v->spielSeiten = g_app->settings.spielSeiten;
        v->fov = g_app->settings.fovAspectAdjust;
        g_app->settings.regelwerk = kRegelwerkAuto;
        g_app->settings.schwierigkeit = -1;
        g_app->settings.spielSeiten = 0.0F;
        g_app->settings.fovAspectAdjust = -1;
    }));
    add(pause(0.2));
    add(pruefe("Regelwerk: automatisch mit Movie-Duels-Ordner = Movie Duels (saber, bewegung, cg_fovAspectAdjust 1)", [] {
        diag::detail(std::string("Knopftest: Regelwerk - saber ") + (saberMovieDuelsRegeln() ? "MD" : "OpenJK") + ", nav " +
                     (navMovieDuelsRegeln() ? "MD" : "OpenJK") + ", fovAspectAdjust " + (spielFovAspectAdjust() ? "1" : "0"));
        return saberMovieDuelsRegeln() && navMovieDuelsRegeln() && spielFovAspectAdjust();
    }));
    add(tu("Regelwerk: OpenJK waehlen", [=] {
        v->bauten = g_app->szeneBauten;
        g_app->camTrackValid = true;
        g_app->settings.regelwerk = kRegelwerkOpenJK;
    }));
    add(pause(0.2));
    add(pruefe("Regelwerk: OpenJK schaltet saber und bewegung um, cg_fovAspectAdjust 0, Spielfenster 4:3 (r_mode 4)", [] {
        const float seiten = spielFensterSeiten();
        diag::detail(std::string("Knopftest: Regelwerk - saber ") + (saberMovieDuelsRegeln() ? "MD" : "OpenJK") + ", nav " +
                     (navMovieDuelsRegeln() ? "MD" : "OpenJK") + ", fovAspectAdjust " + (spielFovAspectAdjust() ? "1" : "0") +
                     ", Seiten " + std::to_string(seiten) + ", g_spskill " + std::to_string(saberSpielstufe()));
        return !saberMovieDuelsRegeln() && !navMovieDuelsRegeln() && !spielFovAspectAdjust() &&
               std::fabs(seiten - 4.0F / 3.0F) < 1e-3F && saberSpielstufe() == 0;
    }));
    add(pruefe("Regelwerk: der Wechsel baut die Szene neu", [=] {
        return g_app->szeneBauten > v->bauten || !g_app->camTrackValid;
    }));
    // Drehrate je Regelwerk und Schwierigkeit (NPC_Begin).
    const auto drehrate = [&](const std::string& text, const char* klasse, int regel, int stufe, float soll) {
        add(tu("Regelwerk: " + text + " - einstellen", [=] {
            g_app->settings.regelwerk = regel;
            g_app->settings.schwierigkeit = stufe;
        }));
        add(pause(0.1));
        add(pruefe("Regelwerk: " + text + " dreht mit " + std::to_string(static_cast<int>(soll)) + " Grad/s", [=] {
            bwg::laden(m, bwg::kSkriptStehen);
            g_app->npcMap["bwg_probe"].klasse = klasse;
            g_app->npcMap["bwg_probe"].yawSpeed = 100.0F;
            prepareScene();
            const Actor* a = bwg::figur("bwg_held");
            const float r = a != nullptr ? a->startDrehrate : -1.0F;
            diag::detail("Knopftest: Regelwerk - " + text + ": Drehrate " + std::to_string(r) + ", Einstellung " +
                         std::to_string(g_app->settings.schwierigkeit));
            return std::fabs(r - soll) < 0.01F;
        }));
    };
    drehrate("OpenJK, Schwierigkeit nie gewaehlt (g_spskill 0), Reborn", "CLASS_REBORN", kRegelwerkOpenJK, -1, 360.0F);
    drehrate("Movie Duels, Schwierigkeit nie gewaehlt (g_spskill 2), Reborn", "CLASS_REBORN", kRegelwerkMovieDuels, -1, 510.0F);
    drehrate("OpenJK, Jedi-Ritter gewaehlt, Reborn", "CLASS_REBORN", kRegelwerkOpenJK, 2, 510.0F);
    drehrate("OpenJK, Jedi-Ritter gewaehlt, Guard (nur MD in NPC_Begin)", "CLASS_GUARD", kRegelwerkOpenJK, 2, 360.0F);
    drehrate("Movie Duels, Jedi-Ritter gewaehlt, Guard", "CLASS_GUARD", kRegelwerkMovieDuels, 2, 510.0F);
    add(tu("Regelwerk: Probeskript zurueck", [=] { bwg::zurueck(m); }));

    // ROFF-Notiz "sound" auf einer Figur: das Ereignis liegt weit weg (20000
    // Einheiten, fester Ort = unhoerbar), die Figur steht neben der Kamera.
    auto tv = std::make_shared<TonVorher>();
    const auto roffProbe = [&](int regel, bool hoerbarSoll) {
        const std::string name = regel == kRegelwerkOpenJK ? "OpenJK" : "Movie Duels";
        add(tu("Regelwerk: " + name + " fuer die ROFF-Klang-Probe", [=] { g_app->settings.regelwerk = regel; }));
        add(pause(0.1));
        add(tonSzene(tv, "regel_roff",
                     std::string(kTonKopf) +
                         "affect ( \"nah\", /*@AFFECT_TYPE*/ FLUSH )\n{\n"
                         "\tset ( /*@SET_TYPES*/ \"SET_ORIGIN\", < 100.000 0.000 100.000 > );\n}\n" +
                         kTonKamera0 + tonHalten("0.000 0.000 100.000", 2000),
                     0.0F, 0.0F, 100.0F));
        add(warteBis("Regelwerk: Szene mit der Figur \"nah\" aufgebaut",
                     [] { return g_app->camTrackValid && g_app->scene.find("nah") != nullptr; }, 600));
        add(tu("Regelwerk: ROFF-Notiz \"sound\" auf der Figur (Ereignisort weit weg)", [] {
            RoffEreignis e;
            e.ms = 300.0;
            e.figur = "nah";
            e.text = "sound sound/test/effekt.wav";
            e.befehl.art = RoffNotizBefehl::Art::Klang;
            e.befehl.datei = "sound/test/effekt.wav";
            e.ort[0] = 20000.0F;
            e.ort[1] = 0.0F;
            e.ort[2] = 100.0F;
            g_app->scene.roffEreignisse.push_back(e);
        }));
        add(tonAbspielen("ROFF-Klang " + name, 800.0));
        add(pruefe("Regelwerk: " + name + " - ROFF-Klang einer Figur " +
                       (hoerbarSoll ? "geht mit ihr (hoerbar neben der Kamera)" : "bleibt am Ereignisort (unhoerbar)"),
                   [hoerbarSoll] {
                       const KlangMitschrift* k = tonLetzter("sound/test/effekt.wav", "EP");
                       diag::detail("Knopftest: Regelwerk - ROFF-Klang:" + tonListe("sound/test/effekt.wav"));
                       return k != nullptr && tonHoerbar(*k) == hoerbarSoll;
                   }));
    };
    roffProbe(kRegelwerkOpenJK, true);
    roffProbe(kRegelwerkMovieDuels, false);
    add(tu("Regelwerk: Ton und Einstellungen zurueck", [=] {
        g_app->playing = false;
        g_app->audio.stopAll();
        g_app->laufendeSchleifen.clear();
        g_app->musicAudio.stopAll();
        tonZuruecksetzen();
        klangMitschriftAn(false);
        klangMitschrift().clear();
        for (const auto& [datei, alt] : tv->puffer) { g_app->klangPuffer[datei] = alt; }
        for (const std::string& datei : tv->pufferNeu) { g_app->klangPuffer.erase(datei); }
        for (const auto& [datei, alt] : tv->laenge) { g_app->soundLen[datei] = alt; }
        for (const std::string& datei : tv->laengeNeu) { g_app->soundLen.erase(datei); }
        if (tv->gemerkt) {
            g_app->cam = tv->cam;
            g_app->playAudio = tv->playAudio;
            g_app->followCam = tv->followCam;
            g_app->abspielTempo = tv->tempo;
            g_app->throughCamera = tv->throughCamera;
            g_app->doc.markSaved();
            while (static_cast<int>(g_app->tabs.size()) > std::max(1, tv->reiter)) {
                reiterSchliessen(static_cast<int>(g_app->tabs.size()) - 1);
            }
            if (tv->aktiv >= 0 && tv->aktiv < static_cast<int>(g_app->tabs.size())) { activateTab(tv->aktiv); }
        }
        g_app->playMs = 0.0;
        g_app->audioUpTo = -1.0;
        g_app->settings.regelwerk = v->regelwerk;
        g_app->settings.schwierigkeit = v->schwierigkeit;
        g_app->settings.spielSeiten = v->spielSeiten;
        g_app->settings.fovAspectAdjust = v->fov;
        g_app->camTrackValid = false;
    }));
    add(pause(0.3));
    return s;
}

// --- rc602: Gluehen auch auf Brush-Entities und Kartenmodellen (md_am_sith) ---
//
// Gemeldet: "sind bei unserem standard MD mission MD sith alle effecte da? es
// fuehlt sich so an als wuerde etwas fehlen". Der Gluehdurchgang nahm nur die
// Flaechen der Welt (Modell 0). Im Spiel rendert rd-vanilla JEDE Flaeche mit
// einer glow-Stufe ein zweites Mal in den Gluehpuffer (tr_backend.cpp,
// RB_DrawSurfs: g_bRenderGlowingObjects, RB_RenderDrawSurfList; in
// RB_IterateStagesGeneric zeichnet dann nur, was `glow` traegt) - auch die
// Untermodelle (func_wall, func_static, func_usable ...) und die md3-Modelle.
// In md_am_sith sind das u. a. das Palpatine-Hologramm (func_wall *70,
// textures/plasma_mustafar/palp), der Holotisch (*72, holo1/11/111), die
// Kraftfelder (*35, blueshield) und Lichtleisten (*2/*3, light_7).
// Prueft: das Hologramm in der Bildmitte wird mit Gluehen heller als ohne.
// Braucht die geladene Mission md_am_sith (karteSchritte).
std::vector<Schritt> gluehenMoverSchritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    // Mittlere Helligkeit (R+G+B) im Kasten um die Bildmitte, wo das
    // Hologramm steht (Blick wie holoSchritte "Palpatine von vorn").
    auto mitte = [] {
        std::vector<std::uint8_t> px;
        int w = 0;
        int h = 0;
        if (!gpu::leseFarbe(px, w, h) || px.empty() || w <= 0 || h <= 0) { return -1.0; }
        long long sum = 0;
        long long n = 0;
        for (int y = h * 36 / 100; y < h * 57 / 100; ++y) {
            for (int x = w * 47 / 100; x < w * 55 / 100; ++x) {
                const std::size_t i = (static_cast<std::size_t>(y) * static_cast<std::size_t>(w) + static_cast<std::size_t>(x)) * 4U;
                sum += px[i] + px[i + 1] + px[i + 2];
                ++n;
            }
        }
        return n > 0 ? static_cast<double>(sum) / static_cast<double>(n) : -1.0;
    };
    auto ohne = std::make_shared<double>(-1.0);
    auto stelle = [](bool gluehen) {
        g_app->leftMode = 1;   // Mission: die Karte ist sichtbar (im Modus Ereignisse nicht)
        g_app->throughCamera = false;
        g_app->cameraSelected = false;
        g_app->draufsicht = false;
        g_app->playing = false;
        g_app->playMs = 3690.0;
        g_app->showGlow = gluehen;
        g_app->cam.pos[0] = -192.0F; g_app->cam.pos[1] = 2600.0F; g_app->cam.pos[2] = 64.0F;
        g_app->cam.angles[0] = 0.0F; g_app->cam.angles[1] = 270.0F; g_app->cam.angles[2] = 0.0F;
        g_app->mapDirty = true;
    };
    add(tu("Gluehen Mover: vor das Palpatine-Hologramm, Gluehen aus", [=] { stelle(false); }));
    add(warteBis("gezeichnet", [] { return !g_app->mapDirty; }, 600));
    add(pause(0.3));
    add(tu("Gluehen Mover: Helligkeit ohne Gluehen", [=] { *ohne = mitte(); }));
    add(tu("Gluehen Mover: Gluehen an", [=] { stelle(true); }));
    add(warteBis("gezeichnet", [] { return !g_app->mapDirty; }, 600));
    add(pause(0.3));
    add(pruefe("Gluehen Mover: das Hologramm (func_wall) leuchtet mit Gluehen heller", [=] {
        const double mit = mitte();
        diag::detail("Knopftest: Gluehen Mover - Mitte ohne " + std::to_string(*ohne) + ", mit " +
                     std::to_string(mit) + ", Gluehaufrufe " + std::to_string(g_app->gpuGluehen) +
                     " (Mover " + std::to_string(gpu::gluehenMoverAufrufe()) + ")");
        return *ohne >= 0.0 && mit - *ohne > 6.0;
    }));
    return s;
}

// --- rc604: surfaceSprites (Gras) wie im Spiel - "gras" ---------------------
//
// yavin1b: textures/yavin/ground_grasssprite_phong_vertex traegt eine Stufe
// `surfaceSprites vertical`. Die Engine zeichnet sie NICHT als Schicht
// (tr_shade.cpp:1888 MD: continue), sondern als Halme
// (RB_DrawSurfaceSprites, tr_surfacesprites.cpp:1440). Prueft: (a) keine
// solche Stufe liegt als flache Schicht auf dem Boden, (b) auf der groessten
// Grasflaeche stehen Halme - gezaehlt und als Bildpunkte (mit/ohne).
std::vector<Schritt> grasSchritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto ohne = std::make_shared<std::vector<std::uint8_t>>();
    auto ziel = std::make_shared<std::array<float, 3>>(std::array<float, 3>{0, 0, 0});
    add(tu("Gras: yavin1b laden", [] {
        g_app->leftMode = 1;
        if (!loadMapFromArchive("maps/yavin1b.bsp")) { diag::detail("Knopftest: Gras - yavin1b nicht geladen"); }
    }));
    add(warteBis("Gras: Karte bereit", [] { return g_app->mapBereit; }, 900));
    add(pruefe("Gras: keine surfaceSprites-Stufe als flache Schicht (tr_shade.cpp:1888), alle als Halme", [] {
        std::size_t stufen = 0;
        for (const auto& v : g_app->grasStufen) { stufen += v.size(); }
        diag::detail("Knopftest: Gras - als Schicht " + std::to_string(g_app->grasFlachSchichten) + ", als Halme " +
                     std::to_string(stufen));
        return g_app->grasFlachSchichten == 0 && stufen > 0U;
    }));
    auto stelle = [=](bool gras) {
        g_app->leftMode = 1;
        g_app->throughCamera = false;
        g_app->cameraSelected = false;
        g_app->draufsicht = false;
        g_app->playing = false;
        g_app->playMs = 0.0;
        g_app->showEffects = false;
        g_app->showActors = false;
        g_app->zeigeGras = gras;
        for (int k = 0; k < 3; ++k) { g_app->cam.pos[k] = (*ziel)[static_cast<std::size_t>(k)]; }
        g_app->cam.pos[2] += 72.0F;
        g_app->cam.angles[0] = 30.0F;   // 30 Grad nach unten
        g_app->cam.angles[1] = 45.0F;
        g_app->cam.angles[2] = 0.0F;
        g_app->mapDirty = true;
    };
    add(tu("Gras: ueber die groesste Grasflaeche, Halme aus", [=] {
        float m[3] = {0, 0, 0};
        const bool da = grasTestZiel(m);
        for (int k = 0; k < 3; ++k) { (*ziel)[static_cast<std::size_t>(k)] = m[k]; }
        diag::detail("Knopftest: Gras - Ziel " + std::string(da ? "" : "NICHT ") + "gefunden: " + std::to_string(m[0]) +
                     " " + std::to_string(m[1]) + " " + std::to_string(m[2]));
        stelle(false);
    }));
    add(gezeichnet("Gras aus"));
    add(tu("Gras: noch ein Bild", [] { g_app->mapDirty = true; }));
    add(gezeichnet("Gras aus (zweites Bild)"));
    add(foto("gras_aus"));
    add(tu("Gras: Bild ohne Halme merken", [=] {
        int w = 0;
        int h = 0;
        if (!gpu::leseFarbe(*ohne, w, h)) { ohne->clear(); }
    }));
    add(tu("Gras: Halme an", [=] { stelle(true); }));
    add(gezeichnet("Gras an"));
    add(tu("Gras: noch ein Bild", [] { g_app->mapDirty = true; }));
    add(gezeichnet("Gras an (zweites Bild)"));
    add(foto("gras_an"));
    add(pruefe("Gras: auf der Grasflaeche stehen Halme (Vierecke und sichtbare Bildpunkte)", [=] {
        std::vector<std::uint8_t> mit;
        int w = 0;
        int h = 0;
        const bool gelesen = gpu::leseFarbe(mit, w, h);
        std::size_t anders = 0;
        const std::size_t n = std::min(mit.size(), ohne->size()) / 4U;
        for (std::size_t i = 0; gelesen && i < n; ++i) {
            const int d = std::abs(int(mit[i * 4]) - int((*ohne)[i * 4])) +
                          std::abs(int(mit[i * 4 + 1]) - int((*ohne)[i * 4 + 1])) +
                          std::abs(int(mit[i * 4 + 2]) - int((*ohne)[i * 4 + 2]));
            if (d > 24) { ++anders; }
        }
        const double anteil = n > 0U ? static_cast<double>(anders) / static_cast<double>(n) : 0.0;
        diag::detail("Knopftest: Gras - Vierecke " + std::to_string(g_app->grasVierecke) + " auf " +
                     std::to_string(g_app->grasFlaechen) + " Flaechen, Bildpunkte anders " + std::to_string(anders) +
                     " von " + std::to_string(n) + " (" + std::to_string(anteil * 100.0) + " %)");
        return g_app->grasVierecke > 50 && anteil > 0.02;
    }));
    add(pruefe("Gras: eine Nebensicht (Kameravorschau, Himmelsportal) baut fuer dieselbe Kamera dieselben Halme", [] {
        baueGrasNetzNeben(g_app->cam, g_app->grasReichweite);
        diag::detail("Knopftest: Gras - Nebensicht " + std::to_string(g_app->grasViereckeNeben) + ", Hauptsicht " +
                     std::to_string(g_app->grasVierecke));
        return g_app->grasViereckeNeben == g_app->grasVierecke && g_app->grasVierecke > 0;
    }));
    // Die grossen Grasflaechen anderer Karten: zeichnet es, und was kostet es?
    // (Effekte aus - die Zeit "Effekte" ist dann die der Halme.)
    struct Probe {
        const char* karte;
        bool mussHalme;
        bool patch = false;   // auf einen Patch zielen (Dreiecke wie RB_SurfaceGrid)
    };
    static const Probe kProben[] = {{"maps/duel_yavin.bsp", true},
                                    {"maps/duel_dantooine_enclave.bsp", true},
                                    {"maps/duel_dantooine_enclave.bsp", true, true},
                                    {"maps/t2_rancor.bsp", true},
                                    {"maps/t2_trip.bsp", true},
                                    {"maps/duel_kamino.bsp", false}};
    for (const Probe& pr : kProben) {
        const std::string karte = pr.karte;
        const bool muss = pr.mussHalme;
        const bool patch = pr.patch;
        add(tu("Gras: " + karte + " laden", [karte] {
            g_app->leftMode = 1;
            if (!loadMapFromArchive(karte)) { diag::detail("Knopftest: Gras - " + karte + " nicht geladen"); }
        }));
        add(warteBis("Gras: Karte bereit", [] { return g_app->mapBereit; }, 900));
        add(tu("Gras: ueber die groesste Flaeche mit surfaceSprites", [=] {
            float m[3] = {0, 0, 0};
            (void)grasTestZiel(m, true, patch);
            for (int k = 0; k < 3; ++k) { (*ziel)[static_cast<std::size_t>(k)] = m[k]; }
            stelle(true);
        }));
        for (int b = 0; b < 3; ++b) {
            add(gezeichnet("Gras " + karte));
            add(tu("Gras: noch ein Bild", [] { g_app->mapDirty = true; }));
        }
        add(gezeichnet("Gras " + karte + " (letztes Bild)"));
        add(foto("gras_" + karte.substr(5, karte.size() - 9) + (patch ? "_patch" : "")));
        add(pruefe("Gras: " + karte + (muss ? " - Halme gezeichnet" : " - gezeichnet (Effekte nur bei Regen)"), [=] {
            std::size_t stufen = 0;
            for (const auto& v : g_app->grasStufen) { stufen += v.size(); }
            diag::detail("Knopftest: Gras - " + karte + ": Stufen " + std::to_string(stufen) + ", als Schicht " +
                         std::to_string(g_app->grasFlachSchichten) + ", Vierecke " +
                         std::to_string(g_app->grasVierecke) + " auf " + std::to_string(g_app->grasFlaechen) +
                         " Flaechen (Patches " + std::to_string(g_app->grasPatches) + "), Nebelaufrufe " +
                         std::to_string(g_app->grasNebelAufrufe) +
                         ", Kameravorschau " + (g_app->vorschauGezeigt ? std::to_string(g_app->grasViereckeNeben) : std::string("aus")) +
                         ", Halme bauen " + std::to_string(g_app->frameCost.rawEffects) +
                         " ms, Bild gesamt " + std::to_string(g_app->frameCost.rawTotal) + " ms");
            return stufen > 0U && g_app->grasFlachSchichten == 0 && (!muss || g_app->grasVierecke > 0) &&
                   (!patch || g_app->grasPatches > 0);
        }));
    }
    return s;
}

// --- rc602: der erste Durchgang eines fx_runner (md_am_sith) -----------------
//
// SP_fx_runner setzt `nextthink = level.time + 400` (fx_runner_link, "Give us
// a bit of time to spawn in the other entities"), fx_runner_link danach
// `nextthink = level.time + 200` - der erste Effekt kommt also 600 ms nach dem
// Laden (g_fx.cpp MD und OpenJK gleich). behaved liess ihn nach 200 ms kommen.
// Prueft: die selbst laufenden Runner der Karte beginnen bei 600 ms.
std::vector<Schritt> fxRunnerStartSchritte() {
    std::vector<Schritt> s;
    s.push_back(pruefe("fx_runner: der erste Durchgang kommt 600 ms nach dem Laden (link 400 + 200)", [] {
        int laufend = 0;
        double frueh = 1.0e30;
        for (const EffectInstance& e : g_app->effectRunners) {
            if (!e.loops) { continue; }
            ++laufend;
            frueh = std::min(frueh, e.startMs);
        }
        diag::detail("Knopftest: fx_runner - " + std::to_string(laufend) + " laufend, fruehester Start " +
                     std::to_string(frueh) + " ms");
        return laufend > 0 && std::fabs(frueh - 600.0) < 0.5;
    }));
    return s;
}

// --- rc604 fix604: ein leerer Reiter mit der Karte ---------------------------
//
// In einem Skriptreiter fehlen jetzt die Darsteller anderer Zwischensequenzen
// (Ablauf::fremdeDarsteller); ohne Skript zeigt der Reiter die Karte, wie sie
// laedt - mit allen Figuren vom Kartenstart. Proben, die eine solche Figur
// brauchen (sbd1, die Figuren mit Stufenbildern), sehen sie dort an.
std::vector<Schritt> leererReiterMitKarte(const std::string& karte, const std::shared_ptr<int>& vorher) {
    std::vector<Schritt> s;
    s.push_back(tu("Leerer Reiter mit " + karte, [=] {
        *vorher = g_app->activeTab;
        neuerReiter();
        g_app->leftMode = 1;
        (void)loadMapFromArchive("maps/" + karte + ".bsp");
        g_app->mapDirty = true;
    }));
    s.push_back(warteBis("Leerer Reiter: Karte bereit", [] { return g_app->mapBereit; }, 900));
    s.push_back(warteBis("Leerer Reiter: Szene aufgebaut", [] { return g_app->camTrackValid; }, 900));
    s.push_back(gezeichnet(karte));
    return s;
}
std::vector<Schritt> leererReiterZurueck(const std::shared_ptr<int>& vorher) {
    std::vector<Schritt> s;
    s.push_back(tu("Leerer Reiter: schliessen, zurueck", [=] {
        reiterSchliessen(g_app->activeTab);
        if (*vorher >= 0 && *vorher < static_cast<int>(g_app->tabs.size())) { g_app->tabRequest = *vorher; }
    }));
    s.push_back(warteBis("Leerer Reiter: zurueck", [=] {
        return g_app->tabRequest < 0 && (*vorher < 0 || g_app->activeTab == *vorher);
    }, 900));
    return s;
}

// --- rc602: Leuchtstufen der Figuren (md_am_sith, Superkampfdroide sbd1) -----
//
// Teil desselben Berichts ("als wuerde etwas fehlen"): die Haut nennt etwa
// "models/players/sbd/body_cortosis" bzw. ".../magnaguard/mangahead" - im
// Spiel gewinnt das gleichnamige Shaderskript (R_FindShader sucht erst den
// Shader, dann das Bild), und dessen letzte Stufe ist ein Leuchtbild mit
// "blendFunc GL_ONE GL_ONE" und "glow" (Lichter des Droiden, Augen der
// MagnaGuards). behaved nahm das Bild allein. sbd1 steht ab Kartenstart bei
// 8 4832 24 (NPC_spawner ohne targetname). Prueft: mit Gluehen wird die Figur
// heller als ohne.
std::vector<Schritt> gluehenFigurSchritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    // rc604 fix604: sbd1 (SFB_CINEMATIC, NPC_targetname) nennt das Skript des
    // Selbsttests nicht - in einem leeren Reiter steht sie da.
    auto vorher = std::make_shared<int>(-1);
    for (Schritt& x : leererReiterMitKarte("md_am_sith", vorher)) { add(std::move(x)); }
    // Kraeftig rote Bildpunkte im unteren mittleren Teil des Bildes, wo der
    // Kopf von sbd1 steht: dort liegt das rote Auge der Leuchtstufe.
    auto rot = [] {
        std::vector<std::uint8_t> px;
        int w = 0;
        int h = 0;
        if (!gpu::leseFarbe(px, w, h) || px.empty() || w <= 0 || h <= 0) { return -1; }
        int n = 0;
        for (int y = h * 55 / 100; y < h; ++y) {
            for (int x = w * 45 / 100; x < w * 75 / 100; ++x) {
                const std::size_t i = (static_cast<std::size_t>(y) * static_cast<std::size_t>(w) + static_cast<std::size_t>(x)) * 4U;
                if (px[i] >= 200 && px[i + 1] <= 90 && px[i + 2] <= 90) { ++n; }
            }
        }
        return n;
    };
    auto fi = std::make_shared<int>(-1);
    auto ohne = std::make_shared<int>(-1);
    constexpr double kMs = 3690.0;
    auto stelle = [=](bool gluehen) {
        g_app->leftMode = 1;   // Mission: die Karte ist sichtbar (im Modus Ereignisse nicht)
        g_app->throughCamera = false;
        g_app->cameraSelected = false;
        g_app->draufsicht = false;
        g_app->playing = false;
        g_app->playMs = kMs;
        g_app->showGlow = gluehen;
        if (*fi >= 0) {
            // Wo die Figur gezeichnet wurde (nach der Schwerkraft), sonst
            // der Skriptort. Von vorn: der Spawner sagt "angle 90", die
            // Figur blickt nach +y.
            const ActorState st = g_app->scene.actors[static_cast<std::size_t>(*fi)].at(kMs);
            float p[3] = {st.pos[0], st.pos[1], st.pos[2]};
            if (static_cast<std::size_t>(*fi) < g_app->figurGezeichnet.size() &&
                g_app->figurGezeichnet[static_cast<std::size_t>(*fi)][2] > -90000.0F) {
                for (int k = 0; k < 3; ++k) { p[k] = g_app->figurGezeichnet[static_cast<std::size_t>(*fi)][static_cast<std::size_t>(k)]; }
            }
            diag::detail("Knopftest: Gluehen Figur - Ort " + std::to_string(p[0]) + " " + std::to_string(p[1]) + " " +
                         std::to_string(p[2]) + " (Skript " + std::to_string(st.pos[1]) + ")");
            g_app->cam.pos[0] = p[0];
            g_app->cam.pos[1] = p[1] + 28.0F;
            g_app->cam.pos[2] = p[2] + 50.0F;
            g_app->cam.angles[0] = 0.0F; g_app->cam.angles[1] = 270.0F; g_app->cam.angles[2] = 0.0F;
        }
        g_app->mapDirty = true;
    };
    add(tu("Gluehen Figur: vor sbd1, Gluehen aus", [=] {
        *fi = -1;
        for (std::size_t i = 0; i < g_app->scene.actors.size(); ++i) {
            if (g_app->scene.actors[i].name == "sbd1") { *fi = static_cast<int>(i); }
        }
        stelle(false);
    }));
    add(warteBis("gezeichnet", [] { return !g_app->mapDirty; }, 600));
    add(pause(0.3));
    add(foto("gluehen_figur_ohne"));
    // Schwelle 20: die Figur ist so gross, wie die Szene breit ist (fov_x fest).
    // rc605 zeichnete die Szene 1384 breit (31 rote Punkte); seit dem Eintrag
    // "Map Editor" der Modusleiste (Karten-Editor Stufe 1b, die Leiste ist so
    // breit wie ihre laengste Beschriftung) sind es 1359 und 29 Punkte - das
    // Auge ist weiter klar im Bild, die alte Schwelle 30 lag nur einen Punkt
    // unter dem rc605-Wert.
    add(pruefe("Gluehen Figur: die Leuchtstufe (rotes Auge von sbd1) liegt im Bild", [=] {
        *ohne = rot();
        diag::detail("Knopftest: Gluehen Figur - sbd1 #" + std::to_string(*fi) + ", rote Bildpunkte am Kopf " +
                     std::to_string(*ohne));
        return *fi >= 0 && *ohne > 20;
    }));
    add(tu("Gluehen Figur: Gluehen an", [=] { stelle(true); }));
    add(warteBis("gezeichnet", [] { return !g_app->mapDirty; }, 600));
    add(pause(0.3));
    add(foto("gluehen_figur_mit"));
    add(pruefe("Gluehen Figur: die Leuchtstufe geht ins Gluehen", [=] {
        const int r = rot();
        const int n = gpu::gluehenFigurAufrufe();
        diag::detail("Knopftest: Gluehen Figur - mit Gluehen rote Bildpunkte " + std::to_string(r) +
                     ", Figurenaufrufe im Gluehen " + std::to_string(n));
        return r >= *ohne && n > 0;
    }));
    add(tu("Gluehen: zurueck in den Modus Ereignisse", [] { g_app->leftMode = 0; }));
    for (Schritt& x : leererReiterZurueck(vorher)) { add(std::move(x)); }
    return s;
}

// --- rc602 kartenpruefung: Gegenstaende der Karte (item_*, weapon_*) --------
//
// Die Kartenpruefung fand auf 87 von 278 Karten Medipacks, Waffen und
// Munition, die das Spiel zeigt (G_SpawnItem/FinishSpawningItem, CG_Item) und
// behaved nicht zeichnete. Geprueft wird an einer echten Karte: der erste
// Gegenstand der Klasse ohne targetname muss aufgestellt sein (gefallen bis
// zum Boden), und von oben gesehen muss er das Bild veraendern - verglichen
// mit demselben Bild, in dem er versteckt ist (kein Bildschirmfoto, nur der
// eigene Farbpuffer).
std::vector<Schritt> gegenstandSchritte(const std::string& klasse, const std::string& name, bool glmErwartet) {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto ent = std::make_shared<long long>(-1);
    auto ort = std::make_shared<std::array<float, 3>>();
    auto mit = std::make_shared<std::vector<std::uint8_t>>();
    auto bw = std::make_shared<int>(0);
    auto bh = std::make_shared<int>(0);
    add(tu("Gegenstand " + name + ": suchen und von oben ansehen", [=] {
        *ent = -1;
        for (std::size_t i = 0; i < g_app->map.entities.size(); ++i) {
            const MapEntity& e = g_app->map.entities[i];
            if (e.classname == klasse && e.targetname.empty() && e.find("targetname") == nullptr) {
                *ent = static_cast<long long>(i);
                break;
            }
        }
        float o[3] = {0.0F, 0.0F, 0.0F};
        std::string modell;
        bool glm = false;
        const bool da = *ent >= 0 && gegenstandInstanz(static_cast<std::size_t>(*ent), o, &modell, &glm);
        if (!da && *ent >= 0) {
            (void)std::sscanf(g_app->map.entities[static_cast<std::size_t>(*ent)].origin.c_str(), "%f %f %f", &o[0],
                              &o[1], &o[2]);
        }
        *ort = {o[0], o[1], o[2]};
        diag::detail("Knopftest: Gegenstand " + name + " - Entity " + std::to_string(*ent) + ", aufgestellt " +
                     std::to_string(da ? 1 : 0) + ", Modell " + modell + (glm ? " (glm)" : "") + ", Ort " +
                     std::to_string(o[0]) + " " + std::to_string(o[1]) + " " + std::to_string(o[2]));
        g_app->leftMode = 1;
        g_app->throughCamera = false;
        g_app->cameraSelected = false;
        g_app->draufsicht = false;
        g_app->playing = false;
        g_app->cam.pos[0] = o[0];
        g_app->cam.pos[1] = o[1];
        g_app->cam.pos[2] = o[2] + 48.0F;
        g_app->cam.angles[0] = 89.0F;
        g_app->cam.angles[1] = 90.0F;
        g_app->cam.angles[2] = 0.0F;
        g_app->mapDirty = true;
    }));
    add(warteBis("gezeichnet", [] { return !g_app->mapDirty; }, 600));
    add(pause(0.3));
    add(foto("gegenstand_" + name + "_mit"));
    add(pruefe("Gegenstand " + name + ": aufgestellt wie FinishSpawningItem (gefallen, Modell)", [=] {
        float o[3];
        std::string modell;
        bool glm = false;
        const bool da = *ent >= 0 && gegenstandInstanz(static_cast<std::size_t>(*ent), o, &modell, &glm);
        float roh[3] = {0.0F, 0.0F, 0.0F};
        if (*ent >= 0) {
            (void)std::sscanf(g_app->map.entities[static_cast<std::size_t>(*ent)].origin.c_str(), "%f %f %f", &roh[0],
                              &roh[1], &roh[2]);
        }
        (void)gpu::leseFarbe(*mit, *bw, *bh);
        // Gefallen heisst: nicht hoeher als origin + 1 (FinishSpawningItem).
        return da && glm == glmErwartet && o[2] <= roh[2] + 1.0F + 0.01F;
    }));
    add(tu("Gegenstand " + name + ": verstecken", [=] {
        if (*ent >= 0) { gegenstandVerstecken(static_cast<std::size_t>(*ent), true); }
        g_app->mapDirty = true;
    }));
    add(warteBis("gezeichnet", [] { return !g_app->mapDirty; }, 600));
    add(pause(0.3));
    add(pruefe("Gegenstand " + name + ": von oben sichtbar (Bildmitte mit/ohne)", [=] {
        std::vector<std::uint8_t> ohne;
        int w = 0;
        int h = 0;
        const bool gelesen = gpu::leseFarbe(ohne, w, h);
        if (*ent >= 0) { gegenstandVerstecken(static_cast<std::size_t>(*ent), false); }
        g_app->mapDirty = true;
        if (!gelesen || w != *bw || h != *bh || mit->size() != ohne.size() || w <= 0) { return false; }
        // Mittleres Fuenftel des Bildes: mittlerer Farbunterschied je Punkt.
        double summe = 0.0;
        long long n = 0;
        for (int y = h * 2 / 5; y < h * 3 / 5; ++y) {
            for (int x = w * 2 / 5; x < w * 3 / 5; ++x) {
                const std::size_t i = (static_cast<std::size_t>(y) * static_cast<std::size_t>(w) + static_cast<std::size_t>(x)) * 4U;
                for (int k = 0; k < 3; ++k) { summe += std::abs(static_cast<int>((*mit)[i + k]) - static_cast<int>(ohne[i + k])); }
                ++n;
            }
        }
        const double mittel = n > 0 ? summe / static_cast<double>(n * 3) : 0.0;
        char z[160];
        std::snprintf(z, sizeof(z), "Knopftest: Gegenstand %s - Bildmitte mit/ohne: mittlerer Unterschied %.2f",
                      name.c_str(), mittel);
        diag::detail(z);
        return mittel > 4.0;
    }));
    add(warteBis("gezeichnet", [] { return !g_app->mapDirty; }, 600));
    return s;
}

// md_am_sith: item_medpak_instant (models/items/medpac.md3) - fuer den Modus karte.
std::vector<Schritt> gegenstaendeKarteSchritte() {
    return gegenstandSchritte("item_medpak_instant", "medpak", false);
}

// Modus gegenstaende: md_am_sith (md3) und md_agditf_sith (weapon_blaster, glm).
std::vector<Schritt> gegenstaendeModusSchritte() {
    std::vector<Schritt> s;
    for (const char* karte : {"maps/md_am_sith.bsp", "maps/md_agditf_sith.bsp"}) {
        const std::string k = karte;
        s.push_back(tu("Gegenstaende: " + k + " laden", [=] {
            g_app->leftMode = 1;   // Kartenansicht - sonst baut die Ansicht nichts
            (void)loadMapFromArchive(k);
            g_app->mapDirty = true;
        }));
        s.push_back(warteBis("Karte bereit", [] { return g_app->mapBereit; }, 900));
        s.push_back(warteBis("Szene aufgebaut", [] { return g_app->camTrackValid; }, 900));
        s.push_back(gezeichnet(k));
        const bool erste = k.find("md_am_sith") != std::string::npos;
        for (Schritt& x : erste ? gegenstandSchritte("item_medpak_instant", "medpak", false)
