// --- rc602 kartenpruefung: feste Modelle der Spawnfunktionen --------------
//
// misc_shield_floor_unit (24 Karten), misc_ammo_floor_unit (22),
// misc_security_panel (5) und misc_camera (8) setzen ihr Modell im Code
// (g_misc.cpp, g_mover.cpp) - behaved zeichnete sie nicht. Geprueft an einer
// echten Karte: das Modell steht (MapModel der Entity), und es veraendert das
// Bild (mit/ohne, eigener Farbpuffer).
std::vector<Schritt> kartenmodellSchritte(const std::string& karte, const std::string& klasse, int modelleErwartet,
                                         float hoehe) {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto ent = std::make_shared<long long>(-1);
    auto mit = std::make_shared<std::vector<std::uint8_t>>();
    auto bw = std::make_shared<int>(0);
    auto bh = std::make_shared<int>(0);
    auto merk = std::make_shared<std::vector<std::pair<std::size_t, float>>>();
    add(tu("Kartenmodell " + klasse + ": " + karte + " laden", [=] {
        g_app->leftMode = 1;
        (void)loadMapFromArchive(karte);
        g_app->mapDirty = true;
    }));
    add(warteBis("Karte bereit", [] { return g_app->mapBereit; }, 900));
    add(warteBis("Szene aufgebaut", [] { return g_app->camTrackValid; }, 900));
    add(gezeichnet(karte));
    add(tu("Kartenmodell " + klasse + ": ansehen", [=] {
        *ent = -1;
        for (std::size_t i = 0; i < g_app->map.entities.size(); ++i) {
            if (g_app->map.entities[i].classname == klasse) {
                *ent = static_cast<long long>(i);
                break;
            }
        }
        float o[3] = {0.0F, 0.0F, 0.0F};
        if (*ent >= 0) {
            (void)std::sscanf(g_app->map.entities[static_cast<std::size_t>(*ent)].origin.c_str(), "%f %f %f", &o[0],
                              &o[1], &o[2]);
        }
        g_app->throughCamera = false;
        g_app->cameraSelected = false;
        g_app->draufsicht = false;
        g_app->playing = false;
        g_app->cam.pos[0] = o[0];
        g_app->cam.pos[1] = o[1];
        g_app->cam.pos[2] = o[2] + hoehe;   // rc604 fix604b: grosse Modelle (Ionenkanone, s.radius 320) von weiter oben
        g_app->cam.angles[0] = 89.0F;
        g_app->cam.angles[1] = 90.0F;
        g_app->cam.angles[2] = 0.0F;
        g_app->mapDirty = true;
    }));
    add(warteBis("gezeichnet", [] { return !g_app->mapDirty; }, 600));
    add(pause(0.3));
    add(pruefe("Kartenmodell " + klasse + ": steht (feste Modelle der Spawnfunktion)", [=] {
        int n = 0;
        std::string pfade;
        for (const App::MapModel& mm : g_app->mapModels) {
            if (*ent >= 0 && mm.entity == static_cast<std::size_t>(*ent)) {
                ++n;
                pfade += " " + mm.path;
            }
        }
        // rc604 fix604b (B3): Ghoul2-Modelle der Spawnfunktionen (Geschuetze).
        for (const App::GegenstandGlm& gg : g_app->gegenstandGlm) {
            if (*ent >= 0 && gg.entity == static_cast<std::size_t>(*ent)) {
                ++n;
                pfade += " " + gg.pfad;
            }
        }
        (void)gpu::leseFarbe(*mit, *bw, *bh);
        diag::detail("Knopftest: Kartenmodell " + klasse + " - Entity " + std::to_string(*ent) + ", Modelle " +
                     std::to_string(n) + ":" + pfade);
        return *ent >= 0 && n == modelleErwartet;
    }));
    add(tu("Kartenmodell " + klasse + ": verstecken", [=] {
        merk->clear();
        for (std::size_t k = 0; k < g_app->mapModels.size(); ++k) {
            App::MapModel& mm = g_app->mapModels[k];
            if (*ent >= 0 && mm.entity == static_cast<std::size_t>(*ent)) {
                merk->emplace_back(k, mm.origin[2]);
                mm.origin[2] -= 100000.0F;
            }
        }
        for (App::GegenstandGlm& gg : g_app->gegenstandGlm) {   // rc604 fix604b (B3)
            if (*ent >= 0 && gg.entity == static_cast<std::size_t>(*ent)) { gg.versteckt = true; }
        }
        g_app->mapDirty = true;
    }));
    add(warteBis("gezeichnet", [] { return !g_app->mapDirty; }, 600));
    add(pause(0.3));
    add(pruefe("Kartenmodell " + klasse + ": sichtbar (Bildmitte mit/ohne)", [=] {
        std::vector<std::uint8_t> ohne;
        int w = 0;
        int h = 0;
        const bool gelesen = gpu::leseFarbe(ohne, w, h);
        for (const auto& [k, z] : *merk) {
            if (k < g_app->mapModels.size()) { g_app->mapModels[k].origin[2] = z; }
        }
        for (App::GegenstandGlm& gg : g_app->gegenstandGlm) { gg.versteckt = false; }   // rc604 fix604b (B3)
        g_app->mapDirty = true;
        if (!gelesen || w != *bw || h != *bh || mit->size() != ohne.size() || w <= 0) { return false; }
        double summe = 0.0;
        long long n = 0;
        for (int y = h * 2 / 5; y < h * 3 / 5; ++y) {
            for (int x = w * 2 / 5; x < w * 3 / 5; ++x) {
                const std::size_t i = (static_cast<std::size_t>(y) * static_cast<std::size_t>(w) + static_cast<std::size_t>(x)) * 4U;
                for (int c = 0; c < 3; ++c) { summe += std::abs(static_cast<int>((*mit)[i + c]) - static_cast<int>(ohne[i + c])); }
                ++n;
            }
        }
        const double mittel = n > 0 ? summe / static_cast<double>(n * 3) : 0.0;
        char z[160];
        std::snprintf(z, sizeof(z), "Knopftest: Kartenmodell %s - Bildmitte mit/ohne: mittlerer Unterschied %.2f",
                      klasse.c_str(), mittel);
        diag::detail(z);
        return mittel > 4.0;
    }));
    add(warteBis("gezeichnet", [] { return !g_app->mapDirty; }, 600));
    return s;
}

// --- Stufe 6 (OpenJK#1358, zweiter Teil): misc_model_static mit Pruefpunkt im Festen --------
//
// CG_DrawMiscEnts (OpenJK code/cgame/cg_main.cpp, MD cg_main.cpp:3212-3236) zeichnet ein
// misc_model_static nur, wenn gi.inPVS(vieworg, origin + (0 0 zoffset+1)) gilt; liegt der
// Punkt im Festen, ist das Blatt undurchsichtig (Area -1) und CM_AreasConnected sagt nein -
// das Modell erscheint nie. Die Vorschau "wie im Spiel" zeigte es trotzdem. Probe: t1_inter
// mit zwei angehaengten misc_model_static (Pruefpunkt im Freien neben dem Spielerstart und
// weit ausserhalb der Karte).
std::vector<Schritt> modellImFestenSchritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    add(tu("OpenJK#1358: t1_inter mit zwei misc_model_static laden", [] {
        std::string bsp;
        if (!readFromArchives("maps/t1_inter.bsp", bsp) || bsp.size() < 8 + 18 * 8) {
            diag::detail("Knopftest: OpenJK#1358 - maps/t1_inter.bsp nicht gefunden");
            return;
        }
        std::int32_t ofs = 0;
        std::int32_t len = 0;
        std::memcpy(&ofs, bsp.data() + 8, 4);
        std::memcpy(&len, bsp.data() + 12, 4);
        std::string text = bsp.substr(static_cast<std::size_t>(ofs), static_cast<std::size_t>(len));
        while (!text.empty() && text.back() == '\0') { text.pop_back(); }
        // Ort des Spielerstarts
        float sx = 0.0F;
        float sy = 0.0F;
        float sz = 0.0F;
        const std::size_t st = text.find("\"info_player_start\"");
        if (st != std::string::npos) {
            const std::size_t a = text.rfind('{', st);
            const std::size_t o = text.find("\"origin\"", a);
            if (o != std::string::npos) { (void)std::sscanf(text.c_str() + o + 8, " \"%f %f %f\"", &sx, &sy, &sz); }
        }
        char frei[160];
        std::snprintf(frei, sizeof(frei), "%g %g %g", static_cast<double>(sx), static_cast<double>(sy), static_cast<double>(sz + 8.0F));
        const std::string modell = "\"model\" \"models/map_objects/imperial/crate_banded.md3\"\n";
        text += "{\n\"classname\" \"misc_model_static\"\n\"origin\" \"" + std::string(frei) + "\"\n" + modell + "\"targetname\" \"s6frei\"\n}\n";
        text += "{\n\"classname\" \"misc_model_static\"\n\"origin\" \"60000 60000 60000\"\n" + modell + "\"targetname\" \"s6fest\"\n}\n";
        text.push_back('\0');
        while (bsp.size() % 4 != 0) { bsp.push_back('\0'); }
        const auto neuOfs = static_cast<std::int32_t>(bsp.size());
        const auto neuLen = static_cast<std::int32_t>(text.size());
        bsp += text;
        std::memcpy(bsp.data() + 8, &neuOfs, 4);
        std::memcpy(bsp.data() + 12, &neuLen, 4);
        g_app->leftMode = 1;   // Kartenansicht - sonst baut die Ansicht nichts
        loadMapFromBytes(bsp, "maps/t1_inter_openjk1358.bsp");
        g_app->mapDirty = true;
    }));
    add(warteBis("Karte bereit", [] { return g_app->mapBereit; }, 900));
    add(warteBis("Szene aufgebaut", [] { return g_app->camTrackValid; }, 900));
    add(gezeichnet("t1_inter (OpenJK#1358)"));
    add(pruefe("OpenJK#1358: misc_model_static mit Pruefpunkt im Festen fehlt in der Vorschau, der im Freien steht", [] {
        int frei = -1;
        int fest = -1;
        for (std::size_t i = 0; i < g_app->map.entities.size(); ++i) {
            const std::string* t = g_app->map.entities[i].find("targetname");
            if (t != nullptr && *t == "s6frei") { frei = static_cast<int>(i); }
            if (t != nullptr && *t == "s6fest") { fest = static_cast<int>(i); }
        }
        bool mitFrei = false;
        bool mitFest = false;
        for (const App::MapModel& mm : g_app->mapModels) {
            mitFrei = mitFrei || (frei >= 0 && mm.entity == static_cast<std::size_t>(frei));
            mitFest = mitFest || (fest >= 0 && mm.entity == static_cast<std::size_t>(fest));
        }
        diag::detail("Knopftest: OpenJK#1358 - Entity frei " + std::to_string(frei) + (mitFrei ? " gezeigt" : " fehlt") + ", im Festen " +
                     std::to_string(fest) + (mitFest ? " gezeigt" : " fehlt"));
        return frei >= 0 && fest >= 0 && mitFrei && !mitFest;
    }));
    return s;
}

