               finde(tr(Str::CamNextShot), "", 0, false) != nullptr &&
               finde(tr(Str::CamShots), "", 0, false) != nullptr;
    }));
    add(foto("kam_leiste"));
    add(klick(tr(Str::GizmoMove), "##kameraleiste"));
