        g_app->cam.pos[0] = 50.0F; g_app->cam.pos[1] = 6300.0F; g_app->cam.pos[2] = 180.0F;
        g_app->cam.angles[0] = 5.0F; g_app->cam.angles[1] = 80.0F; g_app->cam.angles[2] = 0.0F;
