            for (int i = 0; i < modellBlenderTasteZahl(); ++i) {
                if (modellBlenderTasteChord(i) == chord) { diag::detail(std::string("Knopftest: MB2 Blender - Quelle: ") + modellBlenderTasteQuelle(i)); }
            }
            return wirkung();
        }));
        if (z.chord == (ImGuiMod_Ctrl | ImGuiKey_Tab)) { add(tasteKombi(ImGuiKey_Escape, "Esc")); }
    }
    add(pruefe("MB2 Blender: jede Taste der Tabelle hat eine Quelle (blender_keys.txt oder Doku)", [] {
        for (int i = 0; i < modellBlenderTasteZahl(); ++i) {
            if (modellBlenderTasteQuelle(i) == nullptr || modellBlenderTasteQuelle(i)[0] == '\0') { return false; }
        }
        return modellBlenderTasteZahl() >= 30;
    }));
    // G/R/S modal mit Achse und Zahl. mbvers: Zahl, Achse und Mitte gelten im Gezeigten (die Figur steht in BOTH_WALK1) -
    // geprueft werden die gezeigten Orte in der Pose der Umformung; Abbrechen und Rueckgaengig bitgleich an der Datei.
    auto vorher = std::make_shared<std::vector<modell::Ecke>>();
    const auto eckenVon = [] { return netz(teil("torso"))->ecken; };
    const auto orteGleich = [](const std::vector<modell::Ecke>& a, const std::vector<modell::Ecke>& b) {
        if (a.size() != b.size()) { return false; }
        for (std::size_t i = 0; i < a.size(); ++i) {
            if (std::memcmp(a[i].ort, b[i].ort, sizeof a[i].ort) != 0) { return false; }
        }
        return true;
    };
    // Die groesste Abweichung der gezeigten Ecken von `soll(vorher, Mitte der Auswahl)`, in float-Schritten der groessten
    // Koordinate; die Mitte ist die des Kastens der gezeigten Ecken davor (auswahlMitte)
    const auto abweichung = [](const std::vector<modell::Ecke>& davor, const std::vector<modell::Ecke>& danach,
                               const std::function<void(const float*, const float*, float*)>& soll) {
        const std::vector<BoneMatrix>& pose = g_app->mtab.umformKnochen;
        if (davor.size() != danach.size() || davor.empty()) { return 1e9F; }
        std::vector<std::array<float, 3>> p0(davor.size());
        std::vector<std::array<float, 3>> p1(davor.size());
        float mn[3] = {1e30F, 1e30F, 1e30F};
        float mx[3] = {-1e30F, -1e30F, -1e30F};
        float groesste = 1.0F;
        for (std::size_t i = 0; i < davor.size(); ++i) {
            gezeigtEcke(davor[i], pose, p0[i].data());
            gezeigtEcke(danach[i], pose, p1[i].data());
            for (std::size_t k = 0; k < 3U; ++k) {
                mn[k] = std::min(mn[k], p0[i][k]);
                mx[k] = std::max(mx[k], p0[i][k]);
                groesste = std::max({groesste, std::fabs(p0[i][k]), std::fabs(p1[i][k])});
            }
        }
        const float c[3] = {(mn[0] + mx[0]) * 0.5F, (mn[1] + mx[1]) * 0.5F, (mn[2] + mx[2]) * 0.5F};
        float fehler = 0.0F;
        for (std::size_t i = 0; i < davor.size(); ++i) {
            float s3[3];
            soll(p0[i].data(), c, s3);
            for (std::size_t k = 0; k < 3U; ++k) { fehler = std::max(fehler, std::fabs(p1[i][k] - s3[k])); }
        }
        return fehler / schritt(groesste);
    };
    add(tu("MB2 Blender G: Perspektive, torso gewaehlt, Ecken merken", [vorher, eckenVon] {
        modellAnsichtSetzen(AnsichtArt::Perspektive);
        g_app->mtab.auswahl = {teil("torso")};
        *vorher = eckenVon();
    }));
    add(tasteKombi(ImGuiKey_G, "G"));
    add(tasteKombi(ImGuiKey_X, "X"));
    add(tasteKombi(ImGuiKey_1, "1"));
    add(tasteKombi(ImGuiKey_0, "0"));
    add(pause(0.2));
    add(tasteKombi(ImGuiKey_Enter, "Enter"));
    add(pause(0.2));
    add(pruefe("MB2 Blender G X 10 Enter: torso genau 10 in X verschoben, Y und Z gleich (wie gezeigt), ein Schritt", [vorher, eckenVon, abweichung] {
        const float f = abweichung(*vorher, eckenVon(), [](const float* p, const float*, float* o) {
            o[0] = p[0] + 10.0F;
            o[1] = p[1];
            o[2] = p[2];
        });
        diag::detail("Knopftest: MB2 Blender G X 10 - groesste Abweichung " + std::to_string(f) + " float-Schritte (erlaubt " + std::to_string(kRundungen) + ")");
        return f <= kRundungen && g_app->mtab.modal.art == 0 && g_app->mtab.dok.rueckgaengigName() == tr(Str::MbUndoBewegen);
    }));
    add(tasteKombi(ImGuiMod_Ctrl | ImGuiKey_Z, "Strg+Z"));
    add(tasteKombi(ImGuiKey_S, "S"));
    add(tasteKombi(ImGuiKey_2, "2"));
    add(pause(0.2));
    add(tasteKombi(ImGuiKey_Enter, "Enter"));
    add(pause(0.2));
    add(pruefe("MB2 Blender S 2 Enter: torso um die gezeigte Mitte verdoppelt (Abstaende zur Mitte mal 2)", [vorher, eckenVon, abweichung] {
        const float f = abweichung(*vorher, eckenVon(), [](const float* p, const float* c, float* o) {
            for (int k = 0; k < 3; ++k) { o[k] = c[k] + (p[k] - c[k]) * 2.0F; }
        });
        diag::detail("Knopftest: MB2 Blender S 2 - groesste Abweichung " + std::to_string(f) + " float-Schritte (erlaubt " + std::to_string(kRundungen) + ")");
        return f <= kRundungen;
    }));
    add(tasteKombi(ImGuiMod_Ctrl | ImGuiKey_Z, "Strg+Z"));
    add(tasteKombi(ImGuiKey_R, "R"));
    add(tasteKombi(ImGuiKey_Z, "Z"));
    add(tasteKombi(ImGuiKey_9, "9"));
    add(tasteKombi(ImGuiKey_0, "0"));
    add(pause(0.2));
    add(tasteKombi(ImGuiKey_Escape, "Esc"));
    add(pause(0.2));
    add(pruefe("MB2 Blender R Z 90 Esc: abgebrochen - alles wie vorher, kein Schritt, nichts zum Wiederholen", [vorher, eckenVon, orteGleich] {
        return orteGleich(eckenVon(), *vorher) && g_app->mtab.modal.art == 0 && !g_app->mtab.dok.kannRueckgaengig();
    }));
    add(tasteKombi(ImGuiKey_R, "R"));
    add(tasteKombi(ImGuiKey_Z, "Z"));
    add(tasteKombi(ImGuiKey_9, "9"));
    add(tasteKombi(ImGuiKey_0, "0"));
    add(pause(0.2));
    add(tasteKombi(ImGuiKey_Enter, "Enter"));
    add(pause(0.2));
    add(pruefe("MB2 Blender R Z 90 Enter: torso um die Z-Achse durch die gezeigte Mitte um 90 Grad gedreht", [vorher, eckenVon, abweichung, orteGleich] {
        const std::vector<modell::Ecke> jetzt = eckenVon();
        const float f = abweichung(*vorher, jetzt, [](const float* p, const float* c, float* o) {   // (x, y) -> (-y, x) um die Mitte
            o[0] = c[0] - (p[1] - c[1]);
            o[1] = c[1] + (p[0] - c[0]);
            o[2] = p[2];
        });
        diag::detail("Knopftest: MB2 Blender R Z 90 - groesste Abweichung " + std::to_string(f) + " float-Schritte (erlaubt " + std::to_string(kRundungen) + ")");
        return f <= kRundungen && !orteGleich(jetzt, *vorher);
    }));
    add(tasteKombi(ImGuiMod_Ctrl | ImGuiMod_Shift | ImGuiKey_Z, "Strg+Umschalt+Z"));
    add(tasteKombi(ImGuiMod_Ctrl | ImGuiKey_Z, "Strg+Z"));
    add(tasteKombi(ImGuiMod_Ctrl | ImGuiKey_Z, "Strg+Z"));
    add(pruefe("MB2 Blender Strg+Z: wieder wie die Datei", [vorher, eckenVon, orteGleich] { return orteGleich(eckenVon(), *vorher); }));
    add(tu("MB2 Blender: zurueck (wie 3ds Max)", [] {
        modellBedienungSetzen(0);
        g_app->modellKnochen = false;
        g_app->leftMode = 1;
        g_app->doc.markSaved();
    }));
    add(pause(0.2));
    return s;
}

// --- bild2: Pose ueber den Model-Tab gegen den Mission-Tab; Mission-Tab vorher/nachher --------------------------
Schritt bildVergleich2(const std::string& spiel) {
    struct Zustand {
        std::vector<std::string> modelle;
        std::vector<std::string> npcs;
        std::size_t i = 0;
        std::size_t j = 0;
        int poseGleich = 0;
        int poseAnders = 0;
        int poseOhne = 0;
        int missionGleich = 0;
        int missionAnders = 0;
        int missionOhne = 0;
        std::string poseListe;
        std::string missionListe;
        std::chrono::steady_clock::time_point anfang{};
    };
    auto z = std::make_shared<Zustand>();
    constexpr int kB = 400;
    constexpr int kH = 560;
    Schritt s{"MB2 Bild: Pose Model-Tab gegen Mission-Tab, Mission-Tab vorher/nachher (" + spiel + ")", [=](int b) {
                  if (b == 0) {
                      for (const GamePath& gp : g_app->gamePaths) {
                          for (const FoundFile& f : findByExtension(gp, {".glm"})) {
                              std::string k = f.name;
                              for (char& c : k) { c = static_cast<char>(std::tolower(static_cast<unsigned char>(c))); }
                              if (k.rfind("models/players/", 0) == 0) { z->modelle.push_back(f.name); }
                          }
                      }
                      std::sort(z->modelle.begin(), z->modelle.end());
                      z->modelle.erase(std::unique(z->modelle.begin(), z->modelle.end()), z->modelle.end());
                      if (g_app->npcMap.empty()) { (void)npcDateienLesen(g_app->npcMap); }
                      for (const auto& [name, def] : g_app->npcMap) {
                          if (!def.playerModel.empty()) { z->npcs.push_back(name); }
                      }
                      const char* grenze = std::getenv("BHED_MB_GRENZE");
                      if (grenze != nullptr && std::atoi(grenze) > 0) {
                          const auto g = static_cast<std::size_t>(std::atoi(grenze));
                          if (z->modelle.size() > g) { z->modelle.resize(g); }
                          if (z->npcs.size() > g) { z->npcs.resize(g); }
                      }
                      testtempo::anteil(z->modelle);   // TESTTEMPO: BHED_TEST_ANTEIL=i/n
                      testtempo::anteil(z->npcs);
                      z->anfang = std::chrono::steady_clock::now();
                      diag::detail("Knopftest: MB2 Bild " + spiel + " - " + std::to_string(z->modelle.size()) + " Modelle, " +
                                   std::to_string(z->npcs.size()) + " NPC-Typen");
                      return false;
                  }
                  // --- 1. die Pose je Modell -------------------------------------------------------------
                  if (z->i < z->modelle.size()) {
                      const std::string& pfad = z->modelle[z->i];
                      if ((b - 1) % 2 == 0) {
                          g_app->texCache.clear();
                          g_app->figurStufenBilder.clear();
                          std::string fehler;
                          if (!oeffneModellAusArchiv(pfad, &fehler)) {
                              ++z->poseOhne;
                              ++z->i;
                              return false;
                          }
                          // eine Animation mitten im Lauf, ein halbes Bild weiter (gemischt wie tr_ghoul2.cpp:1531)
                          int anim = mb1::animNach("BOTH_WALK1");
                          for (std::size_t k = 0; anim < 0 && k < g_app->animList.size(); ++k) {
                              if (g_app->animList[k].numFrames > 2) { anim = static_cast<int>(k); }
                          }
                          if (anim >= 0) {
                              animWaehlen(anim, false);
                              g_app->animFrame += g_app->animList[static_cast<std::size_t>(anim)].numFrames / 2;
                              g_app->animTime = 0.5F;
                          }
                          g_app->mtab.interpolieren = true;
                          // rc611: Stufe 0 wie der Mission-Tab-Weg hier (dasselbe gelesene Modell) - "automatisch wie im Spiel" nimmt im
                          // Model-Tab den Einzelspieler-Radius 40 (MERGE2), grosse Fahrzeuge bekamen Stufe 1 (siehe mb1 Bild).
                          g_app->mtab.lodWahl = 1;
                          return false;
                      }
                      std::vector<unsigned char> tab;
                      std::vector<unsigned char> mission;
                      bool ok = modellFotoPixel(kB, kH, tab, true);
                      // Der Mission-Tab-Weg: dasselbe gelesene Modell, Sichtbarkeit nach den Ghoul2-Regeln des
                      // Dokuments, Knochen ueber figurKnochen (frame, frameNext, frameFraction) wie die Zeichnung der Figuren.
                      GlmModel m = g_app->model;
                      for (std::size_t k = 0; k < m.surfaces.size() && k < g_app->mtab.gezeichnet.size(); ++k) {
                          m.surfaces[k].g2An = g_app->mtab.gezeichnet[k] != 0 ? 1 : 0;
                          m.surfaces[k].g2Kappen = m.surfaces[k].g2An;
                      }
                      std::vector<BoneMatrix> knochen;
                      if (!g_app->anim.bones.empty() && g_app->anim.numFrames > 0) {
                          ActorDraw d;
                          d.model = &m;
                          d.anim = &g_app->anim;
                          d.frame = std::clamp(g_app->animFrame, 0, g_app->anim.bildZahl() - 1);
                          // ohne animation.cfg (Abschnitte) steht die Figur auf ihrem Bild, ungemischt - wie im Model-Tab
                          if (g_app->animIndex >= 0) {
                              const AnimEntry& e = g_app->animList[static_cast<std::size_t>(g_app->animIndex)];
                              d.frameNext = d.frame + 1 < e.firstFrame + e.numFrames ? d.frame + 1 : d.frame;
                              d.frameFraction = 0.5F;
                          }
                          std::vector<BoneMatrix> welt;
                          std::vector<BoneMatrix> hilf;
                          if (figurKnochen(d, welt, hilf)) { gpu::baueKnochenmatrizen(welt, g_app->anim.bones, knochen); }
                          // Welcher Knochen steht anders (fuer die Liste der Abweichungen)?
                          float maxD = 0.0F;
                          int maxB = -1;
                          for (std::size_t k = 0; k < welt.size() && k < g_app->modellWelt.size(); ++k) {
                              for (int r = 0; r < 3; ++r) {
                                  for (int c = 0; c < 4; ++c) {
                                      const float dd = std::fabs(welt[k].m[r][c] - g_app->modellWelt[k].m[r][c]);
                                      if (dd > maxD) {
                                          maxD = dd;
                                          maxB = static_cast<int>(k);
                                      }
                                  }
                              }
                          }
                          {
                              char zg[240];
                              std::snprintf(zg, sizeof zg, "Knopftest: MB2 Bild - %s: Welt Tab %zu Mission %zu, LOD Tab %d von %d, Knochen %zu", pfad.c_str(),
                                            g_app->modellWelt.size(), welt.size(), g_app->mtab.lodJetzt, g_app->mtab.dok.inhalt().stufenZahl, knochen.size());
                              diag::detail(zg);
                          }
                          if (maxB >= 0) {
                              char zk[200];
                              std::snprintf(zk, sizeof zk, "Knopftest: MB2 Bild - %s: Knochen %s weicht um %.4f ab", pfad.c_str(),
                                            g_app->anim.bones[static_cast<std::size_t>(maxB)].name.c_str(), static_cast<double>(maxD));
                              diag::detail(zk);
                          }
                      }
                      float vp[16];
                      gpu::baueViewProj(g_app->modelCam, kB, kH, 1.0F, 8192.0F, vp);
                      gpu::modellZielWaehlen(5);
                      std::string fehler;
                      int w = 0;
                      int h = 0;
                      ok = ok && gpu::bereiteModellZiel(kB, kH) &&
                           gpu::zeichneModellAnsicht(m, (g_app->showModelTextures && g_app->modelTextures.found != 0) ? &g_app->modelTextures : nullptr,
                                                     knochen, vp, false, &fehler, gpu::ModellAnsichtArt{}, {}) >= 0 &&
                           gpu::leseModellZiel(mission, w, h);
                      const int d = ok ? unterschied(tab, mission) : -1;
                      if (d == 0) {
                          ++z->poseGleich;
                      } else {
                          ++z->poseAnders;
                          z->poseListe += pfad + " (" + std::to_string(d) + ") ";
                          if (!mb1::fotoOrdner().empty() && ok) {
                              std::string n = pfad;
                              std::replace(n.begin(), n.end(), '/', '_');
                              (void)modellBmp(mb1::fotoOrdner() + "\\mb2_tab_" + n + ".bmp", kB, kH, tab);
                              (void)modellBmp(mb1::fotoOrdner() + "\\mb2_mission_" + n + ".bmp", kB, kH, mission);
                          }
                      }
                      ++z->i;
                      return false;
                  }
                  // --- 2. Mission-Tab vorher/nachher je NPC-Typ ------------------------------------------
                  if (z->j < z->npcs.size()) {
                      const std::string& npc = z->npcs[z->j++];
                      g_app->texCache.clear();
                      g_app->figurStufenBilder.clear();
                      GlmModel neu;
                      std::string dir;
                      if (!figurModellWieMission(npc, neu, true, &dir)) {
                          ++z->missionOhne;
                          return false;
                      }
                      GlmModel alt = neu;
                      for (GlmSurface& sf : alt.surfaces) { sf.g2An = sf.g2Kappen = -1; }   // die Regel bis rc610
                      std::string anders;
                      for (std::size_t k = 0; k < neu.surfaces.size(); ++k) {
                          if (neu.surfaces[k].isVisible(false) != alt.surfaces[k].isVisible(false)) {
                              anders += neu.surfaces[k].name + (neu.surfaces[k].isVisible(false) ? "+" : "-") + " ";
                          }
                      }
                      const ModelTextures tex = texturesFor(neu);
                      Camera c;
                      c.fovY = 60.0F;
                      const float mitte[3] = {(neu.mins[0] + neu.maxs[0]) * 0.5F, (neu.mins[1] + neu.maxs[1]) * 0.5F, (neu.mins[2] + neu.maxs[2]) * 0.5F};
                      float gr = 8.0F;
                      for (int k = 0; k < 3; ++k) { gr = std::max(gr, neu.maxs[k] - neu.mins[k]); }
                      c.angles[1] = -90.0F;   // nach -Y: die Vorderseite (die Figur schaut in der .glm nach +Y)
                      c.pos[0] = mitte[0];
                      c.pos[1] = mitte[1] + gr * 1.2F;
                      c.pos[2] = mitte[2];
                      float vp[16];
                      gpu::baueViewProj(c, kB, kH, 1.0F, 8192.0F, vp);
                      gpu::modellZielWaehlen(5);
                      std::vector<unsigned char> pxAlt;
                      std::vector<unsigned char> pxNeu;
                      std::string fehler;
                      int w = 0;
                      int h = 0;
                      bool ok = gpu::bereiteModellZiel(kB, kH) &&
                                gpu::zeichneModellAnsicht(alt, tex.found != 0 ? &tex : nullptr, {}, vp, false, &fehler, gpu::ModellAnsichtArt{}, {}) >= 0 &&
                                gpu::leseModellZiel(pxAlt, w, h);
                      ok = ok && gpu::zeichneModellAnsicht(neu, tex.found != 0 ? &tex : nullptr, {}, vp, false, &fehler, gpu::ModellAnsichtArt{}, {}) >= 0 &&
                           gpu::leseModellZiel(pxNeu, w, h);
                      const int d = ok ? unterschied(pxAlt, pxNeu) : -1;
                      if (d == 0 && anders.empty()) {
                          ++z->missionGleich;
                      } else {
                          ++z->missionAnders;
                          // der Beleg: was die .npc schaltet (NPC_GetSurfaceParms), die Haut und das Spiel
                          const auto it = g_app->npcMap.find(npc);
                          const std::string beleg = it == g_app->npcMap.end() ? std::string()
                                                                              : " surfOff \"" + it->second.surfOff + "\" surfOn \"" + it->second.surfOn +
                                                                                    "\" customSkin " + it->second.customSkin + " Klasse " + it->second.klasse;
                          z->missionListe += npc + " -> " + dir + " (" + anders + std::to_string(d) + " Punkte;" + beleg + "); ";
                          if (!mb1::fotoOrdner().empty() && ok) {
                              (void)modellBmp(mb1::fotoOrdner() + "\\mb2_vorher_" + npc + ".bmp", kB, kH, pxAlt);
                              (void)modellBmp(mb1::fotoOrdner() + "\\mb2_nachher_" + npc + ".bmp", kB, kH, pxNeu);
                          }
                      }
                      return false;
                  }
                  const double sek = std::chrono::duration<double>(std::chrono::steady_clock::now() - z->anfang).count();
                  char zeile[600];
                  std::snprintf(zeile, sizeof zeile,
                                "Knopftest: MB2 Bild %s - Pose: %zu Modelle, gleich %d, anders %d, nicht ladbar %d; Mission: %zu NPC-Typen, gleich %d, "
                                "anders %d, ohne Modell %d; %.0f s",
                                spiel.c_str(), z->modelle.size(), z->poseGleich, z->poseAnders, z->poseOhne, z->npcs.size(), z->missionGleich,
                                z->missionAnders, z->missionOhne, sek);
                  diag::detail(zeile);
                  if (!z->poseListe.empty()) { diag::detail("Knopftest: MB2 Bild Pose anders: " + z->poseListe); }
                  if (!z->missionListe.empty()) { diag::detail("Knopftest: MB2 Bild Mission vorher/nachher anders: " + z->missionListe); }
                  pruefeWahr(!z->modelle.empty() && z->poseAnders == 0, "MB2 Bild " + spiel + ": die Pose ueber den Model-Tab bildgleich mit dem Mission-Tab-Weg");
                  pruefeWahr(!z->npcs.empty(), "MB2 Bild " + spiel + ": Mission-Tab vorher/nachher fuer jeden NPC-Typ verglichen (Abweichungen im Protokoll)");
                  return true;
              }};
    s.eigeneZeitgrenze = true;
    return s;
}

// Bilder fuer die Handbuchseiten (BHED_HB_NUR=mb1a2): Fenster Ins Skript, Symbole im Explorer,
// Bedienung wie Blender (eine Ansicht, Oktaeder, Zaehlung ab 1).
std::vector<Schritt> handbuchSchritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    for (Schritt& x : mb1::laden("models/players/stormtrooper/model.glm")) { add(std::move(x)); }
    auto teiler = std::make_shared<float>(0.0F);
    add(tu("MB2 Handbuch: Weights, Knochen rhumerus, BOTH_WALK1 Bild 8, Pinsel ueber dem rechten Arm", [=] {
        *teiler = g_app->settings.splitModel;
        g_app->settings.splitModel = 0.85F;
        animWaehlen(mb1::animNach("BOTH_WALK1"), false);
        g_app->animFrame += 8;
        g_app->mtab.bereich = ModellBereich::Weights;
        g_app->mtab.knochenWahl = boneIndex(g_app->anim, "rhumerus");
        g_app->mtab.pinselRadius = 40.0F;
        g_app->mtab.ansichten[g_app->mtab.aktiv].art = AnsichtArt::Vorne;   // der rechte Arm zur Kamera
        modellAnsichtEinpassenAktiv();
        g_app->modelDirty = true;
    }));
    add(pause(0.6));
    add(tu("MB2 Handbuch: Maus ueber den rechten Arm", [] {
        ImVec2 p;
        if (modellFlaecheAufSchirm(teil("r_arm"), p)) { setzeMaus(p); }
    }));
    add(pause(0.4));
    // AP14b: die Bilder h_mb2_weights und h_mb2_kontext zeigt das Handbuch nicht mehr (die Seite modell-weights ist seit AP8 die von
    // inhalt_ap8) - die Schritte davor bleiben, damit die folgenden Bilder denselben Stand haben
    // Am Kopf, oben in der Ansicht: das Menue ist hoch, und ragt es ueber das Hauptfenster hinaus, wird es ein eigenes
    // Fenster (Viewports) und fehlt auf dem Foto (mb2_hb_mb1a2_*: am Rumpf geklickt, Menue offen, Foto ohne Menue).
    add(klickAn("MB2 Handbuch: Rechtsklick in die Ansicht", [] {
        ImVec2 p;
        (void)modellFlaecheAufSchirm(teil("head"), p);
        return p;
    }, 1));
    add(warteBis("MB2 Handbuch: das Rechtsklick-Menue ist offen", [] { return g_app->mtab.kontextSichtbar; }, 300));
    add(pause(0.3));
    add(tu("MB2 Handbuch: wo steht das Menue", [] {
        const ImGuiContext& g = *ImGui::GetCurrentContext();
        std::string z = "Knopftest: MB2 Handbuch - Menue offen " + std::to_string(g_app->mtab.kontextSichtbar ? 1 : 0) + ", Popups " +
                        std::to_string(g.OpenPopupStack.Size);
        for (const ImGuiPopupData& p : g.OpenPopupStack) {
            const ImGuiWindow* w = p.Window;
            if (w == nullptr) { continue; }
            char b[200];
            std::snprintf(b, sizeof b, " [%s %.0f/%.0f %.0fx%.0f eigenes Fenster %d]", w->Name, static_cast<double>(w->Pos.x), static_cast<double>(w->Pos.y),
                          static_cast<double>(w->Size.x), static_cast<double>(w->Size.y), w->Viewport != ImGui::GetMainViewport() ? 1 : 0);
            z += b;
        }
        diag::detail(z);
    }));
    add(tasteKombi(ImGuiKey_Escape, "Esc"));
    add(tu("MB2 Handbuch: Fenster Ins Skript mit BOTH_WALK1, Figur kyle", [] {
        g_app->mtab.bereich = ModellBereich::Ansehen;
        modellInsSkriptOeffnen(mb1::animNach("BOTH_WALK1"));
        std::snprintf(g_app->mtab.insFigur, sizeof g_app->mtab.insFigur, "%s", "kyle");
        g_app->modelDirty = true;
    }));
    add(pause(0.6));
    add(hilfe2::schrittFoto("h_mb2_insskript"));
    add(tu("MB2 Handbuch: Fenster zu, Kopf ueber das Auge ausgeblendet, Knochen offen", [] {
        g_app->settings.insSkriptOffen = false;
        modellTeilAuge(teil("head"), false);
        g_app->modellKnochen = true;
        g_app->modelDirty = true;
    }));
    add(pause(0.3));
    add(tu("MB2 Handbuch: den Explorer zur ausgeblendeten Zeile head rollen", [] {
        const Element* e = finde("head", "", 0, false);
        ImGuiWindow* w = e != nullptr ? ImGui::FindWindowByName(e->innen.c_str()) : nullptr;
        if (w == nullptr) { return; }
        const float d = e->rect.GetCenter().y - (e->clip.Min.y + e->clip.Max.y) * 0.5F;
        ImGui::SetScrollY(w, std::clamp(w->Scroll.y + d, 0.0F, w->ScrollMax.y));
    }));
    add(pause(0.6));
    add(hilfe2::schrittFoto("h_mb2_auge"));
    add(tu("MB2 Handbuch: alle einblenden", [] { modellAllesEinblenden(); }));
    add(tu("MB2 Handbuch: Fenster zu, Bedienung wie Blender, Knochen, Ecken gewaehlt", [] {
        g_app->settings.insSkriptOffen = false;
        modellBedienungSetzen(1);
        g_app->modellKnochen = true;
        modellAuswahlArtSetzen(AuswahlArt::Ecke);
        g_app->modelDirty = true;
    }));
    add(pause(0.6));
    add(hilfe2::schrittFoto("h_mb2_blender"));
    add(tu("MB2 Handbuch: zurueck", [=] {
        g_app->settings.splitModel = *teiler;
        modellBedienungSetzen(0);
        modellAuswahlArtSetzen(AuswahlArt::Objekt);
        g_app->modellKnochen = false;
        g_app->leftMode = 1;
        g_app->doc.markSaved();
    }));
    add(pause(0.2));
    return s;
}

std::vector<Schritt> schritte(const std::string& n) {
    std::vector<Schritt> s;
    if (n == "bild2") {
        const char* sp = std::getenv("BHED_MB_SPIEL");
        const std::string spiel = sp != nullptr ? sp : "md";
        s.push_back(tu("MB2 Bild: Spiel " + spiel, [=] {
            g_app->leftMode = 2;
            openScriptFromMemory("//Generated by BehavEd\nwait ( 1000.000 );\n", "mb2.txt");
            if (spiel != "md") { mb1::spielSetzen(spiel); }
            if (g_app->gamePaths.empty()) { rescanGamePaths(); }
        }));
        s.push_back(pause(0.5));
        s.push_back(bildVergleich2(spiel));
        s.push_back(tu("MB2 Bild: zurueck", [] {
            g_app->leftMode = 1;
            g_app->mtab.lodWahl = 0;   // wieder automatisch
            g_app->doc.markSaved();
        }));
        return s;
    }
    if (n == "mb2") {
        for (Schritt& x : mb2Schritte()) { s.push_back(std::move(x)); }
    }
    if (n == "blender") {
        for (Schritt& x : blenderSchritte()) { s.push_back(std::move(x)); }
    }
    if (n == "haut") {   // P62
        for (Schritt& x : hautSchritte()) { s.push_back(std::move(x)); }
    }
    return s;
}

