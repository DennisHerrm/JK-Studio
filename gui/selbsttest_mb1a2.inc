        {ImGuiKey_Keypad4, "Ziffernblock 4", [=] { return art(AnsichtArt::Perspektive); }},
        {ImGuiKey_Keypad6, "Ziffernblock 6", [=] { return art(AnsichtArt::Perspektive); }},
        {ImGuiKey_Keypad8, "Ziffernblock 8", [=] { return art(AnsichtArt::Perspektive); }},
        {ImGuiKey_Keypad2, "Ziffernblock 2", [=] { return art(AnsichtArt::Perspektive); }},
        {ImGuiKey_KeypadDecimal, "Ziffernblock ,", [] {
             float m[3];
             return modellAuswahlMitte(m);
         }},
        {ImGuiKey_Home, "Pos1", [] { return !g_app->mtab.auswahl.empty(); }},
        {ImGuiMod_Ctrl | ImGuiMod_Alt | ImGuiKey_Q, "Strg+Alt+Q", [] { return g_app->mtab.vierAnsichten; }},
        {ImGuiMod_Ctrl | ImGuiMod_Alt | ImGuiKey_Q, "Strg+Alt+Q", [] { return !g_app->mtab.vierAnsichten; }},
