            g_app->mtab.pinselGewicht = 0.2F;
            (void)modellEckeAufSchirm(teil("torso"), *ecke, *ort);
            (void)modellTupfer(g_app->mtab.aktiv, *ort, true);
            modellStrichEnde();
        }
    }));
    add(pruefe("MB2 Weights: Pruefhilfe zaehlt die Ecke mit mehr als 4 Gewichten", [] { return modell::eckenUeberVier(*netz(teil("torso"))) >= 1; }));
    add(pruefe("MB2 Weights: die Figur zeigt dabei hoechstens 4 Gewichte, Summe 1", [ecke] {
        const GlmVertex& v = g_app->mtab.anzeige.surfaces[static_cast<std::size_t>(teil("torso"))].verts[static_cast<std::size_t>(*ecke)];
        float summe = 0.0F;
