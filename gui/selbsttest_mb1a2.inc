        return std::fabs(summe - 1.0F) < 1e-6F;
    }));
    add(tu("MB2 Weights: Uebernehmen", [] { (void)modellUebernehmen(); }));
    add(pruefe("MB2 Weights: Uebernehmen: keine Malliste, die Ecke traegt 4 Gewichte wie G2_GetVertBoneWeight", [ecke] {
        const modell::Netz* n = netz(teil("torso"));
        const modell::Ecke& e = n->ecken[static_cast<std::size_t>(*ecke)];
