        int n = 0;
        for (const modell::Teil& t : g_app->mtab.dok.inhalt().teile) {
            if (static_cast<std::size_t>(g_app->mtab.lodJetzt) < t.stufen.size() && !t.stufen[static_cast<std::size_t>(g_app->mtab.lodJetzt)].mal.empty()) {
