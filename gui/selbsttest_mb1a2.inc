        int anders = 0;
        int geprueft = 0;
        for (const modell::Teil& t : in.teile) {
            if (t.istTag() || static_cast<std::size_t>(g_app->mtab.lodJetzt) >= t.stufen.size()) { continue; }
            const modell::Netz& n = t.stufen[static_cast<std::size_t>(g_app->mtab.lodJetzt)];
