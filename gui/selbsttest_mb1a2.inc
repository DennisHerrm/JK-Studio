    add(tu("MB2 Weights: fuenf weitere Knochen auf die Ecke (Setzen)", [ort, ecke] {
        g_app->mtab.pinselArt = static_cast<int>(modell::PinselArt::Setzen);
        for (const char* k : {"lhand", "cranium", "pelvis", "thoracic", "cervical"}) {
