// selbsttest_pruefung3.inc - Pruefung 3: der Rest gegen das Spiel, im
// laufenden Programm (Modus "pruefung3").
//
// Je Punkt eine eigene Mission auf der Geometrie von md_am_sith (New mission,
// eigene Entities, eigenes Skript - nichts aus der Original-Mission), und je
// Punkt eine Probe gegen die Formel der Engine mit dem echten Skelett der
// Figur.
//
// 1. Rumpfwinkel: renderInfo.torsoAngles aus dem chestBolt (cg_players.cpp:
//    7516-7527 OJ) - eine Figur, die auf dem Ruecken liegt (BOTH_SLEEP1),
//    stirbt mit BOTH_DEATH_LYING_UP; die Probe rechnet den Winkel aus dem
//    Bolzen des gezeichneten Skeletts nach.
namespace pruefung3 {

struct Zustand {
    std::string mdArchiv;
    float ort[3]{};       // Startort einer laufenden Figur der Grundkarte (begehbar)
    std::string typ;      // ihr NPC_type
    bool bereit = false;
    std::string fehler;
};

// Eine Figur der Szene mit diesem Namen, -1 sonst.
int figur(const std::string& name) {
    for (std::size_t i = 0; i < g_app->scene.actors.size(); ++i) {
        if (g_app->scene.actors[i].name == name) { return static_cast<int>(i); }
    }
    return -1;
}

// Eine neue Mission `name` auf md_am_sith mit Figuren (Name, Versatz in x,
// Gierwinkel) am gemerkten Ort und dem Skript `skript` (ohne Kopfzeile).
void szeneBauen(Zustand& z, const std::string& name, const std::vector<std::tuple<std::string, float, float>>& figuren,
                const std::string& skript) {
    z.bereit = false;
    const std::string wurzel = mb::verbinde(mb::laufOrdner(), "missionen");
    _putenv_s("BHED_MISSIONEN", wurzel.c_str());
    std::string f;
    if (!neueMissionAnlegen("maps/md_am_sith.bsp", name, name, &f)) {
        z.fehler += " New mission " + name + ": " + f;
        return;
    }
    for (const auto& [n, dx, gier] : figuren) {
        const float o[3] = {z.ort[0] + dx, z.ort[1], z.ort[2]};
        const int e = neueEntityAn("NPC_spawner", o);
        if (e < 0) {
            z.fehler += " Figur " + n + " nicht angelegt";
            return;
        }
        (void)entityKeySetzen(e, "NPC_type", z.typ);
        (void)entityKeySetzen(e, "NPC_targetname", n);
        (void)entityKeySetzen(e, "angle", std::to_string(static_cast<int>(gier)));
    }
    Script neu;
    std::vector<Diag> d;
    if (!readScript("//Generated by BehavEd\r\n\r\n" + skript, neu, d)) {
        z.fehler += " Skript von " + name + " nicht lesbar";
        return;
    }
    g_app->doc.ersetzeSkript(std::move(neu), "Pruefung 3");
    rebuildTree();
    g_app->camTrackValid = false;
    g_app->mapDirty = true;
    z.bereit = true;
}

std::string grad(float w) {
    char b[32];
    std::snprintf(b, sizeof b, "%.2f", static_cast<double>(w));
    return b;
}

}  // namespace pruefung3

std::vector<Schritt> pruefung3Schritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto z = std::make_shared<pruefung3::Zustand>();
    add(tu("Pruefung3: Ausgangslage (eingerichtete Spielordner mit Movie Duels)", [=] {
        for (const std::string& o : g_app->settings.gamePaths) {
            std::error_code ec;
            if (z->mdArchiv.empty() && std::filesystem::is_regular_file(::bhed::utf8Pfad(o + "\\assets1.pk3"), ec)) {
                z->mdArchiv = o + "\\assets1.pk3";
            }
        }
        g_app->leftMode = 1;
        g_app->missionPickOpen = false;
        diag::detail("Knopftest: Pruefung3 - Archiv \"" + z->mdArchiv + "\"");
    }));
    add(tu("Pruefung3: Grundkarte md_am_sith laden", [=] {
        mission1::ungespeicherteEntitiesVergessen();
        missionenAusArchiv(z->mdArchiv, "md_am_sith");
    }));
    add(warteBis("Pruefung3: Grundkarte geladen", [] {
        return g_app->map.path == "maps/md_am_sith.bsp" && g_app->camTrackValid && jk2probe::figurenGeladen();
    }, 4000));
    add(tu("Pruefung3: begehbaren Ort und NPC_type einer laufenden Figur merken", [=] {
        prepareScene();
        for (std::size_t ai = 0; ai < g_app->scene.actors.size() && z->typ.empty(); ++ai) {
            const Actor& a = g_app->scene.actors[ai];
            for (const ActorStep& st : a.steps) {
                if (z->typ.empty() && st.kind == ActorStep::Kind::WalkTo && !a.npcType.empty() && ai < g_app->actorAssets.size() &&
                    g_app->actorAssets[ai] && !g_app->actorAssets[ai]->model.empty()) {
                    for (int k = 0; k < 3; ++k) { z->ort[k] = st.from[k]; }
                    z->typ = a.npcType;
                }
            }
        }
        diag::detail("Knopftest: Pruefung3 - Ort " + mission1::v3(z->ort) + ", NPC_type " + z->typ);
    }));

    // --- 1. Rumpfwinkel aus dem chestBolt -----------------------------------
    // p3_ruecken liegt auf dem Ruecken (BOTH_DEADBACKWARD1), p3_schlaeft in
    // BOTH_SLEEP1 - beide PM_InOnGroundAnim; G_CheckSpecialDeathAnim waehlt nach
    // AngleNormalize180(torsoAngles[PITCH]) < 0 LYING_UP, sonst LYING_DN. Der
    // Winkel kommt aus den Bildern der .gla (bei BOTH_SLEEP1 zeigt die Brust
    // nach vorn, nicht nach oben - die Probe rechnet ihn nach, statt ihn zu raten).
    add(tu("Pruefung3 1: Mission p3rumpf - p3_ruecken und p3_schlaeft liegen und werden getoetet, p3_steht steht", [=] {
        const auto liegt = [](const char* name, const char* anim) {
            return std::string("affect ( \"") + name + "\", /*@AFFECT_TYPE*/ FLUSH )\r\n{\r\n"
                   "\tset ( /*@SET_TYPES*/ \"SET_BEHAVIOR_STATE\", \"BS_CINEMATIC\" );\r\n"
                   "\tset ( /*@SET_TYPES*/ \"SET_ANIM_BOTH\", \"" + anim + "\" );\r\n"
                   "\tset ( /*@SET_TYPES*/ \"SET_ANIM_HOLDTIME_BOTH\", -1 );\r\n"
                   "\twait ( 1500.000 );\r\n"
                   "\tkill ( \"" + name + "\" );\r\n}\r\n\r\n";
        };
        pruefung3::szeneBauen(*z, "p3rumpf", {{"p3_ruecken", 0.0F, 0.0F}, {"p3_schlaeft", 96.0F, 0.0F}, {"p3_steht", 192.0F, 90.0F}},
                              liegt("p3_ruecken", "BOTH_DEADBACKWARD1") + liegt("p3_schlaeft", "BOTH_SLEEP1") +
                                  "affect ( \"p3_steht\", /*@AFFECT_TYPE*/ FLUSH )\r\n{\r\n"
                                  "\tset ( /*@SET_TYPES*/ \"SET_BEHAVIOR_STATE\", \"BS_CINEMATIC\" );\r\n"
                                  "\twait ( 3000.000 );\r\n}\r\n");
    }));
    add(warteBis("Pruefung3 1: Szene von p3rumpf", [=] {
        return !z->bereit || (g_app->camTrackValid && pruefung3::figur("p3_ruecken") >= 0 && jk2probe::figurenGeladen());
    }, 2000));
    add(pause(0.5));
    add(pruefe("Pruefung3 1: stehend zeigt der Rumpf (chestBolt, NEGATIVE_Z) nach vorn - Gier wie die Figur, kaum Neigung", [=] {
        prepareScene();
        const int i = pruefung3::figur("p3_steht");
        if (i < 0 || static_cast<std::size_t>(i) >= g_app->actorAssets.size() || !g_app->actorAssets[static_cast<std::size_t>(i)]) {
            return false;
        }
        const Actor& a = g_app->scene.actors[static_cast<std::size_t>(i)];
        float w[3]{};
        const bool da = figurRumpfWinkel(a, *g_app->actorAssets[static_cast<std::size_t>(i)], 1000.0, w);
        const float gier = a.at(1000.0).angles[1];
        const float d = std::fabs(std::remainder(w[1] - gier, 360.0F));
        const float nick = std::remainder(w[0], 360.0F);
        diag::detail("Knopftest: Pruefung3 1 - p3_steht " + a.at(1000.0).animation + " (" + g_app->actorAssets[static_cast<std::size_t>(i)]->model.animFile +
                     "): torsoAngles " + pruefung3::grad(w[0]) + " " + pruefung3::grad(w[1]) + ", Figur " + pruefung3::grad(gier) +
                     (z->fehler.empty() ? "" : ", Fehler:" + z->fehler));
        return z->bereit && da && d < 30.0F && std::fabs(nick) < 30.0F;
    }));
    for (const char* name : {"p3_ruecken", "p3_schlaeft"}) {
        const bool ruecken = std::string(name) == "p3_ruecken";
        add(pruefe(std::string("Pruefung3 1: ") + name + " getoetet - Todesanimation nach dem Vorzeichen von torsoAngles PITCH aus dem Skelett" +
                       (ruecken ? " (auf dem Ruecken: < 0, BOTH_DEATH_LYING_UP)" : ""),
                   [=] {
                       const int i = pruefung3::figur(name);
                       if (i < 0 || static_cast<std::size_t>(i) >= g_app->actorAssets.size() ||
                           !g_app->actorAssets[static_cast<std::size_t>(i)]) {
                           return false;
                       }
                       const Actor& a = g_app->scene.actors[static_cast<std::size_t>(i)];
                       const double tod = a.getoetetMs;
                       float w[3]{};
                       const bool da = tod > 0.0 && figurRumpfWinkel(a, *g_app->actorAssets[static_cast<std::size_t>(i)], tod - 1.0, w);
                       // AngleNormalize180(torsoAngles[PITCH]) < 0 -> BOTH_DEATH_LYING_UP (G_CheckSpecialDeathAnim)
                       const bool nachOben = std::remainder(w[0], 360.0F) < 0.0F;
                       const std::string anim = tod > 0.0 ? a.at(tod + 100.0).animation : std::string();
                       diag::detail(std::string("Knopftest: Pruefung3 1 - ") + name + " getoetet bei " + pruefung3::grad(static_cast<float>(tod)) +
                                    " ms in " + (tod > 0.0 ? a.at(tod - 1.0).animation : std::string("?")) + ": torsoAngles " +
                                    pruefung3::grad(w[0]) + " " + pruefung3::grad(w[1]) + " -> " + anim);
                       return da && (!ruecken || nachOben) && anim == (nachOben ? "BOTH_DEATH_LYING_UP" : "BOTH_DEATH_LYING_DN");
                   }));
    }
    // --- 3. Gemeinsamer Markenspeicher -------------------------------------
    // Ein eigener Effekt mit einem Decal (gfx/damage/rivetmark) auf dem Boden:
    // CG_ImpactMark legt es in den Markenspeicher der Brandspuren
    // (cg_markPolys), CG_AddMarks zeichnet es - also zaehlt es der Zeichner
    // der Marken, nicht das Effektnetz.
    auto marke = std::make_shared<double>(-1.0);
    add(tu("Pruefung3 3: eigener Effekt p3/brandmarke.efx (ein Decal) als pk3 in einen eigenen Spielordner", [=] {
        const std::string efx = "Decal\n{\n\tlife\t\t1000 1000\n\tshaders\n\t[\n\t\tgfx/damage/rivetmark\n\t]\n"
                                "\tsize\n\t{\n\t\tstart 24\n\t}\n}\n";
        const std::string spiel = mb::verbinde(mb::laufOrdner(), "p3spiel");
        std::error_code ec;
        std::filesystem::create_directories(::bhed::utf8Pfad(spiel), ec);
        std::string f;
        if (writePk3(mb::verbinde(spiel, "zz_p3marke.pk3"), {{"effects/p3/brandmarke.efx", efx}}, &f)) {
            g_app->settings.gamePaths.push_back(spiel);
            rescanGamePaths();
            refreshPk3List();
        } else {
            z->fehler += " Effekt-pk3: " + f;
        }
    }));
    add(tu("Pruefung3 3: Mission p3marke - ein fx_runner mit dem Decal, nach oben gerichtet, auf einer ebenen Bodenflaeche", [=] {
        pruefung3::szeneBauen(*z, "p3marke", {}, "");
        // Die naechste ebene, waagrechte Flaeche der Karte (R_MarkFragments
        // schneidet auf Flaechen der .bsp, nicht auf Modelle).
        float o[3] = {z->ort[0], z->ort[1], z->ort[2] - 23.0F};
        float best = 1.0e30F;
        for (const BspSurface& f : g_app->geo.surfaces) {
            if (f.type != BspSurface::Type::Planar || f.ebenenNormale[2] < 0.99F || f.numVerts < 3) { continue; }
            float m[3] = {0.0F, 0.0F, 0.0F};
            for (int v = 0; v < f.numVerts; ++v) {
                for (int k = 0; k < 3; ++k) { m[k] += g_app->geo.verts[static_cast<std::size_t>(f.firstVert + v)].xyz[k] / static_cast<float>(f.numVerts); }
            }
            const float d = (m[0] - z->ort[0]) * (m[0] - z->ort[0]) + (m[1] - z->ort[1]) * (m[1] - z->ort[1]) + (m[2] - z->ort[2]) * (m[2] - z->ort[2]);
            if (d < best) {
                best = d;
                o[0] = m[0];
                o[1] = m[1];
                o[2] = m[2] + 1.0F;
            }
        }
        diag::detail("Knopftest: Pruefung3 3 - Runner auf der Flaeche bei " + mission1::v3(o));
        const int e = neueEntityAn("fx_runner", o);
        if (e < 0) {
            z->fehler += " fx_runner nicht angelegt";
            return;
        }
        (void)entityKeySetzen(e, "fxFile", "p3/brandmarke");
        (void)entityKeySetzen(e, "angles", "-90 0 0");
        g_app->mapDirty = true;
        g_app->camTrackValid = false;
    }));
    add(warteBis("Pruefung3 3: Szene von p3marke mit dem fx_runner", [=] {
        if (!z->bereit) { return true; }
        const efx::Effect* fx = effectByName("p3/brandmarke");
        for (const EffectInstance& in : g_app->effectRunners) {
            if (fx != nullptr && in.effect == fx) {
                *marke = in.startMs;
                return g_app->camTrackValid;
            }
        }
        return false;
    }, 2000));
    add(tu("Pruefung3 3: 500 ms nach dem Start des Runners zeichnen, Markenzaehler auf 0", [=] {
        g_app->showEffects = true;
        g_app->playing = false;
        g_app->playMs = std::max(0.0, *marke) + 500.0;
        g_saberSpurenGezeichnet = 0;
        g_app->mapDirty = true;
    }));
    add(pause(0.5));
    add(pruefe("Pruefung3 3: das Decal liegt im Markenspeicher (CG_ImpactMark) und wird mit den Brandspuren gezeichnet (CG_AddMarks)", [=] {
        diag::detail("Knopftest: Pruefung3 3 - Runner bei " + pruefung3::grad(static_cast<float>(*marke)) + " ms, gezeichnete Marken " +
                     std::to_string(g_saberSpurenGezeichnet) + ", Marken im Speicher " +
                     std::to_string(saberSpurenBei(g_app->playMs, &g_app->effectRunners).size()) + ", Decals bis jetzt " +
                     std::to_string(effektMarkenIn(g_app->effectRunners, -1.0, g_app->playMs, &g_app->geo).size()) +
                     (z->fehler.empty() ? "" : ", Fehler:" + z->fehler));
        return *marke >= 0.0 && g_saberSpurenGezeichnet > 0;
    }));
    return s;
}
