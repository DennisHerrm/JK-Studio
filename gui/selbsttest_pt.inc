    add(pause(0.3));
    add(pruefe("PT Radieren: die Ebene wird durchsichtig, weniger Texel bemalt", [st] {
        const int n = geaendert(lw());
        diag::detail("Knopftest: PT Radieren - vorher " + std::to_string(st->n) + ", nachher " + std::to_string(n) + " Texel");
        return n < st->n / 2;
    }));
