// --- zeitleiste1: die neue Zeitleiste im Mission-Tab (BHED_EDITORTEST=zeitleiste1) ---
//
// Prueft die Zeitleiste nach dem freigegebenen Entwurf mit echter Maus:
//   1. eine selbst gebaute Mini-Szene (eigene Namen, jede Befehlsart einmal,
//      ohne Karte): Zeilen, Lesbarkeit (Mindesthoehe, keine Ueberlappung der
//      Beschriftungen), Filter, Suche, Zoom, Navigationsleiste, Tasten,
//      "Was passiert hier?" mit "Skriptzeile oeffnen", Ziehen mit einem
//      Rueckgaengig-Schritt je Zug (Skripttext bytegleich zurueck);
//   2. academy1/intro (reines JKA) und md_am_sith/intro2_sith (Movie Duels):
//      Fotos beider Ansichten, Gegenprobe der Zahlen mit dem Export
//      zeitleiste0, Anfangsausschnitt, Bildzeit.
namespace zl1 {

float yVon(const std::string& zeile) {
    for (const auto& [n, y] : g_app->tlZeilenY) {
        if (n == zeile) { return y; }
    }
    return -1000.0F;
}
float xVon(double ms) {
    return g_app->tlFeldX + static_cast<float>((ms - g_app->tlSichtStart) / g_app->tlSichtSpanne) * g_app->tlFeldW;
}
std::string zeilenListe() {
    std::string z;
    for (const auto& [n, y] : g_app->tlZeilenY) { z += " [" + n + "]"; }
    return z;
}
std::string skriptText() { return writeScript(g_app->doc.script()); }
double argVon(const Path& p, std::size_t i = 0) {
    const Node* n = nodeAt(g_app->doc.script(), p);
    return (n != nullptr && n->args.size() > i) ? std::atof(n->args[i].text.c_str()) : -1.0;
}
const App::ZlBlock* blockMit(const std::string& zeile, const Path& pfad) {
    for (const App::ZlBlock& b : g_app->zlBloecke) {
        if (b.zeile == zeile && b.pfad == pfad) { return &b; }
    }
    return nullptr;
}
// Ein Punkt im gezeichneten Block (Anteil der Breite) - Zeilen mit Unterbahnen
// haben ihre Bloecke nicht auf der Zeilenmitte.
ImVec2 imBlock(const std::string& zeile, const Path& pfad, float anteil) {
    const App::ZlBlock* b = blockMit(zeile, pfad);
    if (b == nullptr) { return ImVec2{-1.0F, -1.0F}; }
    return ImVec2{b->r.Min.x + b->r.GetWidth() * anteil, b->r.GetCenter().y};
}

// Lesbarkeit: jeder Block mindestens eine Schriftzeile hoch, keine zwei
// Beschriftungen uebereinander.
bool lesbar(const std::string& wo) {
    const float fs = ImGui::GetFontSize();
    float minH = 1.0e9F;
    for (const App::ZlBlock& b : g_app->zlBloecke) { minH = std::min(minH, b.r.GetHeight()); }
    int ueber = 0;
    const std::vector<App::ZlText>& t = g_app->zlBeschriftungen;
    for (std::size_t i = 0; i < t.size(); ++i) {
        for (std::size_t j = i + 1; j < t.size(); ++j) {
            ImRect a = t[i].r;
            ImRect b = t[j].r;
            a.Expand(-0.5F);
            b.Expand(-0.5F);
            if (a.Overlaps(b)) {
                ++ueber;
                if (ueber <= 3) {
                    diag::detail("Knopftest: zeitleiste1 - Beschriftungen ueberlappen bei x " + std::to_string(t[i].r.Min.x) + " / " +
                                 std::to_string(t[j].r.Min.x) + ", y " + std::to_string(t[i].r.Min.y));
                }
            }
        }
    }
    diag::detail("Knopftest: zeitleiste1 - " + wo + ": " + std::to_string(g_app->zlBloecke.size()) + " Bloecke/Marken, kleinste Hoehe " +
                 std::to_string(minH) + " px (Schrift " + std::to_string(fs) + "), " + std::to_string(t.size()) +
                 " Beschriftungen, " + std::to_string(ueber) + " ueberlappen");
    return !g_app->zlBloecke.empty() && minH >= fs * 1.0F - 0.5F && ueber == 0;
}

// Bildzeit: Mittel ueber n Bilder (unter Last durch andere Laeufe!).
struct Messung {
    int bilder = 0;
    double summe = 0.0;
    double spitze = 0.0;
    double zeichnen = 0.0;
};
Schritt bildzeit(const std::string& was, std::shared_ptr<Messung> m, int n) {
    return {"zeitleiste1: Bildzeit " + was, [=](int b) {
                if (b == 0) {
                    *m = Messung{};
                    return false;
                }
                const double dt = static_cast<double>(ImGui::GetIO().DeltaTime) * 1000.0;
                if (b > 3) {
                    ++m->bilder;
                    m->summe += dt;
                    m->spitze = std::max(m->spitze, dt);
                    m->zeichnen += static_cast<double>(g_app->zlZeichenMs);
                    g_app->mapDirty = true;
                }
                if (m->bilder < n) { return false; }
                char z[240];
                std::snprintf(z, sizeof(z), "Knopftest: zeitleiste1 - Bildzeit %s: %.2f ms im Mittel, Spitze %.1f ms, Zeitleiste %.3f ms (%d Bilder, unter Last)",
                              was.c_str(), m->summe / m->bilder, m->spitze, m->zeichnen / m->bilder, m->bilder);
                diag::detail(z);
                return true;
            }};
}

