// Zeitleiste 2 Punkt 1: Aufnehmen. Eine Taste n Bilder lang halten (mit Umschalt: gehen).
// Mit genug schon los, sobald genug() gilt (Integration 5: nach einem festen Weg).
// Zeitleiste 3 zaehlte dafuer Proben - die kommen aber je Bild, sobald die Figur
// >= 4 Einheiten weiter ist, und hingen so noch an der Bildzeit: unter Last lief
// guard1 auf md_am_sith mit 45 Proben 492 statt 331 Einheiten weit, hinter das
// Wegenetz ("finds no path", die Figur bleibt wie im Spiel stehen).
Schritt halteTaste(ImGuiKey taste, int bilder, bool umschalt, const std::string& name, std::function<bool()> genug = {}) {
    return {"zeitleiste1 Aufnahme: " + name + " halten", [=](int b) {
                ImGuiIO& io = ImGui::GetIO();
                if (b == 0) {
                    if (umschalt) { io.AddKeyEvent(ImGuiMod_Shift, true); }
                    io.AddKeyEvent(taste, true);
                    return false;
                }
                if (b < bilder && !(genug && genug())) { return false; }
                io.AddKeyEvent(taste, false);
                if (umschalt) { io.AddKeyEvent(ImGuiMod_Shift, false); }
                return b > bilder + 1;
            }};
}

// Zeitleiste 4 Punkt 3: was das Modell waehrend der Aufnahme zeigt, je Bild.
struct ModellProbe {
    std::string beine;
    std::string vorher;     // von welcher Animation die Beine zuletzt blendeten (leer: keiner)
    double blendMs = 0.0;
    std::string torso;      // leer: folgt den Beinen
    float rumpf = 0.0F;     // der Rumpf gegen die Beine
    bool gedrueckt = false; // gemessen, solange die Tasten gehalten werden
};
ModellProbe modellJetzt(int figur) {
    ModellProbe p;
    if (figur < 0 || static_cast<std::size_t>(figur) >= g_app->scene.actors.size()) { return p; }
    ActorState st = g_app->scene.actors[static_cast<std::size_t>(figur)].at(g_app->playMs);
    aufnahmeFigurZustand(figur, g_app->playMs, st);
    p.beine = st.animation;
    p.vorher = st.prevAnimation;
    p.blendMs = st.blendMs;
    p.torso = st.torsoAnimation;
    p.rumpf = st.rumpfGier;
    return p;
}
// Die letzte Probe mit gehaltenen Tasten.
const ModellProbe& gehalten(const std::vector<ModellProbe>& p) {
    for (std::size_t i = p.size(); i > 0; --i) {
        if (p[i - 1].gedrueckt) { return p[i - 1]; }
    }
    return p.front();
}
// Tasten halten (mit Umschalt) und je Bild messen; probe[0] ist vor dem Druecken.
Schritt halteUndMiss(std::initializer_list<ImGuiKey> tasten, int bilder, bool umschalt, const std::string& name, std::function<int()> figur,
                     std::shared_ptr<std::vector<ModellProbe>> proben) {
    const std::vector<ImGuiKey> t(tasten);
    return {"zeitleiste1 Aufnahme: " + name + " halten und das Modell messen", [=](int b) {
                ImGuiIO& io = ImGui::GetIO();
                if (b == 0) {
                    proben->assign(1, modellJetzt(figur()));
                    if (umschalt) { io.AddKeyEvent(ImGuiMod_Shift, true); }
                    for (const ImGuiKey k : t) { io.AddKeyEvent(k, true); }
                    return false;
                }
                proben->push_back(modellJetzt(figur()));
                proben->back().gedrueckt = b <= bilder;
                if (b < bilder) { return false; }
                for (const ImGuiKey k : t) { io.AddKeyEvent(k, false); }
                if (umschalt) { io.AddKeyEvent(ImGuiMod_Shift, false); }
                return b > bilder + 1;
            }};
}

struct AufStand {
    std::string name;   // die Figur (ihr Index aendert sich beim Neubau der Szene)
    std::string skript;
    std::size_t tiefe = 0;
    std::size_t entities = 0;
    int figur = -1;
    double startMs = 0.0;
};

// Aufnehmen, schreiben, pruefen, Strg+Z: fuer die gewaehlte Figur zur Zeit des Zeigers.
// lFoermig: erst vor, dann seitwaerts, dann gehend vor (Ecke und Gangwechsel).
std::vector<Schritt> aufnahmeZug(const std::string& wo, std::shared_ptr<AufStand> z, bool lFoermig) {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    add(tu("zeitleiste1 Aufnahme " + wo + ": Stand merken", [=] {
        z->skript = skriptText();
        z->tiefe = g_app->doc.undoDepth();
        z->entities = g_app->map.entities.size();
        z->startMs = g_app->playMs;
        z->name = z->figur >= 0 && static_cast<std::size_t>(z->figur) < g_app->scene.actors.size()
                      ? g_app->scene.actors[static_cast<std::size_t>(z->figur)].name
                      : std::string();
    }));
    add(klick(tr(Str::AufKnopf), "", 0, true));
    add(pause(0.3));
    add(pruefe("zeitleiste1 Aufnahme " + wo + ": Aufnehmen startet die Steuerung", [] { return aufnahmeLaeuft(); }));
    // Wie weit der gesteuerte Ort (aufnahmeFigurZustand) vom Start der Aufnahme ist.
    const auto wegVomStart = [z] {
        if (z->figur < 0 || static_cast<std::size_t>(z->figur) >= g_app->scene.actors.size()) { return 0.0; }
        const ActorState start = g_app->scene.actors[static_cast<std::size_t>(z->figur)].at(z->startMs);
        ActorState jetzt = start;
        aufnahmeFigurZustand(z->figur, g_app->playMs, jetzt);
        return std::hypot(static_cast<double>(jetzt.pos[0] - start.pos[0]), static_cast<double>(jetzt.pos[1] - start.pos[1]));
    };
    add(halteTaste(ImGuiKey_W, 45, false, "W", lFoermig ? std::function<bool()>{} : [wegVomStart] { return wegVomStart() >= 330.0; }));
    if (lFoermig) {
        add(halteTaste(ImGuiKey_D, 35, false, "D"));
        add(halteTaste(ImGuiKey_W, 35, true, "Umschalt+W"));
    }
    add(pruefe("zeitleiste1 Aufnahme " + wo + ": die Figur laeuft, Laufziele mit der Toleranz", [=] {
        diag::detail("Knopftest: zeitleiste1 Aufnahme " + wo + " - " + std::to_string(aufnahmeProben()) + " Proben, " +
                     std::to_string(aufnahmePunkte()) + " Laufziele");
        return aufnahmeProben() > 8 && aufnahmePunkte() >= (lFoermig ? 2 : 1);
    }));
    // Zeitleiste 3: das Modell der Figur geht mit (vorher blieb es am Ort zur
    // Startzeit stehen, nur der Umriss lief). Integration 5: gegen den gesteuerten
    // Ort selbst - wie weit die Figur in den gehaltenen Bildern kommt, haengt von
    // der Bildzeit ab (mini: Zeitleiste 3 119 .. 391 Einheiten, Integration 5 80).
    // Nach dem Loslassen gleitet die Figur noch aus, gezeichnet wird sie ein Bild
    // spaeter: bis zu 60 Bilder warten.
    const std::string modellText = "zeitleiste1 Aufnahme " + wo + ": das Modell steht am gesteuerten Ort, nicht am Ort der Szene";
    add({"Pruefe " + modellText, [=](int b) {
        if (z->figur < 0 || static_cast<std::size_t>(z->figur) >= g_app->figurGezeichnet.size()) {
            pruefeWahr(false, modellText);
            return true;
        }
        const auto& gez = g_app->figurGezeichnet[static_cast<std::size_t>(z->figur)];
        const ActorState st = g_app->scene.actors[static_cast<std::size_t>(z->figur)].at(g_app->playMs);
        ActorState soll = st;
        aufnahmeFigurZustand(z->figur, g_app->playMs, soll);
        const auto abstand = [](const float* p, const float* q) {
            return std::hypot(static_cast<double>(p[0] - q[0]), static_cast<double>(p[1] - q[1]));
        };
        const double weg = abstand(gez.data(), st.pos);
        const double gesteuert = abstand(soll.pos, st.pos);
        const double daneben = abstand(gez.data(), soll.pos);
        const bool ok = gesteuert > 32.0 && daneben < 1.0;
        if (!ok && b < 60) { return false; }
        diag::detail("Knopftest: zeitleiste1 Aufnahme " + wo + " - Modell gezeichnet " + std::to_string(weg) + " vom Ort der Szene, gesteuert " +
                     std::to_string(gesteuert) + ", vom gesteuerten Ort " + std::to_string(daneben) + " (Bild " + std::to_string(b) + ")");
        pruefeWahr(ok, modellText);
        return true;
    }});
    // Zeitleiste 3: der Hinweis steht ganz im sichtbaren Teil des Fensters, in
    // dem er liegt, und kein Knopf liegt darueber (vorher begann er unter der
    // Werkzeugleiste am linken Rand der Ansicht und war dort abgeschnitten).
    add(pruefe("zeitleiste1 Aufnahme " + wo + ": der Hinweis steht ganz im Bild, frei von Knoepfen", [=] {
        ImVec2 ha;
        ImVec2 hb;
        aufnahmeHinweis(ha, hb);
        const ImVec2 mitte{(ha.x + hb.x) * 0.5F, (ha.y + hb.y) * 0.5F};
        const ImGuiWindow* fenster = nullptr;
        for (const ImGuiWindow* w : ImGui::GetCurrentContext()->Windows) {
            if (!w->WasActive || w->Hidden || (w->Flags & (ImGuiWindowFlags_Tooltip | ImGuiWindowFlags_Popup)) != 0) { continue; }
            if (w->InnerRect.Contains(mitte)) { fenster = w; }
        }
        const ImRect hinweis(ha, hb);
        const bool ganz = fenster != nullptr && hb.x > ha.x && fenster->InnerClipRect.Contains(hinweis);
        std::string darunter;
        for (const Element& e : g_elemente) {
            if (e.rect.Overlaps(hinweis) && !e.rect.Contains(hinweis)) { darunter += " [" + e.label + "]"; }
            // Die Platzierleiste steht je nach Hoehe der Ansicht verschieden hoch:
            // ihre ganze Spalte bleibt frei.
            if (e.innen.find("##platzieren") != std::string::npos && ha.x < e.rect.Max.x && hb.x > e.rect.Min.x) {
                darunter += " [Spalte der Platzierleiste " + e.label + "]";
                break;
            }
        }
        diag::detail("Knopftest: zeitleiste1 Aufnahme " + wo + " - Hinweis " + std::to_string(ha.x) + ".." + std::to_string(hb.x) + " x " +
                     std::to_string(ha.y) + ".." + std::to_string(hb.y) + ", Fenster " +
                     (fenster != nullptr ? std::string(fenster->Name) + " " + std::to_string(fenster->InnerClipRect.Min.x) + ".." +
                                               std::to_string(fenster->InnerClipRect.Max.x)
                                         : std::string("-")) +
                     ", darunter" + (darunter.empty() ? std::string(" nichts") : darunter));
        return ganz && darunter.empty();
    }));
    add(foto("zl2_aufnahme_" + wo));
    add(taste(ImGuiKey_Enter, "Enter"));
    add(pause(1.2));
    add(pruefe("zeitleiste1 Aufnahme " + wo + ": geschrieben - ref_tags und SET_NAVGOAL, ein Rueckgaengig-Schritt", [=] {
        int navgoals = 0;
        const std::string text = skriptText();
        for (std::size_t p = text.find("SET_NAVGOAL"); p != std::string::npos; p = text.find("SET_NAVGOAL", p + 1)) { ++navgoals; }
        int vorherNav = 0;
        for (std::size_t p = z->skript.find("SET_NAVGOAL"); p != std::string::npos; p = z->skript.find("SET_NAVGOAL", p + 1)) { ++vorherNav; }
        const std::size_t neu = g_app->map.entities.size() - z->entities;
        const bool gang = !lFoermig || (text.find("\"SET_WALKING\", \"true\"") != std::string::npos);
        diag::detail("Knopftest: zeitleiste1 Aufnahme " + wo + " - " + std::to_string(neu) + " neue Entities, SET_NAVGOAL " +
                     std::to_string(vorherNav) + " -> " + std::to_string(navgoals) + ", Schritte " +
                     std::to_string(g_app->doc.undoDepth() - z->tiefe) + ", Gangart " + std::to_string(gang ? 1 : 0));
        return !aufnahmeLaeuft() && neu >= (lFoermig ? 2U : 1U) && static_cast<std::size_t>(navgoals - vorherNav) == neu &&
               g_app->doc.undoDepth() == z->tiefe + 1 && gang;
    }));
    add(pruefe("zeitleiste1 Aufnahme " + wo + ": die Vorschau laeuft den Weg wie das Spiel bis zum letzten Laufziel", [=] {
        const MapEntity& letzt = g_app->map.entities.back();
        z->figur = -1;   // genau dieser Name (figurNamens fände "bigguard1" fuer "guard1")
        for (std::size_t i = 0; i < g_app->scene.actors.size() && z->figur < 0; ++i) {
            if (g_app->scene.actors[i].name == z->name) { z->figur = static_cast<int>(i); }
        }
        float o[3] = {0, 0, 0};
        (void)std::sscanf(letzt.origin.c_str(), "%f %f %f", &o[0], &o[1], &o[2]);
        double best = 1.0e9;
        if (z->figur >= 0 && static_cast<std::size_t>(z->figur) < g_app->scene.actors.size()) {
            for (const ActorStep& st : g_app->scene.actors[static_cast<std::size_t>(z->figur)].steps) {
                if (st.kind != ActorStep::Kind::WalkTo || st.startMs + 1.0 < z->startMs) { continue; }
                best = std::min(best, std::hypot(static_cast<double>(st.to[0] - o[0]), static_cast<double>(st.to[1] - o[1])));
            }
        }
        int laeufe = 0;
        std::string arten;
        if (z->figur >= 0 && static_cast<std::size_t>(z->figur) < g_app->scene.actors.size()) {
            for (const ActorStep& st : g_app->scene.actors[static_cast<std::size_t>(z->figur)].steps) {
                laeufe += st.kind == ActorStep::Kind::WalkTo ? 1 : 0;
                arten += " " + std::to_string(static_cast<int>(st.kind)) + "@" + std::to_string(static_cast<int>(st.startMs));
            }
            diag::detail("Knopftest: zeitleiste1 Aufnahme " + wo + " - Figur " + g_app->scene.actors[static_cast<std::size_t>(z->figur)].name +
                         ", Schritte" + arten);
        }
        diag::detail("Knopftest: zeitleiste1 Aufnahme " + wo + " - letztes Laufziel " + letzt.targetname + " bei " + letzt.origin +
                     ", naechstes Laufende " + std::to_string(best) + ", Laeufe der Figur " + std::to_string(laeufe));
        return letzt.classname == "ref_tag" && best < 40.0;
    }));
    add(foto("zl2_aufnahme_" + wo + "_geschrieben"));
    add(tasteMit(ImGuiMod_Ctrl, ImGuiKey_Z, "Strg+Z"));
    add(pause(0.6));
    add(pruefe("zeitleiste1 Aufnahme " + wo + ": ein Strg+Z - Skript bytegleich, Entities zurueck", [=] {
        return skriptText() == z->skript && g_app->map.entities.size() == z->entities && g_app->doc.undoDepth() == z->tiefe;
    }));
    return s;
}

// Zeitleiste 4 Punkt 3: das Modell beim Steuern wie im Spiel - Beine nach
// PM_Footsteps (vorwaerts, rueckwaerts, seitwaerts), mit Uebergang (PM_SetAnim,
// SETANIM_BLEND_DEFAULT), Beine zur Laufrichtung und Rumpf zum Blick (cgame),
// der Oberkoerper wie PM_TorsoAnimation. Die Erwartung rechnet pmanim.h mit
// dem, was die Figur zur Startzeit hat; kennt ihr Modell die Animation nicht,
// setzt das Spiel nichts (dann bleibt die vorige).
std::vector<Schritt> aufnahmeModell(const std::string& wo, std::shared_ptr<AufStand> z) {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto vorw = std::make_shared<std::vector<ModellProbe>>();
    auto rueck = std::make_shared<std::vector<ModellProbe>>();
    auto seitw = std::make_shared<std::vector<ModellProbe>>();
    const auto figur = [z] { return z->figur; };
    // Was PM_Footsteps waehlen muss, und was die Beine danach zeigen (kennt das
    // Modell die Animation nicht, bleibt die vorige).
    const auto erwartet = [z](int vor, int seit, bool rueckw, const std::string& vorher) {
        PmBeinStand st;
        st.beine = vorher;
        st.torso = vorher;
        st.inKamera = camStateAt(g_app->playMs).enabled;
        const std::string a = pmFootstepsBeine(aufnahmePmFigur(z->figur, g_app->playMs), vor, seit, false, rueckw, st).anim;
        return (a.empty() || !aufnahmeAnimBekannt(z->figur, a)) ? vorher : a;
    };
    add(klick(tr(Str::AufKnopf), "", 0, true));
    add(pause(0.3));
    add(halteUndMiss({ImGuiKey_W}, 14, false, "W", figur, vorw));
    add(halteUndMiss({ImGuiKey_S}, 14, false, "S", figur, rueck));
    add(halteUndMiss({ImGuiKey_D}, 30, false, "D", figur, seitw));
    add(pruefe("zeitleiste1 Aufnahme " + wo + ": Modell vorwaerts - Beine wie PM_Footsteps, mit Uebergang aus dem Stand", [=] {
        if (vorw->size() < 3) { return false; }
        const std::string stand = vorw->front().beine;
        const std::string soll = erwartet(127, 0, false, stand);
        bool blende = false;
        for (const ModellProbe& p : *vorw) { blende = blende || (p.vorher == stand && p.beine == soll && p.blendMs == 100.0); }
        diag::detail("Knopftest: zeitleiste1 Aufnahme " + wo + " - vorwaerts: Stand " + stand + ", Beine " + gehalten(*vorw).beine +
                     " (soll " + soll + "), Uebergang " + (blende ? "ja" : "nein") + ", Oberkoerper '" + gehalten(*vorw).torso + "'");
        return gehalten(*vorw).beine == soll && (soll == stand || blende);
    }));
    add(pruefe("zeitleiste1 Aufnahme " + wo + ": Modell rueckwaerts - Rueckwaertsanimation mit Uebergang", [=] {
        if (rueck->size() < 3) { return false; }
        const std::string vorher = rueck->front().beine;
        const std::string soll = erwartet(-127, 0, true, vorher);
        bool blende = false;
        for (const ModellProbe& p : *rueck) { blende = blende || (p.vorher == vorher && p.beine == soll && p.blendMs == 100.0); }
        diag::detail("Knopftest: zeitleiste1 Aufnahme " + wo + " - rueckwaerts: vorher " + vorher + ", Beine " + gehalten(*rueck).beine +
                     " (soll " + soll + "), Uebergang " + (blende ? "ja" : "nein"));
        return gehalten(*rueck).beine == soll && soll != vorher && blende;
    }));
    add(pruefe("zeitleiste1 Aufnahme " + wo + ": Modell seitwaerts - Laufanimation, Beine zur Seite gedreht, Rumpf zum Blick", [=] {
        if (seitw->size() < 3) { return false; }
        const std::string soll = erwartet(0, 127, false, seitw->front().beine);
        float rumpf = 0.0F;
        for (const ModellProbe& p : *seitw) { rumpf = std::max(rumpf, std::fabs(p.rumpf)); }
        const ModellProbe& g = gehalten(*seitw);
        diag::detail("Knopftest: zeitleiste1 Aufnahme " + wo + " - seitwaerts: Beine " + g.beine + " (soll " + soll +
                     "), Rumpf gegen Beine bis " + std::to_string(rumpf) + " Grad, am Ende " + std::to_string(g.rumpf));
        // D: nach rechts - die Beine drehen bis 60 Grad nach rechts, der Rumpf
        // also nach links gegen sie (CG_PlayerLegsYawFromMovement, Grenze 60).
        return g.beine == soll && g.rumpf > 30.0F && rumpf <= 60.5F;
    }));
    add(pruefe("zeitleiste1 Aufnahme " + wo + ": Oberkoerper wie PM_TorsoAnimation (eigene Waffenhaltung oder mit den Beinen)", [=] {
        if (vorw->empty() || z->figur < 0) { return false; }
        const PmFigur f = aufnahmePmFigur(z->figur, g_app->playMs);
        const ModellProbe& g = gehalten(*vorw);
        const std::string waffe = npcWaffenTorso(f.waffe, g.beine, f.klasse, f.zweiPistolen, false, false);
        const std::string soll = (waffe.empty() || !aufnahmeAnimBekannt(z->figur, waffe)) ? std::string() : waffe;
        diag::detail("Knopftest: zeitleiste1 Aufnahme " + wo + " - Oberkoerper '" + g.torso + "' (soll '" + soll + "'), Waffe " + f.waffe);
        return g.torso == soll;
    }));
    add(taste(ImGuiKey_Escape, "Esc"));
    add(pause(0.4));
    return s;
}

// Zeitleiste 5 Punkt 1: am Hang stellt PM_Footsteps auch die gesteuerte Figur
// mit PM_AdjustStandAnimForSlope auf die Hang-Beinanimation (LEGS_*). Gesucht
// wird eine Stelle nahe dem Startpunkt, an der der Boden unter den Fuessen
// verschieden hoch liegt (Schraege oder Stufe, der Kasten der Figur frei); die
// Figur steht quer dazu.
std::vector<Schritt> aufnahmeHang(std::shared_ptr<AufStand> z) {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto gefunden = std::make_shared<bool>(false);
    auto beine = std::make_shared<std::vector<std::string>>();
    add(tu("zeitleiste1 Aufnahme Hang: Schraege oder Stufe suchen, zl2_laeufer quer darauf stellen", [=] {
        const std::shared_ptr<const NavWelt> w = navWeltVorschau();
        if (!w || !w->spur || z->figur < 0) { return; }
        const ActorState st = g_app->scene.actors[static_cast<std::size_t>(z->figur)].at(g_app->playMs);
        // Boden unter (x, y): Hoehe, oder -1e30 ohne Treffer
        const auto boden = [&w, &st](float x, float y) {
            const NavSpur t = w->spur({x, y, st.pos[2] + 256.0F}, {0, 0, 0}, {0, 0, 0}, {x, y, st.pos[2] - 512.0F}, kNavKeineEntity,
                                      kNavMaskPlayerSolid);
            return (t.startsolid || t.fraction >= 1.0F) ? -1.0e30F : t.endpos[2];
        };
        // Eine Stelle, an der der Boden 7 Einheiten links und rechts 6..20 hoeher
        // bzw. tiefer liegt (Schraege oder Stufe unter den Fuessen), die naechste.
        float best = 1.0e30F;
        float fund[4] = {0, 0, 0, 0};   // x, y, z, gier
        for (int i = -50; i <= 50; ++i) {
            for (int j = -50; j <= 50; ++j) {
                const float d = static_cast<float>(i * i + j * j);
                if (d >= best) { continue; }
                const float x = st.pos[0] + static_cast<float>(i) * 24.0F;
                const float y = st.pos[1] + static_cast<float>(j) * 24.0F;
                const float h0 = boden(x, y);
                if (h0 < -1.0e29F) { continue; }
                for (int achse = 0; achse < 2; ++achse) {
                    const float dx = achse == 0 ? 7.0F : 0.0F;
                    const float dy = achse == 0 ? 0.0F : 7.0F;
                    const float h1 = boden(x + dx, y + dy);
                    const float h2 = boden(x - dx, y - dy);
                    const float diff = std::fabs(h1 - h2);
                    if (h1 < -1.0e29F || h2 < -1.0e29F || diff < 6.0F || diff > 20.0F) { continue; }
                    const NavVec o{x, y, std::max({h0, h1, h2}) + 25.0F};
                    if (w->spur(o, {-15, -15, -24}, {15, 15, 40}, o, kNavKeineEntity, kNavMaskPlayerSolid).startsolid) { continue; }
                    best = d;
                    fund[0] = x;
                    fund[1] = y;
                    fund[2] = o[2];
                    fund[3] = achse == 0 ? 90.0F : 0.0F;   // quer: die Fuesse liegen auf der Achse
                    break;
                }
            }
        }
        if (best >= 1.0e30F) { return; }
        *gefunden = true;
        int e = -1;
        for (std::size_t i = 0; i < g_app->map.entities.size() && e < 0; ++i) {
            const std::string* n = g_app->map.entities[i].find("NPC_targetname");
            if (n != nullptr && *n == "zl2_laeufer") { e = static_cast<int>(i); }
        }
        char o[96];
        std::snprintf(o, sizeof(o), "%.1f %.1f %.1f", static_cast<double>(fund[0]), static_cast<double>(fund[1]),
                      static_cast<double>(fund[2]));
        (void)entityKeySetzen(e, "origin", o);
        (void)entityKeySetzen(e, "angle", std::to_string(static_cast<int>(fund[3])));
        diag::detail(std::string("Knopftest: Hang bei ") + o + ", Gier " + std::to_string(static_cast<int>(fund[3])));
        g_app->camTrackValid = false;
        g_app->mapDirty = true;
    }));
    add(pruefe("zeitleiste1 Aufnahme Hang: eine Schraege oder Stufe gefunden", [=] { return *gefunden; }));
    add(warteBis("zeitleiste1 Aufnahme Hang: Szene neu", [=] {
        z->figur = mission1::figurNamens("zl2_laeufer");
        return z->figur >= 0 && g_app->camTrackValid;
    }, 2000));
    add(tu("zeitleiste1 Aufnahme Hang: zl2_laeufer waehlen", [=] {
        g_app->selectedActor = z->figur;
        g_app->playMs = 500.0;
    }));
    add(pause(0.4));
    add(klick(tr(Str::AufKnopf), "", 0, true));
    for (int i = 0; i < 6; ++i) {
        add(pause(0.25));
        add(tu("zeitleiste1 Aufnahme Hang: Beine merken", [=] {
            ActorState st;
            aufnahmeFigurZustand(z->figur, g_app->playMs, st);
            beine->push_back(st.animation);
        }));
    }
    add(pruefe("zeitleiste1 Aufnahme Hang: im Stand die Hang-Beine (PM_AdjustStandAnimForSlope)", [=] {
        std::string alle;
        for (const std::string& b : *beine) { alle += b + " "; }
        diag::detail("Knopftest: Aufnahme am Hang, Beine " + alle);
        return !beine->empty() && beine->back().rfind("LEGS_", 0) == 0;
    }));
    add(taste(ImGuiKey_Escape, "Esc"));
    add(pause(0.4));
    return s;
}

std::vector<Schritt> aufnahmeSchritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto z = std::make_shared<AufStand>();
    // Die Mini-Szene zl2unter (eigene Karte, eigenes Skript) bekommt eine eigene Figur.
    add(tu("zeitleiste1 Aufnahme: eigene Figur zl2_laeufer am Startpunkt der Karte", [] {
        float o[3] = {0, 0, 0};
        std::string typ;
        for (const MapEntity& e : g_app->map.entities) {
            if (e.classname == "info_player_start" && o[0] == 0.0F && o[1] == 0.0F) { (void)std::sscanf(e.origin.c_str(), "%f %f %f", &o[0], &o[1], &o[2]); }
            const std::string* t = e.find("NPC_type");
            if (typ.empty() && e.classname == "NPC_spawner" && t != nullptr && !t->empty()) { typ = *t; }
        }
        const int i = neueEntityAn("NPC_spawner", o);
        if (i < 0) { return; }
        (void)entityKeySetzen(i, "NPC_targetname", "zl2_laeufer");
        (void)entityKeySetzen(i, "NPC_type", typ.empty() ? std::string("stormtrooper") : typ);
        g_app->camTrackValid = false;
        g_app->mapDirty = true;
        g_app->leftMode = 1;
        g_app->throughCamera = false;
        g_app->playing = false;
        g_app->playMs = 0.0;
    }));
    add(warteBis("zeitleiste1 Aufnahme: zl2_laeufer in der Szene", [=] {
        z->figur = mission1::figurNamens("zl2_laeufer");
        return z->figur >= 0 && g_app->camTrackValid;
    }, 2000));
    add(tu("zeitleiste1 Aufnahme: zl2_laeufer waehlen, Zeit 0,5 s", [=] {
        g_app->selectedActor = z->figur;
        g_app->playMs = 500.0;
        g_app->mapDirty = true;
    }));
    add(pause(0.4));
    add(pruefe("zeitleiste1 Aufnahme: Aufnehmen ist fuer die Figur moeglich", [=] { return aufnahmeMoeglich(z->figur); }));
    // Abbrechen mit Esc aendert nichts.
    add(tu("zeitleiste1 Aufnahme: Stand vor dem Abbrechen", [=] {
        z->skript = skriptText();
        z->tiefe = g_app->doc.undoDepth();
        z->entities = g_app->map.entities.size();
    }));
    add(klick(tr(Str::AufKnopf), "", 0, true));
    add(pause(0.3));
    add(halteTaste(ImGuiKey_W, 25, false, "W"));
    add(taste(ImGuiKey_Escape, "Esc"));
    add(pause(0.4));
    add(pruefe("zeitleiste1 Aufnahme: Esc bricht ab, nichts geaendert", [=] {
        return !aufnahmeLaeuft() && skriptText() == z->skript && g_app->doc.undoDepth() == z->tiefe && g_app->map.entities.size() == z->entities;
    }));
    add(tu("zeitleiste1 Aufnahme: zl2_laeufer wieder waehlen", [=] { g_app->selectedActor = z->figur; }));
    for (Schritt& x : aufnahmeModell("mini", z)) { s.push_back(std::move(x)); }
    add(tu("zeitleiste1 Aufnahme: zl2_laeufer wieder waehlen (nach dem Modell)", [=] { g_app->selectedActor = z->figur; }));
    for (Schritt& x : aufnahmeZug("mini", z, true)) { s.push_back(std::move(x)); }
    for (Schritt& x : aufnahmeHang(z)) { s.push_back(std::move(x)); }
    add(tu("zeitleiste1 Aufnahme: Auswahl aufheben", [] {
        g_app->selectedActor = -1;
        mission1::ungespeicherteEntitiesVergessen();
        g_app->doc.markSaved();
    }));
    return s;
}

// Auf einer Originalkarte: die erste Figur, die zur Zeit t aufnehmbar ist.
// Gewaehlt wird eine Figur zur Zeit ihres ersten eigenen Befehls (dort ist die
// Zeit im Skript bekannt - hinter einem waitsignal waere sie es nicht, das
// Schreiben meldet das und laesst alles) mit freiem Weg 120 Einheiten voraus.
std::vector<Schritt> aufnahmeOriginal(const std::string& szene) {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto z = std::make_shared<AufStand>();
    add(tu("zeitleiste1 Aufnahme " + szene + ": eine Figur waehlen", [=] {
        g_app->throughCamera = false;
        g_app->playing = false;
        g_app->mapDirty = true;
        z->figur = -1;
        const std::shared_ptr<const NavWelt> welt = navWeltVorschau();
        for (std::size_t i = 0; i < g_app->scene.actors.size() && z->figur < 0; ++i) {
            const Actor& a = g_app->scene.actors[i];
            double t = -1.0;
            for (const ActorStep& st : a.steps) {
                if (!st.path.empty() && st.fremd.empty()) {
                    t = st.startMs;
                    break;
                }
            }
            if (t < 0.0) { continue; }
            g_app->playMs = t;
            if (!aufnahmeMoeglich(static_cast<int>(i))) { continue; }
            const ActorState stand = a.at(t);
            const float g = stand.angles[1] * 3.14159265F / 180.0F;
            const NavVec von{stand.pos[0], stand.pos[1], stand.pos[2] + 2.0F};
            const NavVec nach{von[0] + std::cos(g) * 120.0F, von[1] + std::sin(g) * 120.0F, von[2]};
            const bool frei = !welt || !welt->spur ||
                              welt->spur(von, NavVec{-15.0F, -15.0F, -6.0F}, NavVec{15.0F, 15.0F, 40.0F}, nach, kNavKeineEntity,
                                         kNavSolid | kNavPlayerClip)
                                      .fraction >= 1.0F;
            if (frei) { z->figur = static_cast<int>(i); }
        }
        g_app->selectedActor = z->figur;
        diag::detail("Knopftest: zeitleiste1 Aufnahme " + szene + " - Figur " +
                     (z->figur >= 0 ? g_app->scene.actors[static_cast<std::size_t>(z->figur)].name : std::string("keine")) + ", Regelwerk " +
                     (regelwerkMovieDuels() ? "Movie Duels" : "OpenJK"));
    }));
    add(pause(0.4));
    for (Schritt& x : aufnahmeZug(szene, z, false)) { s.push_back(std::move(x)); }
    add(tu("zeitleiste1 Aufnahme " + szene + ": Auswahl aufheben", [] { g_app->selectedActor = -1; }));
    return s;
}

// Zeitleiste 4 Punkt 1: die Einstellungen bei einer Oberflaeche, mit der ihr
// Inhalt hoeher ist als das Fenster (der volle Bildlauf stellt 1,3 ein). Dort
// lagen Ok und Cancel unter dem Fensterrand, der Klick auf Cancel traf nichts,
// die Einstellungen blieben offen und sperrten alle weiteren Klicks.
std::vector<Schritt> einstellungenSchritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    auto vorher = std::make_shared<float>(1.0F);
    add(tu("zeitleiste1 Einstellungen: Oberflaeche 1,3 wie im Bildlauf, Einstellungen oeffnen", [=] {
        *vorher = g_app->uiScale;
        g_app->uiScale = 1.3F;
        g_app->prefsOpen = true;
    }));
    add(pause(0.6));
    add(pruefe("zeitleiste1 Einstellungen: Ok und Cancel ganz im Bild", [] {
        const Element* ok = finde(tr(Str::EditorOk), tr(Str::PrefsTitle), 0, false);
        const Element* ab = finde(tr(Str::EditorCancel), tr(Str::PrefsTitle), 0, false);
        const ImGuiWindow* w = ImGui::FindWindowByName(tr(Str::PrefsTitle));
        char z[200];
        std::snprintf(z, sizeof(z), "Knopftest: Einstellungen %.0f px hoch, Fenster %.0f px, Cancel unten bei %.0f",
                      w != nullptr ? static_cast<double>(w->Size.y) : 0.0, static_cast<double>(ImGui::GetIO().DisplaySize.y),
                      ab != nullptr ? static_cast<double>(ab->rect.Max.y) : -1.0);
        diag::detail(z);
        return ok != nullptr && ab != nullptr && ganzSichtbar(*ok) && ganzSichtbar(*ab);
    }));
    // Zeitleiste 5 Punkt 5: das Klappfeld "Spielregeln" zeigt jeden Eintrag
    // ganz - ImGui schneidet die Vorschau vor dem Pfeil ab (BeginCombo:
    // FramePadding.x + Text bis Rand - GetFrameHeight()). In allen 6 Sprachen.
    const auto sprache = std::make_shared<i18n::Language>(i18n::currentLanguage());
    for (const i18n::Language l : {i18n::Language::English, i18n::Language::German, i18n::Language::ChineseSimplified,
                                   i18n::Language::Japanese, i18n::Language::Spanish, i18n::Language::Czech}) {
        const std::string n = std::to_string(static_cast<int>(l));
