// Eine geladene echte Szene: beide Ansichten fotografieren, Lesbarkeit, die
// Zahlen gegen den Export zeitleiste0, Anfangsausschnitt, Bildzeit.
// Wie viele Kamerabilder der Filmstreifen haben muss: alle 2 s bis zum Ende der Kamerafahrt.
std::size_t filmSoll() {
    const double ende = std::min(std::max(g_app->camTrack.durationMs, 1.0), g_app->spuren.dauerMs);
    return static_cast<std::size_t>(std::floor((ende + 0.5) / 2000.0)) + 1U;
}
std::size_t filmDa() {
    std::size_t n = 0;
    for (const App::ZlFilmBild& b : g_app->zlFilm) { n += b.textur != nullptr ? 1U : 0U; }
    return n;
}

std::vector<Schritt> szeneSchritte(const std::string& szene, int saetze, int untertitel) {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    // --- Filmstreifen: alle 2 s ein Bild der Skriptkamera, ohne laengere Bilder ---
    // (aufgenommen wird, wenn in der Ansicht nichts gewaehlt ist)
    add(tu("zeitleiste1: " + szene + " - nichts gewaehlt", [] {
        g_app->cameraSelected = false;
        g_app->selectedActor = -1;
        entityAuswahlSetzen(-1);
    }));
    add(warteBis("zeitleiste1: " + szene + " - Kamerabilder aufgenommen", [] {
        return g_app->zlFilmPass < 0 && g_app->zlFilmStand == g_app->zlModellStand && filmDa() >= filmSoll();
    }, 1200));
    add(pruefe("zeitleiste1: " + szene + " - Filmstreifen: je 2 s ein Bild", [szene] {
        diag::detail("Knopftest: zeitleiste1 - " + szene + ": " + std::to_string(filmDa()) + " Kamerabilder, erwartet " +
                     std::to_string(filmSoll()) + ", Zeile film " + std::to_string(yVon("film") > 0.0F ? 1 : 0));
        return filmDa() == filmSoll() && yVon("film") > 0.0F;
    }));
    auto ruhig = std::make_shared<Messung>();
    add(bildzeit(szene + " ohne Durchgang", ruhig, 60));
    auto durch = std::make_shared<Messung>();
    auto zeiger = std::make_shared<double>(0.0);
    add(Schritt{"zeitleiste1: " + szene + " - Bildzeit waehrend eines Filmdurchgangs", [=](int b) {
                    if (b == 0) {
                        *durch = Messung{};
                        *zeiger = g_app->playMs;
                        ++g_app->zlModellStand;   // als waere das Skript geaendert: neuer Durchgang
                        return false;
                    }
                    if (b > 2 && g_app->zlFilmPass >= 0) {
                        const double dt = static_cast<double>(ImGui::GetIO().DeltaTime) * 1000.0;
                        ++durch->bilder;
                        durch->summe += dt;
                        durch->spitze = std::max(durch->spitze, dt);
                    }
                    return b > 4 && g_app->zlFilmPass < 0;
                }});
    add(pruefe("zeitleiste1: " + szene + " - Filmdurchgang ohne laengere Bilder, Zeiger zurueck", [=] {
        const double mDurch = durch->bilder > 0 ? durch->summe / durch->bilder : 0.0;
        const double mRuhig = ruhig->bilder > 0 ? ruhig->summe / ruhig->bilder : 0.0;
        char z[260];
        std::snprintf(z, sizeof(z), "Knopftest: zeitleiste1 - %s: Filmdurchgang %d Bilder, im Mittel %.2f ms (Spitze %.1f), ohne Durchgang %.2f ms (Spitze %.1f), unter Last",
                      szene.c_str(), durch->bilder, mDurch, durch->spitze, mRuhig, ruhig->spitze);
        diag::detail(z);
        return durch->bilder > 0 && mDurch <= mRuhig * 1.5 + 4.0 && std::fabs(g_app->playMs - *zeiger) < 0.5;
    }));
    add(pruefe("zeitleiste1: " + szene + " - Anfangsausschnitt etwa 30 s", [szene] {
        diag::detail("Knopftest: zeitleiste1 - " + szene + ": sichtbar " + std::to_string(g_app->tlSichtSpanne) + " ms von " +
                     std::to_string(g_app->spuren.dauerMs) + " ms");
        return g_app->spuren.dauerMs < 30000.0 || std::fabs(g_app->tlSichtSpanne - 30000.0) < 1500.0;
    }));
    add(tu("zeitleiste1: " + szene + " - Uebersicht, Leiste hoch", [] {
        g_app->zlDetail = false;
        g_app->zlNurAktive = false;
        g_app->zlProbleme = false;
        g_app->zlSuche[0] = '\0';
        g_app->zlAuswahl.da = false;
        g_app->timelineFrac = 0.55F;
        g_app->playMs = 0.0;
        g_app->playing = false;
    }));
    add(pause(0.8));
    add(pruefe("zeitleiste1: " + szene + " - Gegenprobe mit dem Export zeitleiste0", [=] {
        const spuren::Spuren& m = g_app->spuren;
        int mitLaenge = 0;
        int mitText = 0;
        for (const spuren::Clip& c : m.sprache.clips) {
            mitLaenge += c.klangMs > 0.0 ? 1 : 0;
            mitText += c.untertitel.empty() ? 0 : 1;
        }
        // Die Zaehlung des Exports zeitleiste0 (und der alten Leiste): ein Abschnitt,
        // in den der naechste derselben Gruppe hineinbeginnt.
        int alt = 0;
        const auto schwenk = [](const CamSegment& x) {
            return x.kind == CamSegment::Kind::Pan || (x.kind == CamSegment::Kind::Roll && x.alleAchsen);
        };
        for (const CamSegment& a : g_app->camTrack.segments) {
            if (a.kind != CamSegment::Kind::Move && a.kind != CamSegment::Kind::Pan && a.kind != CamSegment::Kind::Zoom &&
                a.kind != CamSegment::Kind::Roll) {
                continue;
            }
            const CamSegment* n = nullptr;
            for (const CamSegment& o : g_app->camTrack.segments) {
                const bool gleich = schwenk(a) ? schwenk(o) : o.kind == a.kind;
                if (&o != &a && gleich && o.startMs > a.startMs + 0.5 && (n == nullptr || o.startMs < n->startMs)) { n = &o; }
            }
            alt += (n != nullptr && n->startMs < a.endMs - 0.5) ? 1 : 0;
        }
        diag::detail("Knopftest: zeitleiste1 - " + szene + ": Ueberlappungen nach der Zaehlung des Exports " + std::to_string(alt) +
                     ", im Modell (springt zurueck) " + std::to_string(m.ueberlappungen));
        int klaenge = 0;
        for (const TimelineTrack& t : g_app->timeline.tracks) {
            for (const TimelineEvent& e : t.events) { klaenge += (e.kind == TimelineEvent::Kind::Sound && !e.sound.empty()) ? 1 : 0; }
        }
        diag::detail("Knopftest: zeitleiste1 - " + szene + ": Saetze " + std::to_string(m.sprache.clips.size()) + " (Klaenge im Ablauf " +
                     std::to_string(klaenge) + "), mit Laenge " + std::to_string(mitLaenge) + ", mit Untertitel " + std::to_string(mitText) +
                     ", Kamera springt " + std::to_string(m.ueberlappungen) + ", Darsteller " + std::to_string(m.darsteller.size()) +
                     ", Dauer " + std::to_string(m.dauerMs) + " ms, Musik " + std::to_string(m.musik.clips.size()) +
                     ", nicht nachgebildet " + std::to_string(m.nichtNachgebildet));
        return static_cast<int>(m.sprache.clips.size()) == saetze && klaenge == saetze && mitLaenge == saetze && mitText == untertitel;
    }));
    add(pruefe("zeitleiste1: " + szene + " - Uebersicht lesbar", [szene] { return lesbar(szene + " Uebersicht"); }));
    add(foto("zl1_" + szene + "_uebersicht"));
    auto m1 = std::make_shared<Messung>();
    add(bildzeit(szene + " Uebersicht", m1, 120));
    add(tu("zeitleiste1: " + szene + " - Detail", [] { g_app->zlDetail = true; }));
    add(pause(0.6));
    add(pruefe("zeitleiste1: " + szene + " - Detail lesbar", [szene] { return lesbar(szene + " Detail"); }));
    add(foto("zl1_" + szene + "_detail"));
    auto m2 = std::make_shared<Messung>();
    add(bildzeit(szene + " Detail", m2, 120));
    add(tu("zeitleiste1: " + szene + " - Probleme", [] {
        g_app->zlDetail = false;
        g_app->zlProbleme = true;
    }));
    add(pause(0.5));
    add(foto("zl1_" + szene + "_probleme"));
    add(tu("zeitleiste1: " + szene + " - ganze Szene", [] {
        g_app->zlProbleme = false;
        g_app->timelineZoom = 1.0;
        g_app->timelineViewStartMs = 0.0;
    }));
    add(pause(0.5));
    add(foto("zl1_" + szene + "_alles"));
    // Ein Satz: anklicken - die Erklaerung zeigt Sprecher und Untertitel.
    add(klickAn("den ersten Satz", [] {
        for (const App::ZlBlock& b : g_app->zlBloecke) {
            if (b.zeile == "sprache" && b.art == spuren::Art::Satz && b.r.Min.x >= g_app->tlFeldX) {
                return ImVec2{b.r.Min.x + std::min(b.r.GetWidth() * 0.3F, ImGui::GetFontSize() * 2.0F), b.r.Min.y + b.r.GetHeight() * 0.3F};
            }
        }
        return ImVec2{-1.0F, -1.0F};
    }));
    add(pause(0.4));
    add(pruefe("zeitleiste1: " + szene + " - Klick auf den Satz erklaert ihn", [] {
        diag::detail("Knopftest: zeitleiste1 - Satz \"" + g_app->zlErklaerungTitel + "\": " + g_app->zlAuswahl.clip.untertitel);
        return g_app->zlAuswahl.da && g_app->zlAuswahl.clip.art == spuren::Art::Satz;
    }));
    add(foto("zl1_" + szene + "_satz"));
    return s;
}

