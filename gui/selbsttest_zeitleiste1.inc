        g_app->prefsOpen = false;
        g_app->uiScale = *vorher;
    }));
    add(pause(0.3));
    return s;
}

// Zeitleiste 5 Punkt 6: das Undo einer auskommentierten Zeile nennt die
// Kommentarzeile ("// print ..."), nicht "( )". Das Skript davor kommt zurueck.
std::vector<Schritt> undoSchritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    struct Vorher {
        Script skript;
        bool sauber = true;
    };
    auto v = std::make_shared<Vorher>();
    add(tu("zeitleiste1 Undo: Skript mit print und wait", [v] {
        v->skript = g_app->doc.script();
        v->sauber = !g_app->doc.dirty();
        Script sc;
        std::vector<Diag> d;
        (void)readScript("//Generated by BehavEd\nprint ( \"zl5\" );\nwait ( 500 );\n", sc, d);
        (void)g_app->doc.replaceAll(sc, "zl5undo");
    }));
    add(pause(0.3));   // ein Bild: die Befehle bekommen ihre Kennungen
    add(tu("zeitleiste1 Undo: print auskommentieren (REM)", [] {
        const auto& ns = g_app->doc.script().nodes;
        for (std::size_t i = 0; i < ns.size(); ++i) {
            if (ns[i].name == "print") { (void)g_app->doc.commentOut(Path{i}); break; }
        }
    }));
    add(pause(0.3));
    add(tasteKombi(ImGuiMod_Ctrl | ImGuiKey_Z, "Strg+Z"));
    add(pause(0.3));
    add(pruefe("zeitleiste1 Undo: die Meldung nennt die Kommentarzeile, nicht \"( )\"", [] {
        diag::detail("Knopftest: Undo-Meldung \"" + g_app->undoMeldung + "\"");
        return g_app->undoMeldung.find("( )") == std::string::npos && g_app->undoMeldung.find("// print") != std::string::npos;
    }));
    add(tu("zeitleiste1 Undo: das Skript davor zurueck", [v] {
        (void)g_app->doc.replaceAll(v->skript, "zl5undo");
        if (v->sauber) { g_app->doc.markSaved(); }
    }));
    add(pause(0.3));
    return s;
}

// --- Zeitleiste 6: Rumpf wie CG_G2ClientSpineAngles (Motion-Bone-Korrektur) ---
//
// Drei Figuren spielen mit den Beinen eine gehaltene Animation, deren Becken
// gekippt oder gedreht ist (BOTH_SIT2HEADTILTLSTART sitzt zurueckgelehnt,
// BOTH_DODGE_HOLD_R, BOTH_SABERKILLER1), und mit dem Oberkoerper BOTH_STAND1.
// Der Knochen "Motion" spielt die Oberkoerperanimation unter dem Becken der
// Beine; cg_motionBoneComp 2 zieht seinen Winkel vom Blick ab und verteilt ihn
// auf lower_lumbar, upper_lumbar und thoracic. Aufstellung und Kamera wie im
// Spielvergleich (<SP>/zl6, Karte zl6raum, Movie Duels).
namespace {

BoneMatrix rumpfUmkehrung(const BoneMatrix& x) {
    const auto& a = x.m;
    BoneMatrix r;
    const float det = a[0][0] * (a[1][1] * a[2][2] - a[1][2] * a[2][1]) - a[0][1] * (a[1][0] * a[2][2] - a[1][2] * a[2][0]) +
                      a[0][2] * (a[1][0] * a[2][1] - a[1][1] * a[2][0]);
    const float k = det != 0.0F ? 1.0F / det : 0.0F;
    r.m[0][0] = (a[1][1] * a[2][2] - a[1][2] * a[2][1]) * k;
    r.m[0][1] = (a[0][2] * a[2][1] - a[0][1] * a[2][2]) * k;
    r.m[0][2] = (a[0][1] * a[1][2] - a[0][2] * a[1][1]) * k;
    r.m[1][0] = (a[1][2] * a[2][0] - a[1][0] * a[2][2]) * k;
    r.m[1][1] = (a[0][0] * a[2][2] - a[0][2] * a[2][0]) * k;
    r.m[1][2] = (a[0][2] * a[1][0] - a[0][0] * a[1][2]) * k;
    r.m[2][0] = (a[1][0] * a[2][1] - a[1][1] * a[2][0]) * k;
    r.m[2][1] = (a[0][1] * a[2][0] - a[0][0] * a[2][1]) * k;
    r.m[2][2] = (a[0][0] * a[1][1] - a[0][1] * a[1][0]) * k;
    for (int i = 0; i < 3; ++i) { r.m[i][3] = -(r.m[i][0] * a[0][3] + r.m[i][1] * a[1][3] + r.m[i][2] * a[2][3]); }
    return r;
}

// Wie weit der Knochen gegen seinen Elternteil zusaetzlich gedreht ist:
// (Xr(p)^-1 Xr(b))^-1 (X(p)^-1 X(b)), Xr ohne Korrektur.
BoneMatrix rumpfZusatz(const std::vector<BoneMatrix>& mit, const std::vector<BoneMatrix>& roh, int p, int b) {
    const BoneMatrix rel = rumpfUmkehrung(mit[static_cast<std::size_t>(p)]) * mit[static_cast<std::size_t>(b)];
    const BoneMatrix relRoh = rumpfUmkehrung(roh[static_cast<std::size_t>(p)]) * roh[static_cast<std::size_t>(b)];
    return rumpfUmkehrung(relRoh) * rel;
}

float rumpfDrehwinkel(const BoneMatrix& c) {
    const float spur = c.m[0][0] + c.m[1][1] + c.m[2][2];
    return std::acos(std::clamp((spur - 1.0F) * 0.5F, -1.0F, 1.0F)) * 180.0F / 3.14159265F;
}

