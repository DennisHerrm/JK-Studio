    add(warteBis("zeitleiste1 JK2: Szene start_level mit Saetzen", [] {
        return mission1::klein(g_app->shownName).find("start_level") != std::string::npos && !g_app->spuren.sprache.clips.empty();
    }, 1500));
    add(pause(0.5));
    add(pruefe("zeitleiste1 JK2: Sprache - Untertitel aus strip/kejim_post.sp", [] {
        int saetze = 0;
        int mit = 0;
        bool shhh = false;
        bool jemand = false;
        for (const spuren::Clip& c : g_app->spuren.sprache.clips) {
            if (c.art != spuren::Art::Satz) { continue; }
            ++saetze;
            mit += c.untertitel.empty() ? 0 : 1;
            shhh = shhh || (c.untertitel == "Shhh" && c.schluessel == "KEJIM_POST_01JAO007");
            jemand = jemand || (c.untertitel == "I think I saw someone." && c.schluessel == "KEJIM_POST_01JAO008");
            diag::detail("Knopftest: zeitleiste1 JK2 - Satz " + c.datei + " [" + c.schluessel + "] \"" + c.untertitel + "\"");
        }
        diag::detail("Knopftest: zeitleiste1 JK2 - " + std::to_string(saetze) + " Saetze, " + std::to_string(mit) + " mit Untertitel, Pakete " +
                     std::to_string(g_app->zlTexteEbenen.size()));
        return shhh && jemand && mit == 2 && saetze >= 2;
    }));
    add(foto("zl2_jk2_kejim_post"));
    add(tu("zeitleiste1 JK2: Regelwerk wie vorher", [=] {
        mission1::ungespeicherteEntitiesVergessen();
        g_app->doc.markSaved();
        g_app->settings.regelwerk = *vorher;
        (void)regelwerkPruefen();
    }));
    return s;
}

// Zeitleiste 2 Punkt 7: Untertitel im Vorschau-Bild. Eine eigene Mini-Szene:
// New mission "zl2unter" (Karte maps/zl2unter.bsp, Geometrie von md_am_sith),
// ein eigenes StringEd-Paket strings/english/zl2unter.str und eigene Klaenge
// (stumme WAV, 3,0 s und 1,5 s) in einem pk3 eines eigenen Spielordners.
const char* const kUnterText1 =
    "This is our own subtitle for the preview: it is long enough to need more than one line on the screen, so the game "
    "breaks it into pages of two lines, each shown as long as its letters take. The letters share the length of the sound "
    "evenly, which is why a long sentence on a short sound flips its pages quickly, while a short one stays for the whole "
    "sound. Movie Duels draws it smaller by default.";
const char* const kUnterText2 = "Second line, now in yellow.";

std::string stummeWav(double sekunden) {
    const auto n = static_cast<std::uint32_t>(sekunden * 22050.0) * 2U;   // 16 Bit mono
    std::string w = "RIFF";
    const auto u32 = [&w](std::uint32_t v) { for (int i = 0; i < 4; ++i) { w += static_cast<char>((v >> (8 * i)) & 0xFFU); } };
    const auto u16 = [&w](std::uint16_t v) { w += static_cast<char>(v & 0xFFU); w += static_cast<char>(v >> 8); };
    u32(36U + n);
    w += "WAVEfmt ";
    u32(16U);
    u16(1);
    u16(1);
    u32(22050U);
    u32(44100U);
    u16(2);
    u16(16);
    w += "data";
    u32(n);
    w.append(n, '\0');
    return w;
}

