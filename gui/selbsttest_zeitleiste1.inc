std::vector<Schritt> zeitleiste1Schritte() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    // BHED_ZL1_NUR=mini: nur die Mini-Szene, =jk2: nur Jedi Outcast (schneller Durchlauf beim Arbeiten).
    const char* nur = std::getenv("BHED_ZL1_NUR");
    if (nur != nullptr && std::strcmp(nur, "jk2") == 0) { return zl1::jk2Schritte(); }
    if (nur != nullptr && std::strcmp(nur, "untertitel") == 0) { return zl1::untertitelSchritte(); }
    if (nur != nullptr && std::strcmp(nur, "aufnahme") == 0) {
        s = zl1::untertitelSchritte();
        for (Schritt& x : zl1::aufnahmeSchritte()) { s.push_back(std::move(x)); }
        return s;
    }
    for (Schritt& x : zl1::miniSchritte()) { s.push_back(std::move(x)); }
    for (Schritt& x : zl1::fremdSchritte()) { s.push_back(std::move(x)); }
    if (nur != nullptr && std::strcmp(nur, "mini") == 0) { return s; }
    auto st = std::make_shared<zl1::Stand>();
    add(tu("zeitleiste1: Ausgangslage (reines JKA, eingerichtete Spielordner)", [=] {
        const char* e = std::getenv("BHED_JKA_BASIS");
        st->jka = e != nullptr ? e : "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Jedi Academy\\GameData original\\base";
        for (const std::string& o : g_app->settings.gamePaths) {
            std::error_code ec;
            if (st->md.empty() && std::filesystem::is_regular_file(::bhed::utf8Pfad(o + "\\assets1.pk3"), ec)) { st->md = o + "\\assets1.pk3"; }
        }
        mission1::ungespeicherteEntitiesVergessen();
        g_app->doc.markSaved();
        g_app->leftMode = 1;
        g_app->missionPickOpen = false;
    }));
    add(tu("zeitleiste1: Load mission (JKA)", [=] { missionenAusArchiv(st->jka + "\\assets1.pk3"); }));
    add(warteBis("zeitleiste1: academy1 in der Auswahl", [] { return missionsliste::hat("academy1", true); }, 3500));
    add(waehleInListe("academy1", false, 0, "##missionpick"));
    add(warteBis("zeitleiste1: academy1 geladen", [] {
        return g_app->map.path == "maps/academy1.bsp" && g_app->camTrackValid && g_app->missionAktiv;
    }, 3000));
    add(tu("zeitleiste1: Reiter academy1/intro", [] { g_app->tabRequest = mission1::reiterMit("intro"); }));
    add(pause(1.0));
    add(warteBis("zeitleiste1: Szene von intro mit Figuren", [] {
        return g_app->camTrackValid && mission1::klein(g_app->shownName).find("intro") != std::string::npos && jk2probe::figurenGeladen();
    }, 1500));
    add(pause(0.5));
    // Zahlen aus dem Export zeitleiste0 (NOTIZEN_zeitleiste0.md): 15 Saetze, alle mit Laenge und Untertitel.
    for (Schritt& x : zl1::szeneSchritte("academy1_intro", 15, 15)) { s.push_back(std::move(x)); }
    for (Schritt& x : zl1::untertitelFoto("academy1_intro")) { s.push_back(std::move(x)); }
    for (Schritt& x : zl1::aufnahmeOriginal("academy1")) { s.push_back(std::move(x)); }
    add(tu("zeitleiste1: Load mission (Movie Duels)", [=] {
        mission1::ungespeicherteEntitiesVergessen();
        missionenAusArchiv(st->md);
    }));
    add(warteBis("zeitleiste1: md_am_sith in der Auswahl", [] { return missionsliste::hat("md_am_sith", true); }, 3500));
    add(waehleInListe("md_am_sith", false, 0, "##missionpick"));
    add(warteBis("zeitleiste1: md_am_sith geladen", [] {
        return g_app->map.path == "maps/md_am_sith.bsp" && g_app->camTrackValid && g_app->tabs.size() > 1;
    }, 3000));
    add(pause(1.0));
    add(warteBis("zeitleiste1: Szene von md_am_sith mit Figuren", [] { return g_app->camTrackValid && jk2probe::figurenGeladen(); }, 1500));
    add(pause(0.5));
    // Export zeitleiste0: 9 Klaenge, alle mit Laenge, 5 mit Untertitel (die 4 Schiffsklaenge haben keinen).
    for (Schritt& x : zl1::szeneSchritte("md_am_sith", 9, 5)) { s.push_back(std::move(x)); }
    for (Schritt& x : zl1::aufnahmeOriginal("md_am_sith")) { s.push_back(std::move(x)); }
    for (Schritt& x : zl1::untertitelSchritte()) { s.push_back(std::move(x)); }
    for (Schritt& x : zl1::aufnahmeSchritte()) { s.push_back(std::move(x)); }
    // Jedi Outcast zuletzt: danach gelten dessen Regeln und Spielordner.
    for (Schritt& x : zl1::jk2Schritte()) { s.push_back(std::move(x)); }
    return s;
}
