// --- 2. k-gangart: eine Figur rennt statt zu gehen -----------------------------------
std::vector<Schritt> gangart() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    add(tu("H2 Gangart: Kyle und sein Laufziel setzen, Skript mit einem Lauf", [] {
        const float k[3] = {-1500.0F, -1900.0F, 650.0F};
        const float n[3] = {-1560.0F, -1640.0F, 640.0F};
        const int a = neueEntityAn("NPC_spawner", k);
        if (a >= 0) {
            (void)entityKeySetzen(a, "NPC_targetname", "kyle");
            (void)entityKeySetzen(a, "NPC_type", "Kyle");
            (void)entityAufBoden(a);
        }
        const int b = neueEntityAn("waypoint_navgoal", n);
        if (b >= 0) {
            (void)entityKeySetzen(b, "targetname", "nav_kyle");
            (void)entityAufBoden(b);
        }
        Script sc;
        std::vector<Diag> d;
        (void)readScript(kKopf, sc, d);
        (void)g_app->doc.ersetzeSkript(std::move(sc), "H2");
        rebuildTree();
        g_app->camTrackValid = false;
        g_app->leftMode = 1;
        g_app->playMs = 0.0;
        g_app->playing = false;
        g_app->cameraSelected = false;
        g_app->selectedActor = -1;
        entityAuswahlSetzen(-1);
        blick(-1620.0F, -2120.0F, 830.0F, 26.0F, 90.0F);
    }));
    add(warteBis("H2 Gangart: Kyle steht in der Szene", [] {
        for (const Actor& a : g_app->scene.actors) {
            if (a.name == "kyle") { return true; }
        }
        return false;
    }, 1200));
    add(tu("H2 Gangart: Tour k-gangart starten", [] { (void)tourStarten("k-gangart", 0); }));
    add(pause(0.4));
    add(pruefe("H2 Gangart: Tour laeuft (4 Schritte), die 3D-Ansicht ist hervorgehoben", [] {
        const TourSicht t = tourSicht();
        return t.aktiv && t.id == "k-gangart" && t.anzahl == 4 && !t.ziele.empty() && !t.zeigtOeffner;
    }));
    add(wartetNoch("k-gangart", 0));
    add(tu("H2 Gangart: Kyle waehlen (wie ein Klick auf seinen Namen in der Zeitleiste)", [] {
        for (std::size_t i = 0; i < g_app->scene.actors.size(); ++i) {
            if (g_app->scene.actors[i].name == "kyle") { g_app->selectedActor = static_cast<int>(i); }
        }
        g_app->cameraSelected = false;
        g_app->mapDirty = true;
    }));
    add(erledigt("k-gangart", 1));
    add(warteBis("H2 Gangart: das Laufziel (selbst gezeichnet) ist hervorgehoben", [] {
        const TourSicht t = tourSicht();
        return !t.ziele.empty() && !t.zeigtOeffner && t.overlay && tourGemeldet("vorschau.laufziel");
    }, 600));
    add(pruefe("H2 Gangart: das hervorgehobene Ziel ist das gemeldete Laufziel", [] {
        const TourSicht t = tourSicht();
        return !t.ziele.empty() && t.ziele[0].GetWidth() < ImGui::GetFontSize() * 2.0F;
    }));
    add(wartetNoch("k-gangart", 1));
    add(klickAn("H2 Gangart: Rechtsklick auf das Laufziel", zielMitte, 1));
    add(erledigt("k-gangart", 2));
    add(pruefe("H2 Gangart: das Menue des Laufziels ist hervorgehoben", [] { return !tourSicht().ziele.empty() && tourGemeldet("vorschau.gangartmenue"); }));
    add(klick(tr(Str::BahnRennen)));
    add(erledigt("k-gangart", 3));
    add(pruefe("H2 Gangart: SET_RUNNING steht im Skript", [] {
        return writeScript(g_app->doc.script()).find("SET_RUNNING") != std::string::npos;
    }));
    add(klick(tr(Str::TlPlay), "###main"));
    add(erledigt("k-gangart", 4));
    add(pruefe("H2 Gangart: Tour ganz durch, die Zeitleiste spielt", [] { return tourSicht().fertig && g_app->playing; }));
    add(tu("H2 Gangart: anhalten, Tour zu", [] {
        g_app->playing = false;
        g_app->playMs = 0.0;
        tourSchliessen();
    }));
    return s;
}

// --- 3. k-kamera-ansicht: die Kamerazeile als Ziel ---------------------------------
