    add(tu("H2 Kamerazeile: Kamera nicht gewaehlt, Tour k-kamera-ansicht ab Schritt 2", [] {
        // Im Testfenster ist die Zeitleiste so niedrig, dass ihre Zeilen unter der
        // Transportleiste verschwinden - groesser ziehen (wie am Griff ueber ihr).
        g_app->timelineFrac = 0.4F;
        g_app->cameraSelected = false;
        g_app->selectedActor = -1;
        entityAuswahlSetzen(-1);
        (void)tourStarten("k-kamera-ansicht", 1);
    }));
    add(warteBis("H2 Kamerazeile: die Tour zeigt auf die Kamerazeile der Zeitleiste (Vorbedingung, selbst gezeichnet)", [] {
        const TourSicht t = tourSicht();
        return t.aktiv && t.zeigtOeffner && !t.ziele.empty() && tourGemeldet("zeitleiste.kamera");
    }, 600));
    add(wartetNoch("k-kamera-ansicht", 1));
    add(klickAn("H2 Kamerazeile: Klick auf die hervorgehobene Kamerazeile", [] {
        const TourSicht t = tourSicht();
        if (t.ziele.empty()) { return ImVec2{-1.0F, -1.0F}; }
        return ImVec2{t.ziele[0].Min.x + t.ziele[0].GetWidth() * 0.7F, t.ziele[0].GetCenter().y};
    }));
    add(warteBis("H2 Kamerazeile: Kamera gewaehlt, jetzt ist \"Neue Einstellung\" hervorgehoben", [] {
        const TourSicht t = tourSicht();
        return g_app->cameraSelected && !t.zeigtOeffner && !t.ziele.empty();
