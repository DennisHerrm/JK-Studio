std::vector<Schritt> schritte() {
    std::vector<Schritt> s;
    // BHED_H2_NUR=<teil>,<teil>: nur diese Teile (die Mission kommt fuer die
    // Vorschau-Teile immer mit). Ohne: alle.
    const char* nur = std::getenv("BHED_H2_NUR");
