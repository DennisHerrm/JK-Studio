// --- 12. KI: Befehle des Menue-Editors ueber MCP - Rueckfrage, ein Rueckgaengig-Schritt ------
std::vector<Schritt> kiMenue() {
    std::vector<Schritt> s;
    auto add = [&](Schritt x) { s.push_back(std::move(x)); };
    static std::shared_ptr<hilfe1::McpRuf> ruf;
    static std::string textVorher;
    const std::string auftrag =
        R"({"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"run_commands","arguments":{"summary":"move the first element","commands":["menu:select:0","menu:move:16:0","menu:move:0:8"]}}})";
    add(tu("H2 KI: Menue-Editor mit einem Menue, lokale MCP-Verbindung an", [] {
        g_app->leftMode = 4;
        if (menueeditor::stand().dokumente == 0) { (void)menueeditor::oeffneAusSpiel("ui/jamp/main.menu"); }
        menueeditor::setzeInteraktion(false);
        g_app->settings.mcpHttp = true;
    }));
    add(warteBis("H2 KI: Server laeuft, ein Menue ist offen", [] { return kiSicht().httpLaeuft && menueeditor::stand().items > 0; }, 600));
    add(tu("H2 KI: Auftrag (Element waehlen, zweimal verschieben)", [auftrag] {
        textVorher = menueeditor::stand().text;
        ruf = hilfe1::mcpRuf(kiTestToken(), auftrag);
    }));
    add(warteBis("H2 KI: Rueckfrage \"Die KI moechte\" mit den Befehlen in Worten", [] {
        return finde(tr(Str::KiReject), "###kifrage", 0, false) != nullptr;
    }, 600));
    add(klick(tr(Str::KiReject), "###kifrage"));
    add(warteBis("H2 KI: abgelehnt - das Menue ist unveraendert", [] {
        return ruf->fertig && ruf->antwort.find("Rejected by the user") != std::string::npos && menueeditor::stand().text == textVorher;
    }, 600));
    add(tu("H2 KI: noch einmal, diesmal ausfuehren", [auftrag] { ruf = hilfe1::mcpRuf(kiTestToken(), auftrag); }));
    add(warteBis("H2 KI: Rueckfrage steht wieder", [] { return finde(tr(Str::KiRun), "###kifrage", 0, false) != nullptr; }, 600));
    add(klick(tr(Str::KiRun), "###kifrage"));
    add(warteBis("H2 KI: ausgefuehrt - das Menue hat sich geaendert", [] {
        diag::detail("Knopftest: H2 KI - Antwort " + (ruf->fertig ? ruf->antwort.substr(ruf->antwort.find("\r\n\r\n") + 4, 160) : std::string("-")));
        return ruf->fertig && ruf->antwort.find("commands done") != std::string::npos && menueeditor::stand().text != textVorher;
    }, 600));
    add(tu("H2 KI: EIN Rueckgaengig", [] { (void)menueeditor::rueckgaengig(); }));
    add(pruefe("H2 KI: ein Rueckgaengig nimmt den ganzen Auftrag zurueck (ein Auftrag = ein Schritt)", [] {
        return menueeditor::stand().text == textVorher;
    }));
    add(tu("H2 KI: Verbindung trennen, zurueck zu Events", [] {
        g_app->settings.mcpHttp = false;
        g_app->leftMode = 0;
    }));
    add(pause(0.3));
    return s;
}

