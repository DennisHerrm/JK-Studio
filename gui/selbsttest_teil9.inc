    // --- .md3 mit dem Licht der Entity ---------------------------------------
    add(tu("Teil 9: duel_deathstar", [] { (void)loadMapFromArchive("maps/duel_deathstar.bsp"); }));
    add(warteBis("Teil 9: duel_deathstar bereit", [] { return g_app->map.path == "maps/duel_deathstar.bsp" && g_app->mapBereit; }, 4000));
    add(pruefe("Teil 9: alle misc_model_static: Licht an origin + zoffset + 1, Bilder ohne Skript mit kModellLicht", [] {
        int modelle = 0;
        int richtig = 0;
        int stapelMitLicht = 0;
        for (const App::MapModel& mm : g_app->mapModels) {
            if (mm.entity >= g_app->map.entities.size() || g_app->map.entities[mm.entity].classname != "misc_model_static") { continue; }
            ++modelle;
            const std::string* z = g_app->map.entities[mm.entity].find("zoffset");
            const float soll = 1.0F + (z != nullptr ? static_cast<float>(std::atof(z->c_str())) : 0.0F);
            const auto netz = g_app->md3Meshes.find(mm.path + "#0");
            if (mm.lichtHoehe == soll && netz != g_app->md3Meshes.end() && !netz->second.batches.empty() &&
                netz->second.batches.front().lightmap == -1) {
                ++richtig;
                for (const gpu::DrawCall& c : gpu::buildDrawCalls(netz->second, &g_app->textures, 0.0F)) {
                    if ((c.state.features & gpu::kModellLicht) != 0U && (c.state.features & gpu::kRohEcke) != 0U) { ++stapelMitLicht; }
                }
            }
        }
        diag::detail("Knopftest: Teil 9 - misc_model_static " + std::to_string(modelle) + ", richtig " + std::to_string(richtig) +
                     ", Stapel mit Licht " + std::to_string(stapelMitLicht));
        return modelle > 0 && richtig == modelle && stapelMitLicht > 0;
    }));
    add(tu("Teil 9: duel_jeditemple", [] { (void)loadMapFromArchive("maps/duel_jeditemple.bsp"); }));
    add(warteBis("Teil 9: duel_jeditemple bereit", [] { return g_app->map.path == "maps/duel_jeditemple.bsp" && g_app->mapBereit; }, 4000));
    add(pruefe("Teil 9: $lightmap nach zwei Bildstufen: unbeleuchtete Grundstufe, zuletzt die Lightmap als Filter", [] {
        int geprueft = 0;
        int richtig = 0;
        for (const TextureSet::Tex& t : g_app->textures.byShader) {
            if (t.extraStages.size() != 2U) { continue; }
            const TextureSet::Tex& letzte = g_app->textures.byShader[static_cast<std::size_t>(t.extraStages[1])];
            if (!letzte.lightmapFilter) { continue; }
            ++geprueft;
            if (!t.lightmapStufe && letzte.lightmapStufe && letzte.srcFactor == BlendFactor::DstColor &&
                letzte.dstFactor == BlendFactor::Zero) {
                ++richtig;
            }
        }
        diag::detail("Knopftest: Teil 9 - Filterstufen " + std::to_string(geprueft) + ", richtig " + std::to_string(richtig));
        return geprueft > 0 && richtig == geprueft;
    }));
    // Der Boden vor der Statue (textures/jeditemple/u_metalorange02) gegen das Spiel: Paar g9_jtb aus rc608 Teil 9b, Kamera
    // der dritten Person -1250 -20 -1113.75, Blick 90; im Spielbild 1920 x 1440 Feld 1250,1000-1920,1440 im Mittel 32,1 25,8 13,9.
    add(tu("Teil 9: duel_jeditemple, Boden vor der Statue", [] {
        g_app->cam.pos[0] = -1250.0F;
        g_app->cam.pos[1] = -20.0F;
        g_app->cam.pos[2] = -1113.75F;
        g_app->cam.angles[0] = 0.0F;
        g_app->cam.angles[1] = 90.0F;
        g_app->cam.angles[2] = 0.0F;
        g_app->cam.fovY = 64.3727F;
        g_app->followCam = false;
        g_app->throughCamera = false;
        g_app->playing = false;
        g_app->mapDirty = true;
    }));
    add(pause(0.6));
    add(foto("t9_jt_boden"));
    add(pruefe("Teil 9: duel_jeditemple: Boden u_metalorange02 wie im Spiel (Mittel 32,1 25,8 13,9, je Kanal auf 20 %)", [] {
        for (std::size_t i = 0; i < g_app->geo.shaders.size() && i < g_app->textures.byShader.size(); ++i) {
            if (g_app->geo.shaders[i].name != "textures/jeditemple/u_metalorange02") { continue; }
            const auto stufe = [](const TextureSet::Tex& t) {
                double s[3] = {0.0, 0.0, 0.0};
                const std::size_t n = t.rgba.size() / 4U;
                for (std::size_t k = 0; k < n; ++k) {
                    for (int c = 0; c < 3; ++c) { s[c] += t.rgba[k * 4U + static_cast<std::size_t>(c)]; }
                }
                char z[200];
                std::snprintf(z, sizeof(z), "%dx%d Mittel %.0f %.0f %.0f, src %d dst %d, texGen %d, Licht %d, Filter %d, Ecke %d", t.width, t.height,
                              n > 0 ? s[0] / static_cast<double>(n) : 0.0, n > 0 ? s[1] / static_cast<double>(n) : 0.0,
                              n > 0 ? s[2] / static_cast<double>(n) : 0.0, static_cast<int>(t.srcFactor), static_cast<int>(t.dstFactor),
                              static_cast<int>(t.texGen), t.lightmapStufe ? 1 : 0, t.lightmapFilter ? 1 : 0, t.rgbVertex ? 1 : 0);
                return std::string(z);
            };
            const TextureSet::Tex& t = g_app->textures.byShader[i];
            std::string z = "Knopftest: Teil 9 - u_metalorange02 Grund " + stufe(t);
            for (const int e : t.extraStages) {
                if (e >= 0 && static_cast<std::size_t>(e) < g_app->textures.byShader.size()) {
                    z += " | Stufe " + stufe(g_app->textures.byShader[static_cast<std::size_t>(e)]);
                }
            }
            diag::detail(z);
        }
        std::vector<std::uint8_t> px;
        int w = 0;
        int h = 0;
        if (!gpu::leseFarbe(px, w, h) || w <= 0 || h <= 0) { return false; }
        // Das Feld in Einheiten der halben Bildhoehe um die Mitte, wie im Spielbild (gleiches fovY).
        const int x0 = w / 2 + static_cast<int>(0.403F * static_cast<float>(h) * 0.5F);
        const int x1 = std::min(w, w / 2 + static_cast<int>(1.333F * static_cast<float>(h) * 0.5F));
        const int y0 = h / 2 + static_cast<int>(0.389F * static_cast<float>(h) * 0.5F);
        double s[3] = {0.0, 0.0, 0.0};
        long long n = 0;
        for (int y = y0; y < h; ++y) {
            for (int x = x0; x < x1; ++x) {
                const std::size_t p = (static_cast<std::size_t>(y) * static_cast<std::size_t>(w) + static_cast<std::size_t>(x)) * 4U;
                for (int c = 0; c < 3; ++c) { s[c] += px[p + static_cast<std::size_t>(c)]; }
                ++n;
            }
        }
        if (n == 0) { return false; }
        const double soll[3] = {32.1, 25.8, 13.9};
        bool gut = true;
        char z[160];
        std::snprintf(z, sizeof(z), "Knopftest: Teil 9 - Boden vor der Statue %.1f %.1f %.1f (Spiel 32,1 25,8 13,9), Feld %d,%d-%d,%d", s[0] / static_cast<double>(n),
                      s[1] / static_cast<double>(n), s[2] / static_cast<double>(n), x0, y0, x1, h);
        diag::detail(z);
        for (int c = 0; c < 3; ++c) { gut = gut && std::fabs(s[c] / static_cast<double>(n) - soll[c]) <= 0.2 * soll[c]; }
        return gut;
    }));
    return s;
}
