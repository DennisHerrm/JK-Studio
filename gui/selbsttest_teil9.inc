            int d = 0;
            for (int k = 0; k < 3; ++k) { d += std::abs(static_cast<int>(ms->ohne[i + static_cast<std::size_t>(k)]) - static_cast<int>(ms->mit[i + static_cast<std::size_t>(k)])); }
