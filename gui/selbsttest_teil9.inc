        const std::size_t i = teil9::spieler();
        const Actor& a = g_app->scene.actors[i];
        const App::ActorAssets& as = *g_app->actorAssets[i];
        const auto bilder = [&](bool an) {
            g_app->settings.cgTurnAnims = an;
            int zahl = 0;
            for (double t = 1900.0; t < 2400.0; t += 25.0) {
                ActorDraw d;
                std::vector<BoneMatrix> welt;
                float fw[16];
                if (figurPose(a, as, a.at(t), t, d, welt, fw) && d.hipsFrame >= 0) { ++zahl; }
            }
            g_app->settings.cgTurnAnims = false;
            return zahl;
        };
        const int aus = bilder(false);
        const int an = bilder(true);
        diag::detail("Knopftest: Teil 9 - turnAnims aus " + std::to_string(aus) + ", an " + std::to_string(an));
        return aus == 0 && an > 0;
    }));
    add(pruefe("Teil 9: CG_UpdateLookAngles: Der Kopf zieht dem Blickziel nach und bleibt stehen", [] {
        const std::size_t i = teil9::spieler();
        const Actor& a = g_app->scene.actors[i];
        const App::ActorAssets& as = *g_app->actorAssets[i];
        g_app->blickFolgen.clear();
        const auto bei = [&](double t) {
            blickFolgeRechnen(a, i, as, t);
            return std::fabs(g_app->blickFolgen[i].winkel[1]) + std::fabs(g_app->blickFolgen[i].winkel[0]);
        };
        const double ab = 3060.0;
        const ActorState pruef = a.at(ab + 500.0);
        diag::detail("Knopftest: Teil 9 - Blickziel " + std::to_string(pruef.hasLookTarget) + " " + std::to_string(pruef.lookAt[0]) + " " +
                     std::to_string(pruef.lookAt[1]) + " " + std::to_string(pruef.lookAt[2]));
        const float vorher = bei(ab - 100.0);
        const float frueh = bei(ab + 60.0);
        const float spaet = bei(ab + 1500.0);
        const float spaeter = bei(ab + 2500.0);
        diag::detail("Knopftest: Teil 9 - Blick vorher " + std::to_string(vorher) + ", frueh " + std::to_string(frueh) + ", spaet " +
                     std::to_string(spaet) + ", spaeter " + std::to_string(spaeter));
        return vorher < 0.01F && frueh > 0.0F && frueh < spaet && std::fabs(spaet - spaeter) < 1.0F;
    }));
    add(pruefe("Teil 9: g_ActivateAnimationStyle: Der Satz einer Figur wird zum Meistersatz, wenn das Skelett passt", [] {
        GlmModel meister;
        meister.animFile = kAnimStilMeisterGla;
        const App::Skeleton* m = skeletonFor(meister);
        if (m == nullptr) { return false; }
        GlmModel figur;
        figur.animFile = "models/players/_humanoid_md/_humanoid";
        figur.numBones = static_cast<int>(m->anim.bones.size());
        animStilSetzen(false);
        const App::Skeleton* aus = skeletonFor(figur);
        animStilSetzen(true);
        const App::Skeleton* an = skeletonFor(figur);
        GlmModel fremd = figur;
        fremd.numBones = 30;
        const App::Skeleton* passtNicht = skeletonFor(fremd);
        animStilSetzen(false);
        return an == m && aus != m && passtNicht == aus;
    }));
