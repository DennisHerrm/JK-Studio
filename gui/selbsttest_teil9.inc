// selbsttest_teil9.inc - rc608 Teil 9 (Modus "teil9").
//
// 1. Spieler in Cutscenes: In einer Szene mit Kameraspur zeichnet die Vorschau die Spielerfigur nicht, ausser in
//    Abschnitten ausserhalb der Kamera, in denen das Skript sie anspricht; "Show player" zeigt sie wie im Spiel.
//    Nur das Bild aendert sich: Actor::at, Export und Undo nicht.
// 2. .md3 mit dem Licht der Entity und Lightmap nach mehreren Bildstufen (Karten duel_deathstar, duel_jeditemple).
namespace teil9 {
const std::string kKopf = "//Generated by BehavEd\r\n\r\n";
// Vor der Kamera 2 s, Kamera 2 s, danach 2 s, je ein Block fuer `figur` oder nichts. Die Figur "player" gibt es
// in der Szene nur, wenn das Skript sie nennt.
inline std::string skript(const std::string& figur, const std::string& davor, const std::string& mitte, const std::string& danach) {
    const auto block = [&figur](const std::string& innen) {
        return innen.empty() ? std::string()
                             : "affect ( \"" + figur + "\", /*@AFFECT_TYPE*/ FLUSH )\r\n{\r\n" + innen + "}\r\n\r\n";
    };
    return kKopf + block(davor) + "wait ( 2000.000 );\r\ncamera ( /*@CAMERA_COMMANDS*/ ENABLE );\r\n" +
           "camera ( /*@CAMERA_COMMANDS*/ MOVE, < -1024.000 7000.000 200.000 >, 0.000 );\r\n" +
           block(mitte) + "wait ( 2000.000 );\r\ncamera ( /*@CAMERA_COMMANDS*/ DISABLE );\r\n\r\n" +
           block(danach) + "wait ( 2000.000 );\r\n";
}
const std::string kAnim = "\tset ( /*@SET_TYPES*/ \"SET_ANIM_BOTH\", \"BOTH_STAND2\" );\r\n";

inline void laden(const std::string& text, const char* was) {
    Script neu;
    std::vector<Diag> d;
    if (readScript(text, neu, d)) {
        g_app->doc.ersetzeSkript(std::move(neu), was);
        rebuildTree();
    } else {
        diag::detail("Knopftest: Teil 9 - Skript nicht lesbar, Meldungen " + std::to_string(d.size()));
    }
    g_app->followCam = false;
    g_app->throughCamera = false;
    g_app->playing = false;
    g_app->camTrackValid = false;
    g_app->mapDirty = true;
}

inline std::size_t spieler() {
    for (std::size_t i = 0; i < g_app->scene.actors.size(); ++i) {
        std::string n = g_app->scene.actors[i].name;
        for (char& c : n) { c = static_cast<char>(std::tolower(static_cast<unsigned char>(c))); }
        if (n == "player" || (regelwerkJediOutcast() && n == "kyle" && !g_app->scene.actors[i].kartenFigur)) { return i; }
    }
    return g_app->scene.actors.size();
}

// Die Kamera schaut von vorn auf den Spieler. Wird er gezeichnet, steht sein Ort in figurGezeichnet.
inline void stelle(double ms) {
    g_app->playMs = ms;
    g_app->playing = false;
    const std::size_t i = spieler();
    if (i < g_app->scene.actors.size()) {
        const ActorState st = g_app->scene.actors[i].at(ms);
        g_app->cam.pos[0] = st.pos[0] + 110.0F;
        g_app->cam.pos[1] = st.pos[1];
        g_app->cam.pos[2] = st.pos[2] + 30.0F;
        g_app->cam.angles[0] = 8.0F;
        g_app->cam.angles[1] = 180.0F;
        g_app->cam.angles[2] = 0.0F;
    }
    for (auto& f : g_app->figurGezeichnet) { f = {-99999.0F, 0.0F, 0.0F}; }
    g_app->mapDirty = true;
}

inline bool gezeichnet() {
    const std::size_t i = spieler();
    return i < g_app->figurGezeichnet.size() && g_app->figurGezeichnet[i][0] > -90000.0F;
}
